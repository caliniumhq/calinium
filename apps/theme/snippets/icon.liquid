{% if icon_paths != blank %}
  <svg
    class="{{ icon_class | escape }}"
    width="{{ icon_size | escape }}"
    height="{{ icon_size | escape }}"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    {% if icon_is_decorative %}
      aria-hidden="true"
      focusable="false"
    {% else %}
      role="img"
      {% if icon_label != blank %}aria-label="{{ icon_label | escape }}"{% endif %}
    {% endif %}
  >
    {{ icon_paths }}
  </svg>
{% endif %}
