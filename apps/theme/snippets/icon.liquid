{% liquid
  assign icon_name = icon | default: name | default: blank
  assign icon_size = size | default: 24
  assign icon_label = label | default: aria_label | default: blank
  assign icon_class = 'co-icon'
  assign icon_is_decorative = true

  if icon_label != blank and decorative != true
    assign icon_is_decorative = false
  endif

  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
%}

