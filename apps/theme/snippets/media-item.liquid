{% liquid
  assign media_image = image | default: blank
  assign media_mobile_image = mobile_image | default: blank
  assign media_caption = caption | default: blank
  assign media_url = url | default: link | default: blank
  assign media_link_label = link_label | default: blank
  assign media_loading = loading | default: 'lazy'
  assign media_ratio = image_ratio | default: 'natural'
  assign media_fit = image_fit | default: 'cover'
  assign media_class = 'co-primitive-media-item'

  if class != blank
    assign media_class = media_class | append: ' ' | append: class
  endif
%}

{% if media_image != blank or media_caption != blank %}
  <figure class="{{ media_class | escape }}">
    {% if media_image != blank %}
      {% render 'responsive-image', image: media_image, mobile_image: media_mobile_image, alt: image_alt, loading: media_loading, fetchpriority: fetchpriority, sizes: image_sizes, widths: image_widths, ratio: media_ratio, fit: media_fit, link: media_url, link_label: media_link_label, class: 'co-primitive-media-item__image' %}
    {% endif %}
    {% if media_caption != blank %}<figcaption class="co-primitive-media-item__caption">{{ media_caption }}</figcaption>{% endif %}
  </figure>
{% endif %}
