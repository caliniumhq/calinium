{% liquid
  assign desktop_menu = section.settings.menu
  assign mobile_menu = section.settings.mobile_menu | default: desktop_menu
  assign header_logo = section.settings.logo | default: settings.logo
  assign transparent_logo = section.settings.transparent_logo | default: header_logo
  assign header_classes = 'co-header co-header--layout-' | append: section.settings.layout
  assign header_classes = header_classes | append: ' co-header--width-' | append: section.settings.width
  assign header_classes = header_classes | append: ' co-color-scheme-' | append: section.settings.color_scheme
  assign mobile_navigation_id = 'MobileNavigation-' | append: section.id
  assign mobile_navigation_title_id = 'MobileNavigationTitle-' | append: section.id
  assign search_results_id = 'HeaderPredictiveSearchResults-' | append: section.id
  assign localization_form_id = 'HeaderLocalizationForm-' | append: section.id
  assign mobile_localization_form_id = 'MobileHeaderLocalizationForm-' | append: section.id
  assign search_label = 'header.search' | t
  assign cart_label = 'header.cart_count' | t: count: cart.item_count
  assign account_label = 'header.account' | t
  assign menu_label = 'accessibility.open_main_navigation' | t
  assign close_menu_label = 'accessibility.close_main_navigation' | t
  assign localization_submit_label = 'localization.update' | t
  assign has_desktop_menu = false
  assign has_mobile_menu = false
  assign show_localization = false
  assign has_multiple_countries = false
  assign has_multiple_languages = false
  assign is_transparent_homepage = false
  assign has_distinct_transparent_logo = false
  assign has_mobile_utility = false
  assign account_url = routes.account_login_url

  if desktop_menu != blank
    assign has_desktop_menu = true
  endif

  if mobile_menu != blank
    assign has_mobile_menu = true
  endif

  if customer
    assign account_url = routes.account_url
  endif

  if section.settings.show_account and shop.customer_accounts_enabled
    assign has_mobile_utility = true
  endif

  if localization.available_countries.size > 1
    assign has_multiple_countries = true
  endif

  if localization.available_languages.size > 1
    assign has_multiple_languages = true
  endif

  if section.settings.show_localization
    if has_multiple_countries or has_multiple_languages
      assign show_localization = true
      assign has_mobile_utility = true
    endif
  endif

  if section.settings.sticky_header
    assign header_classes = header_classes | append: ' co-header--sticky'
  endif

  if section.settings.show_border
    assign header_classes = header_classes | append: ' co-header--with-border'
  endif

  if section.settings.transparent_homepage and request.page_type == 'index'
    assign is_transparent_homepage = true
    assign header_classes = header_classes | append: ' co-header--transparent co-header--transparent-' | append: section.settings.transparent_text_treatment

    if section.settings.transparent_logo != blank and transparent_logo.id != header_logo.id
      assign has_distinct_transparent_logo = true
      assign header_classes = header_classes | append: ' co-header--has-transparent-logo'
    endif
  endif
%}

{{ 'component-button.css' | asset_url | stylesheet_tag }}
{% if header_logo != blank or transparent_logo != blank %}
  {{ 'component-image.css' | asset_url | stylesheet_tag }}
{% endif %}
{{ 'section-header.css' | asset_url | stylesheet_tag }}
{% if section.settings.show_search and section.settings.enable_predictive_search %}
  {{ 'predictive-search.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'predictive-search.js' | asset_url }}" type="module"></script>
{% endif %}
<script src="{{ 'header.js' | asset_url }}" type="module"></script>

<header
  class="{{ header_classes }}"
  data-header
  data-sticky-header="{{ section.settings.sticky_header }}"
  data-desktop-navigation-activation="{{ section.settings.desktop_navigation_activation }}"
  data-hide-on-scroll="{{ section.settings.hide_on_scroll }}"
  data-transparent="{{ is_transparent_homepage }}"
  style="--co-header-desktop-height: {{ section.settings.desktop_height }}px; --co-header-mobile-height: {{ section.settings.mobile_height }}px; --co-header-inline-padding: {{ section.settings.horizontal_padding }}px; --co-header-logo-width: {{ section.settings.desktop_logo_width }}px; --co-header-logo-width-mobile: {{ section.settings.mobile_logo_width }}px;"
>
  <div class="co-header__inner{% if section.settings.width == 'contained' %} co-page-width{% endif %}">
    <div class="co-header__left">
      {% if has_mobile_menu %}
        {% render 'button',
          aria_label: menu_label,
          aria_controls: mobile_navigation_id,
          aria_expanded: false,
          icon: 'menu',
          variant: 'text',
          class: 'co-header__menu-toggle',
          data_action: 'mobile-nav-toggle'
        %}
      {% endif %}

      {% if has_desktop_menu %}
        <nav class="co-header__desktop-navigation" aria-label="{{ 'navigation.main' | t }}">
          <ul class="co-header__desktop-list" role="list">
            {% for link in desktop_menu.links %}
              <li class="co-header__desktop-item">
                {% if link.links != blank %}
                  <details class="co-header__desktop-disclosure" data-header-desktop-disclosure>
                    <a
                      class="co-header__desktop-link{% if link.active or link.child_active %} is-active{% endif %}"
                      href="{{ link.url | escape }}"
                      {% if link.current %}aria-current="page"{% endif %}
                    >
                      {{ link.title | escape }}
                    </a>
                    <summary aria-label="{{ 'accessibility.submenu' | t: title: link.title | escape }}">
                      {% render 'icon', name: 'chevron-down', size: 16 %}
                    </summary>
                    <ul class="co-header__desktop-submenu" role="list">
                      {% for child_link in link.links %}
                        <li>
                          <a
                            class="co-header__desktop-submenu-link{% if child_link.active or child_link.child_active %} is-active{% endif %}"
                            href="{{ child_link.url | escape }}"
                            {% if child_link.current %}aria-current="page"{% endif %}
                          >
                            {{ child_link.title | escape }}
                          </a>

                          {% if child_link.links != blank %}
                            <ul class="co-header__desktop-submenu-list" role="list">
                              {% for grandchild_link in child_link.links %}
                                <li>
                                  <a
                                    class="co-header__desktop-submenu-link{% if grandchild_link.active %} is-active{% endif %}"
                                    href="{{ grandchild_link.url | escape }}"
                                    {% if grandchild_link.current %}aria-current="page"{% endif %}
                                  >
                                    {{ grandchild_link.title | escape }}
                                  </a>
                                </li>
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  </details>
                {% else %}
                  <a
                    class="co-header__desktop-link{% if link.active or link.child_active %} is-active{% endif %}"
                    href="{{ link.url | escape }}"
                    {% if link.current %}aria-current="page"{% endif %}
                  >
                    {{ link.title | escape }}
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
    </div>

    <a class="co-header__brand" href="{{ routes.root_url | escape }}" aria-label="{{ shop.name | escape }}">
      {% if header_logo != blank %}
        <span class="co-header__logo co-header__logo--default">
          {% render 'responsive-image',
            image: header_logo,
            alt: '',
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(max-width: 47.99rem) 50vw, 320px',
            widths: '120, 180, 240, 320',
            class: 'co-header__logo-image'
          %}
        </span>
      {% else %}
        <span class="co-header__brand-name">{{ shop.name | escape }}</span>
      {% endif %}

      {% if has_distinct_transparent_logo %}
        <span class="co-header__logo co-header__logo--transparent">
          {% render 'responsive-image',
            image: transparent_logo,
            alt: '',
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(max-width: 47.99rem) 50vw, 320px',
            widths: '120, 180, 240, 320',
            class: 'co-header__logo-image'
          %}
        </span>
      {% endif %}
    </a>

    <div class="co-header__actions">
      {% if section.settings.show_search %}
        {% if section.settings.enable_predictive_search %}
          <details class="co-header__search-disclosure">
            <summary class="co-header__utility-button" aria-label="{{ search_label }}">
              {% render 'icon', name: 'search', size: 20 %}
              <span class="co-visually-hidden">{{ search_label }}</span>
            </summary>
            <form
              class="co-header__search-form"
              action="{{ routes.search_url }}"
              method="get"
              role="search"
              data-predictive-search
              data-predictive-search-url="{{ routes.predictive_search_url }}"
              data-predictive-search-section-id="predictive-search"
              data-loading-message="{{ 'search.loading_results' | t | escape }}"
              data-error-message="{{ 'search.predictive_error' | t | escape }}"
            >
              <label class="co-visually-hidden" for="HeaderSearch-{{ section.id }}">{{ search_label }}</label>
              <input type="hidden" name="options[prefix]" value="last">
              <input
                id="HeaderSearch-{{ section.id }}"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'search.input_placeholder' | t }}"
                autocomplete="off"
                enterkeyhint="search"
                data-predictive-search-input
                aria-autocomplete="list"
                aria-controls="{{ search_results_id }}"
                aria-expanded="false"
              >
              {% render 'button', label: search_label, type: 'submit', variant: 'primary', class: 'co-header__search-submit' %}
              <div id="{{ search_results_id }}" class="co-header__predictive-results" data-predictive-search-results hidden></div>
            </form>
          </details>
        {% else %}
          {% render 'button', url: routes.search_url, aria_label: search_label, icon: 'search', variant: 'text', class: 'co-header__action' %}
        {% endif %}
      {% endif %}

      {% if section.settings.show_account and shop.customer_accounts_enabled %}
        {% render 'button', url: account_url, aria_label: account_label, icon: 'account', variant: 'text', class: 'co-header__action co-header__account-action' %}
      {% endif %}

      {% if show_localization %}
        <details class="co-header__localization-disclosure">
          <summary class="co-header__utility-button" aria-label="{{ 'localization.update' | t }}">
            {% render 'icon', name: 'globe', size: 20 %}
            <span class="co-visually-hidden">{{ 'localization.update' | t }}</span>
          </summary>
          {% form 'localization', id: localization_form_id, class: 'co-header__localization-form' %}
            {% if has_multiple_countries %}
              <label for="HeaderCountry-{{ section.id }}">{{ 'localization.country_region' | t }}</label>
              <select id="HeaderCountry-{{ section.id }}" name="country_code">
                {% for country in localization.available_countries %}
                  <option value="{{ country.iso_code | escape }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.name | escape }} ({{ country.currency.iso_code | escape }} {{ country.currency.symbol | escape }})
                  </option>
                {% endfor %}
              </select>
            {% endif %}
            {% if has_multiple_languages %}
              <label for="HeaderLanguage-{{ section.id }}">{{ 'localization.language' | t }}</label>
              <select id="HeaderLanguage-{{ section.id }}" name="language_code">
                {% for language in localization.available_languages %}
                  <option value="{{ language.iso_code | escape }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                    {{ language.endonym_name | escape }}
                  </option>
                {% endfor %}
              </select>
            {% endif %}
            {% render 'button', label: localization_submit_label, type: 'submit', variant: 'secondary', class: 'co-header__localization-submit' %}
          {% endform %}
        </details>
      {% endif %}

      {% if section.settings.show_cart %}
        <span
          class="co-header__cart"
          data-header-cart-count
          data-cart-count-one="{{ 'header.cart_count' | t: count: 1 | escape }}"
          data-cart-count-other="{{ 'header.cart_count' | t: count: 2 | escape }}"
        >
          {% render 'button',
            url: routes.cart_url,
            aria_label: cart_label,
            icon: 'cart',
            variant: 'text',
            class: 'co-header__action',
            data_action: 'cart-drawer-open'
          %}
          <span class="co-header__cart-count" data-header-cart-count-value aria-hidden="true">{{ cart.item_count }}</span>
        </span>
      {% endif %}
    </div>
  </div>

  {% if has_mobile_menu %}
    <div class="co-header__drawer-overlay" data-mobile-nav-overlay aria-hidden="true"></div>
    <nav
      id="{{ mobile_navigation_id }}"
      class="co-header__mobile-navigation"
      aria-labelledby="{{ mobile_navigation_title_id }}"
      data-mobile-nav
      tabindex="-1"
    >
      <div class="co-header__mobile-navigation-inner">
        <div class="co-header__drawer-heading">
          <p id="{{ mobile_navigation_title_id }}" class="co-header__drawer-title">{{ 'navigation.main' | t }}</p>
          {% render 'button', aria_label: close_menu_label, icon: 'close', variant: 'text', class: 'co-header__drawer-close', data_action: 'mobile-nav-close' %}
        </div>
        <ul class="co-header__mobile-list" role="list">
          {% for link in mobile_menu.links %}
            <li class="co-header__mobile-item">
              <a class="co-header__mobile-link{% if link.active or link.child_active %} is-active{% endif %}" href="{{ link.url | escape }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {% if link.links != blank %}
                <details class="co-header__mobile-disclosure">
                  <summary>{{ 'header.expand_menu' | t: title: link.title }}</summary>
                  <ul class="co-header__mobile-submenu" role="list">
                    {% for child_link in link.links %}
                      <li>
                        <a class="co-header__mobile-sublink{% if child_link.active or child_link.child_active %} is-active{% endif %}" href="{{ child_link.url | escape }}" {% if child_link.current %}aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                        {% if child_link.links != blank %}
                          <ul class="co-header__mobile-submenu-list" role="list">
                            {% for grandchild_link in child_link.links %}
                              <li><a class="co-header__mobile-sublink{% if grandchild_link.active %} is-active{% endif %}" href="{{ grandchild_link.url | escape }}" {% if grandchild_link.current %}aria-current="page"{% endif %}>{{ grandchild_link.title | escape }}</a></li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              {% endif %}
            </li>
          {% endfor %}
        </ul>

        {% if has_mobile_utility %}
          <div class="co-header__mobile-utilities">
            {% if section.settings.show_account and shop.customer_accounts_enabled %}
              {% render 'button', url: account_url, aria_label: account_label, icon: 'account', variant: 'secondary', class: 'co-header__mobile-account' %}
            {% endif %}

            {% if show_localization %}
              {% form 'localization', id: mobile_localization_form_id, class: 'co-header__mobile-localization-form' %}
                {% if has_multiple_countries %}
                  <label for="MobileHeaderCountry-{{ section.id }}">{{ 'localization.country_region' | t }}</label>
                  <select id="MobileHeaderCountry-{{ section.id }}" name="country_code">
                    {% for country in localization.available_countries %}
                      <option value="{{ country.iso_code | escape }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                        {{ country.name | escape }} ({{ country.currency.iso_code | escape }} {{ country.currency.symbol | escape }})
                      </option>
                    {% endfor %}
                  </select>
                {% endif %}
                {% if has_multiple_languages %}
                  <label for="MobileHeaderLanguage-{{ section.id }}">{{ 'localization.language' | t }}</label>
                  <select id="MobileHeaderLanguage-{{ section.id }}" name="language_code">
                    {% for language in localization.available_languages %}
                      <option value="{{ language.iso_code | escape }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | escape }}</option>
                    {% endfor %}
                  </select>
                {% endif %}
                {% render 'button', label: localization_submit_label, type: 'submit', variant: 'secondary', class: 'co-header__mobile-localization-submit' %}
              {% endform %}
            {% endif %}
          </div>
        {% endif %}
      </div>
    </nav>
  {% endif %}
</header>

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "section",
  "class": "co-section-header",
  "limit": 1,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "header", "content": "t:sections.header.groups.navigation" },
    { "type": "link_list", "id": "menu", "label": "t:sections.header.settings.menu.label", "info": "t:sections.header.settings.menu.info", "default": "main-menu" },
    { "type": "link_list", "id": "mobile_menu", "label": "t:sections.header.settings.mobile_menu.label", "info": "t:sections.header.settings.mobile_menu.info" },
    { "type": "select", "id": "desktop_navigation_activation", "label": "t:sections.header.settings.desktop_navigation_activation.label", "default": "hover", "options": [
      { "value": "hover", "label": "t:sections.header.settings.desktop_navigation_activation.options.hover" },
      { "value": "click", "label": "t:sections.header.settings.desktop_navigation_activation.options.click" }
    ] },
    { "type": "header", "content": "t:sections.header.groups.logo" },
    { "type": "image_picker", "id": "logo", "label": "t:sections.header.settings.logo.label", "info": "t:sections.header.settings.logo.info" },
    { "type": "image_picker", "id": "transparent_logo", "label": "t:sections.header.settings.transparent_logo.label", "info": "t:sections.header.settings.transparent_logo.info" },
    { "type": "range", "id": "desktop_logo_width", "min": 80, "max": 360, "step": 4, "unit": "px", "label": "t:sections.header.settings.desktop_logo_width.label", "default": 160 },
    { "type": "range", "id": "mobile_logo_width", "min": 60, "max": 240, "step": 4, "unit": "px", "label": "t:sections.header.settings.mobile_logo_width.label", "default": 128 },
    { "type": "header", "content": "t:sections.header.groups.layout" },
    { "type": "select", "id": "layout", "label": "t:sections.header.settings.layout.label", "default": "centered", "options": [
      { "value": "centered", "label": "t:sections.header.settings.layout.options.centered" },
      { "value": "left", "label": "t:sections.header.settings.layout.options.left" }
    ] },
    { "type": "select", "id": "width", "label": "t:sections.header.settings.width.label", "default": "contained", "options": [
      { "value": "contained", "label": "t:sections.header.settings.width.options.contained" },
      { "value": "full", "label": "t:sections.header.settings.width.options.full" }
    ] },
    { "type": "range", "id": "desktop_height", "min": 56, "max": 128, "step": 4, "unit": "px", "label": "t:sections.header.settings.desktop_height.label", "default": 80 },
    { "type": "range", "id": "mobile_height", "min": 48, "max": 96, "step": 4, "unit": "px", "label": "t:sections.header.settings.mobile_height.label", "default": 64 },
    { "type": "range", "id": "horizontal_padding", "min": 12, "max": 64, "step": 2, "unit": "px", "label": "t:sections.header.settings.horizontal_padding.label", "default": 24 },
    { "type": "checkbox", "id": "show_border", "label": "t:sections.header.settings.show_border.label", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.header.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.header.groups.behavior" },
    { "type": "checkbox", "id": "sticky_header", "label": "t:sections.header.settings.sticky_header.label", "info": "t:sections.header.settings.sticky_header.info", "default": true },
    { "type": "checkbox", "id": "hide_on_scroll", "label": "t:sections.header.settings.hide_on_scroll.label", "info": "t:sections.header.settings.hide_on_scroll.info", "default": false },
    { "type": "checkbox", "id": "transparent_homepage", "label": "t:sections.header.settings.transparent_homepage.label", "info": "t:sections.header.settings.transparent_homepage.info", "default": false },
    { "type": "select", "id": "transparent_text_treatment", "label": "t:sections.header.settings.transparent_text_treatment.label", "default": "light", "options": [
      { "value": "light", "label": "t:sections.header.settings.transparent_text_treatment.options.light" },
      { "value": "dark", "label": "t:sections.header.settings.transparent_text_treatment.options.dark" }
    ] },
    { "type": "header", "content": "t:sections.header.groups.utilities" },
    { "type": "checkbox", "id": "show_search", "label": "t:sections.header.settings.show_search.label", "default": true },
    { "type": "checkbox", "id": "enable_predictive_search", "label": "t:sections.header.settings.enable_predictive_search.label", "info": "t:sections.header.settings.enable_predictive_search.info", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "t:sections.header.settings.show_account.label", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "t:sections.header.settings.show_cart.label", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "t:sections.header.settings.show_localization.label", "info": "t:sections.header.settings.show_localization.info", "default": true }
  ],
  "presets": [{ "name": "t:sections.header.presets.default" }]
}
{% endschema %}
