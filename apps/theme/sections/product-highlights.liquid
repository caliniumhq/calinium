{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{% if section.settings.enable_quick_add %}
  {{ 'component-quantity-input.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
{% endif %}

{% liquid
  assign highlights_product = section.settings.product
  assign highlights_heading_id = 'ProductHighlightsHeading-' | append: section.id
  assign highlights_classes = 'co-product-highlights co-commerce-section co-color-scheme-' | append: section.settings.color_scheme
  assign highlights_classes = highlights_classes | append: ' co-product-highlights--media-' | append: section.settings.media_position
  assign highlights_classes = highlights_classes | append: ' co-product-highlights--layout-' | append: section.settings.layout
%}

{% render 'section-spacing', section: section %}

<section class="{{ highlights_classes }}" {% if section.settings.heading != blank %}aria-labelledby="{{ highlights_heading_id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="co-product-highlights__inner{% if section.settings.layout == 'contained' %} co-page-width{% endif %}">
    {% if section.settings.heading != blank or section.settings.description != blank %}{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.description, id: highlights_heading_id, alignment: 'left', size: section.settings.heading_size, class: 'co-commerce-section__header' %}{% endif %}
    {% if highlights_product != blank %}
      <div class="co-product-highlights__layout">
        <div class="co-product-highlights__media">
          {% render 'product-card', product: highlights_product, section_id: section.id, image_ratio: section.settings.image_ratio, image_loading: 'lazy', image_sizes: '(min-width: 48rem) 50vw, 100vw', image_widths: '375, 550, 750, 1000, 1500', show_vendor: section.settings.show_vendor, show_rating: false, show_compare_at_price: true, show_sale_badge: true, show_sold_out_badge: true, show_secondary_image: section.settings.show_secondary_image, show_inventory: false, show_quick_add: section.settings.enable_quick_add, card_alignment: 'left' %}
        </div>
        <div class="co-product-highlights__content">
          {% if highlights_product.description != blank %}<div class="co-product-highlights__description">{{ highlights_product.description | strip_html | truncate: 280 | escape }}</div>{% endif %}
          {% if section.blocks.size > 0 %}
            <div class="co-product-highlights__list" role="list">
              {% for block in section.blocks %}
                <article class="co-product-highlights__item" role="listitem" {{ block.shopify_attributes }}>
                  {% if block.settings.highlight_icon != 'none' %}<span class="co-product-highlights__icon">{% render 'icon', icon: block.settings.highlight_icon, size: 24, decorative: true %}</span>{% endif %}
                  <div>{% if block.settings.heading != blank %}<h3 class="co-product-highlights__item-title">{{ block.settings.heading | escape }}</h3>{% endif %}{% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}</div>
                </article>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    {% elsif request.design_mode %}
      <p class="co-commerce-section__empty">{{ 'sections.product_highlights.empty' | t }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.product_highlights.name",
  "tag": "section",
  "class": "co-section-product-highlights",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.shared.settings.product.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.shared.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.shared.settings.heading.label",
      "default": "Product highlights"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.shared.settings.description.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.shared.settings.heading_size.label",
      "default": "standard",
      "options": [
        {
          "value": "small",
          "label": "t:sections.shared.options.small"
        },
        {
          "value": "standard",
          "label": "t:sections.shared.options.standard"
        },
        {
          "value": "large",
          "label": "t:sections.shared.options.large"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:sections.shared.settings.media_position.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.shared.options.left"
        },
        {
          "value": "right",
          "label": "t:sections.shared.options.right"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.shared.settings.layout.label",
      "default": "contained",
      "options": [
        {
          "value": "contained",
          "label": "t:sections.product_highlights.settings.layout.options.contained"
        },
        {
          "value": "full-width",
          "label": "t:sections.product_highlights.settings.layout.options.full_width"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.shared.settings.image_ratio.label",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "t:sections.shared.options.square"
        },
        {
          "value": "portrait",
          "label": "t:sections.shared.options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:sections.shared.options.landscape"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.shared.settings.show_vendor.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.shared.settings.show_secondary_image.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "t:sections.shared.settings.enable_quick_add.label",
      "info": "t:sections.shared.settings.enable_quick_add.info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.shared.settings.desktop_top_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.shared.settings.desktop_bottom_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:sections.shared.settings.mobile_top_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:sections.shared.settings.mobile_bottom_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "t:sections.product_highlights.blocks.highlight",
      "settings": [
        {
          "type": "select",
          "id": "highlight_icon",
          "label": "t:sections.shared.settings.icon.label",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "t:sections.shared.options.none"
            },
            {
              "value": "sparkle",
              "label": "t:sections.shared.options.sparkle"
            },
            {
              "value": "verified",
              "label": "t:sections.shared.options.verified"
            },
            {
              "value": "leaf",
              "label": "t:sections.shared.options.leaf"
            },
            {
              "value": "package",
              "label": "t:sections.shared.options.package"
            },
            {
              "value": "shield-check",
              "label": "t:sections.shared.options.shield-check"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.shared.settings.heading.label",
          "default": "A considered detail"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.shared.settings.text.label"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.product_highlights.preset",
      "blocks": [
        {
          "type": "highlight"
        },
        {
          "type": "highlight"
        },
        {
          "type": "highlight"
        }
      ]
    }
  ]
}
{% endschema %}
