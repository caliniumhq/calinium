{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% liquid
  assign process_heading_id = 'ManufacturingProcessHeading-' | append: section.id
  assign process_classes = 'co-manufacturing-process co-brand-story-section co-color-scheme-' | append: section.settings.color_scheme
%}
{% render 'section-spacing', section: section %}
<section class="{{ process_classes }}" style="--co-process-columns: {{ section.settings.columns_desktop }};"{% if section.settings.heading != blank %} aria-labelledby="{{ process_heading_id }}"{% endif %} {{ section.shopify_attributes }}><div class="co-page-width">
  {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.text, id: process_heading_id, level: 'h2', alignment: section.settings.text_alignment, size: section.settings.heading_size, class: 'co-brand-story-section__header' %}
  {% if section.blocks.size > 0 %}<ol class="co-manufacturing-process__list">{% for block in section.blocks %}<li class="co-manufacturing-process__step" {{ block.shopify_attributes }}><div class="co-manufacturing-process__step-content">{% if block.settings.process_icon != 'none' %}<span class="co-brand-story-section__note">{% render 'icon', icon: block.settings.process_icon, size: 22, decorative: true %}</span>{% endif %}{% render 'timeline-item', heading: block.settings.heading, text: block.settings.text %}{% if block.settings.image != blank %}{% render 'media-item', image: block.settings.image, loading: 'lazy', image_sizes: '(min-width: 48rem) 22vw, 100vw', image_widths: '165, 360, 535, 750', image_ratio: 'landscape', class: 'co-manufacturing-process__image' %}{% endif %}{% if block.settings.duration != blank or block.settings.statistic != blank %}<p class="co-manufacturing-process__meta">{% if block.settings.duration != blank %}<span>{{ block.settings.duration | escape }}</span>{% endif %}{% if block.settings.statistic != blank %}<span>{{ block.settings.statistic | escape }}</span>{% endif %}</p>{% endif %}</div></li>{% endfor %}</ol>{% elsif request.design_mode %}<p class="co-brand-story-section__empty">{{ 'sections.manufacturing_process.empty' | t }}</p>{% endif %}
</div></section>
{% schema %}
{"name":"t:sections.manufacturing_process.name","tag":"section","class":"co-section-manufacturing-process","settings":[{"type":"text","id":"eyebrow","label":"t:sections.shared.settings.eyebrow.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label","default":"How it is made"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"},{"type":"select","id":"heading_size","label":"t:sections.shared.settings.heading_size.label","default":"standard","options":[{"value":"small","label":"t:sections.shared.options.small"},{"value":"standard","label":"t:sections.shared.options.standard"},{"value":"large","label":"t:sections.shared.options.large"}]},{"type":"select","id":"text_alignment","label":"t:sections.shared.settings.text_alignment.label","default":"left","options":[{"value":"left","label":"t:sections.shared.options.left"},{"value":"center","label":"t:sections.shared.options.center"}]},{"type":"select","id":"columns_desktop","label":"t:sections.manufacturing_process.settings.columns_desktop.label","default":"4","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"}]},{"type":"color_scheme","id":"color_scheme","label":"t:sections.shared.settings.color_scheme.label","default":"scheme-1"},{"type":"range","id":"padding_top","label":"t:sections.shared.settings.desktop_top_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"t:sections.shared.settings.desktop_bottom_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"mobile_padding_top","label":"t:sections.shared.settings.mobile_top_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_padding_bottom","label":"t:sections.shared.settings.mobile_bottom_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48}],"blocks":[{"type":"process_step","name":"t:sections.manufacturing_process.blocks.process_step","settings":[{"type":"select","id":"process_icon","label":"t:sections.shared.settings.icon.label","default":"settings","options":[{"value":"none","label":"t:sections.shared.options.none"},{"value":"settings","label":"t:sections.shared.options.settings"},{"value":"factory","label":"t:sections.shared.options.factory"},{"value":"check","label":"t:sections.shared.options.check"},{"value":"package","label":"t:sections.shared.options.package"}]},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"},{"type":"image_picker","id":"image","label":"t:sections.shared.settings.image.label"},{"type":"text","id":"duration","label":"t:sections.manufacturing_process.settings.duration.label"},{"type":"text","id":"statistic","label":"t:sections.manufacturing_process.settings.statistic.label"}]}],"max_blocks":10,"presets":[{"name":"t:sections.manufacturing_process.preset","blocks":[{"type":"process_step"},{"type":"process_step"}]}]}
{% endschema %}
