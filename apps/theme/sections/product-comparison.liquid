          "id": "value_2",
          "label": "t:sections.shared.settings.value_2.label"
        },
        {
          "type": "select",
          "id": "value_type_2",
          "label": "t:sections.product_comparison.settings.value_type_2.label",
          "default": "text",
          "options": [
            {
              "value": "text",
              "label": "t:sections.product_comparison.blocks.feature.options.text"
            },
            {
              "value": "check",
              "label": "t:sections.shared.options.check"
            },
            {
              "value": "cross",
              "label": "t:sections.product_comparison.blocks.feature.options.cross"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "value_3",
          "label": "t:sections.shared.settings.value_3.label"
        },
        {
          "type": "select",
          "id": "value_type_3",
          "label": "t:sections.product_comparison.settings.value_type_3.label",
          "default": "text",
          "options": [
            {
              "value": "text",
              "label": "t:sections.product_comparison.blocks.feature.options.text"
            },
            {
              "value": "check",
              "label": "t:sections.shared.options.check"
            },
            {
              "value": "cross",
              "label": "t:sections.shared.options.cross"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "value_4",
          "label": "t:sections.shared.settings.value_4.label"
        },
        {
          "type": "select",
          "id": "value_type_4",
          "label": "t:sections.product_comparison.settings.value_type_4.label",
          "default": "text",
          "options": [
            {
              "value": "text",
              "label": "t:sections.product_comparison.blocks.feature.options.text"
            },
            {
              "value": "check",
