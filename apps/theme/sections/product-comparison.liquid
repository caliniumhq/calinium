{{ 'component-image.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{% if section.settings.enable_quick_add %}
  {{ 'component-quantity-input.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
{% endif %}

{% liquid
  assign comparison_heading_id = 'ProductComparisonHeading-' | append: section.id
  assign comparison_classes = 'co-product-comparison co-commerce-section co-color-scheme-' | append: section.settings.color_scheme
  assign comparison_product_blocks = section.blocks | where: 'type', 'product'
  assign comparison_feature_blocks = section.blocks | where: 'type', 'feature'
  assign comparison_highlight_index = section.settings.highlighted_product | plus: 0
  assign comparison_selected_count = 0
  for product_block in comparison_product_blocks
    if product_block.settings.product != blank
      assign comparison_selected_count = comparison_selected_count | plus: 1
    endif
  endfor
  if section.settings.sticky_first_column
    assign comparison_classes = comparison_classes | append: ' co-product-comparison--sticky-first-column'
  endif
%}

{% render 'section-spacing', section: section %}

<section class="{{ comparison_classes }}" {% if section.settings.heading != blank %}aria-labelledby="{{ comparison_heading_id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="co-page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.description, id: comparison_heading_id, alignment: section.settings.text_alignment, size: section.settings.heading_size, class: 'co-commerce-section__header' %}
    {% if comparison_selected_count >= 2 %}
      <div class="co-product-comparison__product-grid" style="--co-comparison-columns: {{ comparison_selected_count }};">
        {% assign comparison_rendered_index = 0 %}
        {% for product_block in comparison_product_blocks %}
          {% if product_block.settings.product != blank %}
            {% assign comparison_rendered_index = comparison_rendered_index | plus: 1 %}
            <div{% if comparison_rendered_index == comparison_highlight_index %} class="co-product-comparison__highlight"{% endif %} {{ product_block.shopify_attributes }}>
              {% render 'product-card', product: product_block.settings.product, section_id: section.id, image_ratio: section.settings.image_ratio, image_loading: 'lazy', image_sizes: '(min-width: 48rem) 25vw, 50vw', image_widths: '165, 360, 535, 750, 1000', show_vendor: section.settings.show_vendor, show_rating: false, show_compare_at_price: true, show_sale_badge: true, show_sold_out_badge: true, show_secondary_image: false, show_inventory: false, show_quick_add: section.settings.enable_quick_add, card_alignment: 'left' %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% if comparison_feature_blocks.size > 0 %}
        <div class="co-product-comparison__scroll" tabindex="0" aria-label="{{ 'sections.product_comparison.table_label' | t | escape }}">
          <table class="co-product-comparison__table">
            <thead>
              <tr>
                <th scope="col">{{ section.settings.first_column_heading | escape }}</th>
                {% assign comparison_rendered_index = 0 %}
                {% for product_block in comparison_product_blocks %}
                  {% if product_block.settings.product != blank %}
                    {% assign comparison_rendered_index = comparison_rendered_index | plus: 1 %}
                    <th scope="col"{% if comparison_rendered_index == comparison_highlight_index %} class="co-product-comparison__highlight"{% endif %}>{{ product_block.settings.product.title | escape }}</th>
                  {% endif %}
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for feature_block in comparison_feature_blocks %}
                <tr {{ feature_block.shopify_attributes }}>
                  <th scope="row">{{ feature_block.settings.label | escape }}</th>
                  {% assign comparison_rendered_index = 0 %}
                  {% for product_block in comparison_product_blocks %}
                    {% if product_block.settings.product != blank %}
                    {% assign comparison_rendered_index = comparison_rendered_index | plus: 1 %}
                    {% liquid
                      assign comparison_value = blank
                      assign comparison_value_type = 'text'
                      case comparison_rendered_index
                        when 1
                          assign comparison_value = feature_block.settings.value_1
                          assign comparison_value_type = feature_block.settings.value_type_1
                        when 2
                          assign comparison_value = feature_block.settings.value_2
                          assign comparison_value_type = feature_block.settings.value_type_2
                        when 3
                          assign comparison_value = feature_block.settings.value_3
                          assign comparison_value_type = feature_block.settings.value_type_3
                        when 4
                          assign comparison_value = feature_block.settings.value_4
                          assign comparison_value_type = feature_block.settings.value_type_4
                      endcase
                    %}
                    <td{% if comparison_rendered_index == comparison_highlight_index %} class="co-product-comparison__highlight"{% endif %}>
                      {% if comparison_value_type == 'check' %}<span class="co-product-comparison__value-icon" role="img" aria-label="{{ 'sections.product_comparison.included' | t | escape }}">{% render 'icon', icon: 'check', size: 20, decorative: true %}</span>
                      {% elsif comparison_value_type == 'cross' %}<span class="co-product-comparison__value-icon co-product-comparison__value-icon--cross" role="img" aria-label="{{ 'sections.product_comparison.not_included' | t | escape }}">{% render 'icon', icon: 'close', size: 20, decorative: true %}</span>
                      {% elsif comparison_value != blank %}{{ comparison_value }}
                      {% else %}<span aria-hidden="true">—</span><span class="co-visually-hidden">{{ 'sections.product_comparison.not_available' | t }}</span>{% endif %}
                    </td>
                    {% endif %}
                  {% endfor %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    {% elsif request.design_mode %}
      <p class="co-commerce-section__empty">{{ 'sections.product_comparison.empty' | t }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.product_comparison.name",
  "tag": "section",
  "class": "co-section-product-comparison",
  "settings": [
    {
      "type": "text",
