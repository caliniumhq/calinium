          "default": "Feature"
        },
        {
          "type": "inline_richtext",
          "id": "value_1",
          "label": "t:sections.shared.settings.value_1.label"
        },
        {
          "type": "select",
          "id": "value_type_1",
          "label": "t:sections.product_comparison.settings.value_type_1.label",
          "default": "text",
          "options": [
            {
              "value": "text",
              "label": "t:sections.product_comparison.blocks.feature.options.text"
            },
            {
              "value": "check",
              "label": "t:sections.shared.options.check"
            },
            {
              "value": "cross",
              "label": "t:sections.product_comparison.blocks.feature.options.cross"
            }
          ]
        },
        {
