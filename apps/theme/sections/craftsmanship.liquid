{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% liquid
  assign craft_heading_id = 'CraftsmanshipHeading-' | append: section.id
  assign craft_classes = 'co-craftsmanship co-brand-story-section co-color-scheme-' | append: section.settings.color_scheme
  assign craft_classes = craft_classes | append: ' co-craftsmanship--image-' | append: section.settings.image_position
%}
{% render 'section-spacing', section: section %}
<section class="{{ craft_classes }}"{% if section.settings.heading != blank %} aria-labelledby="{{ craft_heading_id }}"{% endif %} {{ section.shopify_attributes }}><div class="co-page-width"><div class="co-craftsmanship__layout"><div class="co-craftsmanship__media">{% if section.settings.video != blank %}{{ section.settings.video | video_tag: controls: true, muted: true, preload: 'metadata', class: 'co-craftsmanship__video' }}{% elsif section.settings.image != blank %}{% render 'responsive-image', image: section.settings.image, mobile_image: section.settings.mobile_image, loading: 'lazy', sizes: '(min-width: 48rem) 50vw, 100vw', widths: '375, 550, 750, 1000, 1500', ratio: section.settings.image_ratio, class: 'co-craftsmanship__image' %}{% elsif request.design_mode %}<div class="co-brand-story-section__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>{% endif %}</div><div class="co-craftsmanship__content co-brand-story-section__content">{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.text, id: craft_heading_id, level: 'h2', alignment: section.settings.text_alignment, size: section.settings.heading_size %}{% if section.settings.quote != blank %}<blockquote class="co-brand-story-section__quote">{{ section.settings.quote | escape }}</blockquote>{% endif %}{% if section.blocks.size > 0 %}<div class="co-craftsmanship__steps" role="list">{% for block in section.blocks %}<div role="listitem" {{ block.shopify_attributes }}>{% render 'feature-item', icon: block.settings.craft_icon, image: block.settings.image, heading: block.settings.heading, text: block.settings.text, image_loading: 'lazy', image_sizes: '80px', image_widths: '48, 80, 120', image_ratio: 'square', class: 'co-craftsmanship__step' %}</div>{% endfor %}</div>{% endif %}{% if section.settings.button_label != blank and section.settings.button_link != blank %}<div class="co-brand-story-section__actions">{% render 'button', label: section.settings.button_label, url: section.settings.button_link, variant: 'primary' %}</div>{% endif %}</div></div></div></section>
{% schema %}
{"name":"t:sections.craftsmanship.name","tag":"section","class":"co-section-craftsmanship","settings":[{"type":"image_picker","id":"image","label":"t:sections.shared.settings.image.label"},{"type":"image_picker","id":"mobile_image","label":"t:sections.shared.settings.mobile_image.label","info":"t:sections.shared.settings.mobile_image.info"},{"type":"video","id":"video","label":"t:sections.shared.settings.hosted_video.label"},{"type":"text","id":"eyebrow","label":"t:sections.shared.settings.eyebrow.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label","default":"Craftsmanship"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"},{"type":"textarea","id":"quote","label":"t:sections.shared.settings.quote.label"},{"type":"text","id":"button_label","label":"t:sections.shared.settings.button_label.label"},{"type":"url","id":"button_link","label":"t:sections.shared.settings.button_link.label"},{"type":"select","id":"image_position","label":"t:sections.craftsmanship.settings.image_position.label","default":"left","options":[{"value":"left","label":"t:sections.shared.options.left"},{"value":"right","label":"t:sections.shared.options.right"}]},{"type":"select","id":"image_ratio","label":"t:sections.shared.settings.image_ratio.label","default":"portrait","options":[{"value":"square","label":"t:sections.shared.options.square"},{"value":"portrait","label":"t:sections.shared.options.portrait"},{"value":"landscape","label":"t:sections.shared.options.landscape"}]},{"type":"select","id":"text_alignment","label":"t:sections.shared.settings.text_alignment.label","default":"left","options":[{"value":"left","label":"t:sections.shared.options.left"},{"value":"center","label":"t:sections.shared.options.center"}]},{"type":"select","id":"heading_size","label":"t:sections.shared.settings.heading_size.label","default":"large","options":[{"value":"small","label":"t:sections.shared.options.small"},{"value":"standard","label":"t:sections.shared.options.standard"},{"value":"large","label":"t:sections.shared.options.large"}]},{"type":"color_scheme","id":"color_scheme","label":"t:sections.shared.settings.color_scheme.label","default":"scheme-1"},{"type":"range","id":"padding_top","label":"t:sections.shared.settings.desktop_top_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"t:sections.shared.settings.desktop_bottom_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"mobile_padding_top","label":"t:sections.shared.settings.mobile_top_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_padding_bottom","label":"t:sections.shared.settings.mobile_bottom_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48}],"blocks":[{"type":"craft_step","name":"t:sections.craftsmanship.blocks.craft_step","settings":[{"type":"select","id":"craft_icon","label":"t:sections.shared.settings.icon.label","default":"sparkle","options":[{"value":"sparkle","label":"t:sections.shared.options.sparkle"},{"value":"factory","label":"t:sections.shared.options.factory"},{"value":"settings","label":"t:sections.shared.options.settings"},{"value":"diamond","label":"t:sections.shared.options.diamond"}]},{"type":"image_picker","id":"image","label":"t:sections.shared.settings.image.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"}]}],"max_blocks":8,"presets":[{"name":"t:sections.craftsmanship.preset","blocks":[{"type":"craft_step"},{"type":"craft_step"}]}]}
{% endschema %}
