{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}

{% liquid
  assign multicolumn_classes = 'co-multicolumn co-library-section co-color-scheme-' | append: section.settings.color_scheme
  assign multicolumn_classes = multicolumn_classes | append: ' co-multicolumn--desktop-columns-' | append: section.settings.desktop_columns
  assign multicolumn_classes = multicolumn_classes | append: ' co-multicolumn--mobile-columns-' | append: section.settings.mobile_columns
  assign multicolumn_classes = multicolumn_classes | append: ' co-multicolumn--align-' | append: section.settings.alignment
  assign multicolumn_classes = multicolumn_classes | append: ' co-multicolumn--card-' | append: section.settings.card_style

  if section.settings.mobile_slider
    assign multicolumn_classes = multicolumn_classes | append: ' co-multicolumn--mobile-slider'
  endif

  assign multicolumn_heading_id = 'MulticolumnHeading-' | append: section.id
%}

{% render 'section-spacing', section: section %}

<section class="{{ multicolumn_classes }}" aria-labelledby="{{ multicolumn_heading_id }}" {{ section.shopify_attributes }}>
  <div class="co-multicolumn__inner co-page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.description, id: multicolumn_heading_id, alignment: section.settings.alignment, size: section.settings.heading_size %}
    {% if section.blocks.size > 0 %}
      <ul class="co-multicolumn__grid" role="list">
        {% for block in section.blocks %}
          <li class="co-multicolumn__item" {{ block.shopify_attributes }}>
            <article class="co-multicolumn-card">
              {% if block.settings.image != blank %}
                {% render 'responsive-image', image: block.settings.image, alt: block.settings.image.alt, loading: 'lazy', sizes: '(min-width: 48rem) 25vw, 76vw', widths: '165, 360, 535, 750, 1000', ratio: section.settings.image_ratio, class: 'co-multicolumn-card__image' %}
              {% elsif block.settings.icon != 'none' %}
                <span class="co-multicolumn-card__icon">{% render 'icon', name: block.settings.icon, size: 32 %}</span>
              {% endif %}
              {% if block.settings.heading != blank %}<h2 class="co-multicolumn-card__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
              {% if block.settings.text != blank %}<div class="co-multicolumn-card__text">{{ block.settings.text }}</div>{% endif %}
              {% if block.settings.link != blank and block.settings.link_label != blank %}{% render 'button', label: block.settings.link_label, url: block.settings.link, variant: 'text', class: 'co-multicolumn-card__link' %}{% endif %}
            </article>
          </li>
        {% endfor %}
      </ul>
    {% elsif request.design_mode %}
      <p>{{ 'sections.multicolumn.placeholder_text' | t }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
