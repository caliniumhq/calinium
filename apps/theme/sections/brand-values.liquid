{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% liquid
  assign values_heading_id = 'BrandValuesHeading-' | append: section.id
  assign values_classes = 'co-brand-values co-brand-story-section co-color-scheme-' | append: section.settings.color_scheme
  assign values_classes = values_classes | append: ' co-brand-values--' | append: section.settings.layout
  if section.settings.featured_first
    assign values_classes = values_classes | append: ' co-brand-values--featured-first'
  endif
%}
{% render 'section-spacing', section: section %}
<section class="{{ values_classes }}" style="--co-brand-values-desktop-columns: {{ section.settings.columns_desktop }}; --co-brand-values-mobile-columns: {{ section.settings.columns_mobile }};"{% if section.settings.heading != blank %} aria-labelledby="{{ values_heading_id }}"{% endif %} {{ section.shopify_attributes }}><div class="co-page-width">{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.text, id: values_heading_id, level: 'h2', alignment: section.settings.text_alignment, size: section.settings.heading_size, class: 'co-brand-story-section__header' %}{% if section.blocks.size > 0 %}<div class="co-brand-values__grid" role="list">{% for block in section.blocks %}<div class="co-brand-values__item" role="listitem" {{ block.shopify_attributes }}>{% render 'feature-item', icon: block.settings.value_icon, image: block.settings.image, heading: block.settings.heading, text: block.settings.text, image_loading: 'lazy', image_sizes: '280px', image_widths: '165, 240, 360, 535', image_ratio: section.settings.image_ratio %}</div>{% endfor %}</div>{% elsif request.design_mode %}<p class="co-brand-story-section__empty">{{ 'sections.brand_values.empty' | t }}</p>{% endif %}{% if section.settings.button_label != blank and section.settings.button_link != blank %}<div class="co-brand-story-section__actions">{% render 'button', label: section.settings.button_label, url: section.settings.button_link, variant: 'secondary' %}</div>{% endif %}</div></section>
{% schema %}
{"name":"t:sections.brand_values.name","tag":"section","class":"co-section-brand-values","settings":[{"type":"text","id":"eyebrow","label":"t:sections.shared.settings.eyebrow.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label","default":"Our values"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"},{"type":"text","id":"button_label","label":"t:sections.shared.settings.button_label.label"},{"type":"url","id":"button_link","label":"t:sections.shared.settings.button_link.label"},{"type":"select","id":"heading_size","label":"t:sections.shared.settings.heading_size.label","default":"large","options":[{"value":"small","label":"t:sections.shared.options.small"},{"value":"standard","label":"t:sections.shared.options.standard"},{"value":"large","label":"t:sections.shared.options.large"}]},{"type":"select","id":"text_alignment","label":"t:sections.shared.settings.text_alignment.label","default":"left","options":[{"value":"left","label":"t:sections.shared.options.left"},{"value":"center","label":"t:sections.shared.options.center"}]},{"type":"select","id":"layout","label":"t:sections.shared.settings.layout.label","default":"grid","options":[{"value":"grid","label":"t:sections.shared.options.grid"},{"value":"list","label":"t:sections.brand_values.settings.layout.options.list"},{"value":"editorial","label":"t:sections.shared.options.editorial"}]},{"type":"checkbox","id":"featured_first","label":"t:sections.brand_values.settings.featured_first.label","default":false},{"type":"select","id":"columns_desktop","label":"t:sections.brand_values.settings.columns_desktop.label","default":"4","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}]},{"type":"select","id":"columns_mobile","label":"t:sections.brand_values.settings.columns_mobile.label","default":"2","options":[{"value":"1","label":"t:sections.shared.options.one"},{"value":"2","label":"t:sections.shared.options.two"}]},{"type":"select","id":"image_ratio","label":"t:sections.shared.settings.image_ratio.label","default":"square","options":[{"value":"square","label":"t:sections.shared.options.square"},{"value":"portrait","label":"t:sections.shared.options.portrait"},{"value":"landscape","label":"t:sections.shared.options.landscape"}]},{"type":"color_scheme","id":"color_scheme","label":"t:sections.shared.settings.color_scheme.label","default":"scheme-1"},{"type":"range","id":"padding_top","label":"t:sections.shared.settings.desktop_top_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"t:sections.shared.settings.desktop_bottom_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"mobile_padding_top","label":"t:sections.shared.settings.mobile_top_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_padding_bottom","label":"t:sections.shared.settings.mobile_bottom_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48}],"blocks":[{"type":"value","name":"t:sections.brand_values.blocks.value","settings":[{"type":"select","id":"value_icon","label":"t:sections.shared.settings.icon.label","default":"heart","options":[{"value":"heart","label":"t:sections.shared.options.heart"},{"value":"sparkle","label":"t:sections.shared.options.sparkle"},{"value":"shield","label":"t:sections.shared.options.shield"},{"value":"globe","label":"t:sections.shared.options.globe"},{"value":"star","label":"t:sections.shared.options.star"}]},{"type":"image_picker","id":"image","label":"t:sections.shared.settings.image.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"}]}],"max_blocks":8,"presets":[{"name":"t:sections.brand_values.preset","blocks":[{"type":"value"},{"type":"value"},{"type":"value"}]}]}
{% endschema %}
