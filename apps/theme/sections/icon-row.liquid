{{ 'component-image.css' | asset_url | stylesheet_tag }}

{% liquid
  assign icon_row_classes = 'co-icon-row co-library-section co-color-scheme-' | append: section.settings.color_scheme
  assign icon_row_classes = icon_row_classes | append: ' co-icon-row--columns-' | append: section.settings.items_per_row
  assign icon_row_classes = icon_row_classes | append: ' co-icon-row--align-' | append: section.settings.alignment
  assign icon_row_classes = icon_row_classes | append: ' co-icon-row--divider-' | append: section.settings.divider_style

  if section.settings.mobile_scroll
    assign icon_row_classes = icon_row_classes | append: ' co-icon-row--mobile-scroll'
  endif
%}

{% render 'section-spacing', section: section %}

<section class="{{ icon_row_classes }}" {{ section.shopify_attributes }}>
  <div class="co-icon-row__inner co-page-width">
    <ul class="co-icon-row__list" role="list">
      {% for block in section.blocks %}
        <li class="co-icon-row__item" {{ block.shopify_attributes }}>
          {% capture icon_row_content %}
            {% if block.settings.image != blank %}
              {% render 'responsive-image', image: block.settings.image, alt: block.settings.image_alt, loading: 'lazy', sizes: '72px', widths: '48, 72, 96', ratio: 'natural', fit: 'contain', class: 'co-icon-row__image' %}
            {% else %}
              <span class="co-icon-row__icon">{% render 'icon', name: block.settings.icon, size: 32 %}</span>
            {% endif %}
            {% if block.settings.heading != blank %}<h2 class="co-icon-row__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
            {% if block.settings.text != blank %}<p class="co-icon-row__text">{{ block.settings.text | escape }}</p>{% endif %}
          {% endcapture %}
          {% if block.settings.link != blank %}<a class="co-icon-row__link" href="{{ block.settings.link | escape }}" {% if block.settings.heading != blank %}aria-label="{{ block.settings.heading | escape }}"{% endif %}>{{ icon_row_content }}</a>{% else %}{{ icon_row_content }}{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

