{% liquid
  assign editorial_grid_classes = 'co-editorial-grid co-library-section co-editorial-pack-section co-color-scheme-' | append: section.settings.color_scheme
  assign editorial_grid_classes = editorial_grid_classes | append: ' co-editorial-grid--columns-' | append: section.settings.desktop_columns
  if section.settings.featured_first_card
    assign editorial_grid_classes = editorial_grid_classes | append: ' co-editorial-grid--featured-first'
  endif
  if section.settings.show_borders
    assign editorial_grid_classes = editorial_grid_classes | append: ' co-editorial-grid--borders'
  endif
  assign editorial_grid_heading_id = 'EditorialGridHeading-' | append: section.id
%}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% render 'section-spacing', section: section %}
<section class="{{ editorial_grid_classes }}" {% if section.settings.heading != blank %}aria-labelledby="{{ editorial_grid_heading_id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="co-page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.description, id: editorial_grid_heading_id, alignment: section.settings.text_alignment, size: section.settings.heading_size %}

    {% if section.blocks.size > 0 %}
      <div class="co-editorial-grid__grid" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign grid_url = block.settings.link
            assign grid_title = block.settings.heading
            assign grid_eyebrow = block.settings.eyebrow
            assign grid_excerpt = block.settings.excerpt
            assign grid_image = block.settings.image

            if block.settings.article != blank
              assign grid_url = block.settings.article.url
              if grid_title == blank
                assign grid_title = block.settings.article.title
              endif
              if grid_eyebrow == blank
                assign grid_eyebrow = block.settings.article.blog.title
              endif
              if grid_excerpt == blank
                assign grid_excerpt = block.settings.article.excerpt_or_content | strip_html | truncate: 140
              endif
              if grid_image == blank
                assign grid_image = block.settings.article.image
              endif
            elsif block.settings.collection != blank
              assign grid_url = block.settings.collection.url
              if grid_title == blank
                assign grid_title = block.settings.collection.title
              endif
              if grid_image == blank
                assign grid_image = block.settings.collection.featured_image
              endif
            elsif block.settings.page != blank
              assign grid_url = block.settings.page.url
              if grid_title == blank
                assign grid_title = block.settings.page.title
              endif
              if grid_excerpt == blank
                assign grid_excerpt = block.settings.page.content | strip_html | truncate: 140
              endif
            endif
          %}
          <article class="co-editorial-grid__item" role="listitem" {{ block.shopify_attributes }}>
            {% capture grid_content %}
              <div class="co-editorial-grid__card">
                {% if grid_image != blank %}
                  {% render 'responsive-image', image: grid_image, loading: 'lazy', sizes: '(min-width: 48rem) 25vw, 50vw', widths: '240, 360, 535, 750, 1000', ratio: section.settings.media_ratio, class: 'co-editorial-grid__image' %}
                {% endif %}
                {% if grid_eyebrow != blank %}<p class="co-editorial-grid__eyebrow">{{ grid_eyebrow | escape }}</p>{% endif %}
                {% if grid_title != blank %}<h3 class="co-editorial-grid__title">{{ grid_title | strip_html | escape }}</h3>{% endif %}
                {% if grid_excerpt != blank %}<p class="co-editorial-grid__excerpt">{{ grid_excerpt | escape }}</p>{% endif %}
              </div>
            {% endcapture %}
            {% if grid_url != blank %}
              <a class="co-editorial-grid__link" href="{{ grid_url }}"{% if grid_title != blank %} aria-label="{{ grid_title | escape }}"{% endif %}>{{ grid_content }}</a>
            {% else %}
              {{ grid_content }}
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <p>{{ 'sections.editorial_grid.empty' | t }}</p>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.editorial_grid.name",
  "tag": "section",
  "class": "co-section-editorial-grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.shared.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.shared.settings.heading.label",
      "default": "Editorial grid"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.shared.settings.description.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.shared.settings.heading_size.label",
      "default": "standard",
      "options": [
        {
          "value": "small",
          "label": "t:sections.shared.options.small"
        },
        {
          "value": "standard",
          "label": "t:sections.shared.options.standard"
        },
        {
          "value": "large",
          "label": "t:sections.shared.options.large"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.shared.settings.text_alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.shared.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.shared.options.center"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "t:sections.shared.settings.desktop_columns.label",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "t:sections.shared.options.two"
        },
        {
          "value": "3",
          "label": "t:sections.editorial_grid.settings.desktop_columns.options.three"
        },
        {
          "value": "4",
          "label": "t:sections.editorial_grid.settings.desktop_columns.options.four"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:sections.editorial_grid.settings.media_ratio.label",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "t:sections.shared.options.square"
        },
        {
          "value": "portrait",
          "label": "t:sections.shared.options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:sections.shared.options.landscape"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "featured_first_card",
      "label": "t:sections.editorial_grid.settings.featured_first_card.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "t:sections.editorial_grid.settings.show_borders.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.shared.settings.desktop_top_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.shared.settings.desktop_bottom_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:sections.shared.settings.mobile_top_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:sections.shared.settings.mobile_bottom_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "t:sections.editorial_grid.blocks.story_name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.shared.settings.image.label"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.shared.settings.eyebrow.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.shared.settings.heading.label",
          "default": "Editorial story"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "t:sections.editorial_grid.settings.story_excerpt.label"
        },
        {
          "type": "article",
          "id": "article",
          "label": "t:sections.editorial_grid.settings.story_article.label"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.editorial_grid.settings.story_page.label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.shared.settings.collection.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.shared.settings.link.label"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:sections.editorial_grid.preset",
      "blocks": [
        {
          "type": "story"
        },
        {
          "type": "story"
        },
        {
          "type": "story"
        }
      ]
    }
  ]
}
{% endschema %}
