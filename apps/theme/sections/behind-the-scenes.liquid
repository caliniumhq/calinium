{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% liquid
  assign scenes_heading_id = 'BehindTheScenesHeading-' | append: section.id
  assign scenes_classes = 'co-behind-the-scenes co-brand-story-section co-color-scheme-' | append: section.settings.color_scheme
  assign scenes_classes = scenes_classes | append: ' co-behind-the-scenes--' | append: section.settings.layout
%}
{% render 'section-spacing', section: section %}
<section class="{{ scenes_classes }}" style="--co-gallery-desktop-columns: {{ section.settings.columns_desktop }};"{% if section.settings.heading != blank %} aria-labelledby="{{ scenes_heading_id }}"{% endif %}{% if section.settings.layout == 'scroll' %} data-co-section-behavior data-co-carousel{% endif %} {{ section.shopify_attributes }}><div class="co-page-width">{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.text, id: scenes_heading_id, level: 'h2', alignment: section.settings.text_alignment, size: section.settings.heading_size, class: 'co-brand-story-section__header' %}{% if section.settings.quote != blank %}<blockquote class="co-brand-story-section__quote">{{ section.settings.quote | escape }}</blockquote>{% endif %}{% if section.blocks.size > 0 %}<div class="co-behind-the-scenes__track"{% if section.settings.layout == 'scroll' %} data-carousel-track{% endif %}>{% for block in section.blocks %}<article class="co-behind-the-scenes__item"{% if section.settings.layout == 'scroll' %} data-carousel-slide{% endif %} {{ block.shopify_attributes }}><figure class="co-behind-the-scenes__figure">{% if block.settings.video != blank %}{{ block.settings.video | video_tag: controls: true, muted: true, preload: 'metadata', class: 'co-behind-the-scenes__video' }}{% elsif block.settings.image != blank %}<div class="co-behind-the-scenes__media">{% render 'responsive-image', image: block.settings.image, mobile_image: block.settings.mobile_image, loading: 'lazy', sizes: '(min-width: 48rem) 32vw, 50vw', widths: '240, 360, 535, 750, 1000, 1500', ratio: section.settings.image_ratio, class: 'co-behind-the-scenes__image' %}</div>{% elsif request.design_mode %}<div class="co-brand-story-section__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>{% endif %}{% if block.settings.caption != blank or block.settings.location != blank or block.settings.date != blank %}<figcaption class="co-behind-the-scenes__caption">{% if block.settings.caption != blank %}<span>{{ block.settings.caption | escape }}</span>{% endif %}{% if block.settings.location != blank or block.settings.date != blank %}<span class="co-behind-the-scenes__meta">{% if block.settings.location != blank %}<span>{{ block.settings.location | escape }}</span>{% endif %}{% if block.settings.date != blank %}<time>{{ block.settings.date | escape }}</time>{% endif %}</span>{% endif %}</figcaption>{% endif %}</figure></article>{% endfor %}</div>{% if section.settings.layout == 'scroll' and section.blocks.size > 1 %}<div class="co-behind-the-scenes__controls" aria-label="{{ 'sections.behind_the_scenes.controls_label' | t | escape }}"><button class="co-button co-button--secondary co-button--medium" type="button" data-action="carousel-prev" aria-label="{{ 'sections.behind_the_scenes.previous' | t | escape }}">{% render 'icon', icon: 'arrow-left', size: 18, decorative: true %}</button><button class="co-button co-button--secondary co-button--medium" type="button" data-action="carousel-next" aria-label="{{ 'sections.behind_the_scenes.next' | t | escape }}">{% render 'icon', icon: 'arrow-right', size: 18, decorative: true %}</button></div>{% endif %}{% elsif request.design_mode %}<p class="co-brand-story-section__empty">{{ 'sections.behind_the_scenes.empty' | t }}</p>{% endif %}</div></section>
{% schema %}
{"name":"t:sections.behind_the_scenes.name","tag":"section","class":"co-section-behind-the-scenes","settings":[{"type":"text","id":"eyebrow","label":"t:sections.shared.settings.eyebrow.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label","default":"Behind the scenes"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"},{"type":"textarea","id":"quote","label":"t:sections.shared.settings.quote.label"},{"type":"select","id":"heading_size","label":"t:sections.shared.settings.heading_size.label","default":"standard","options":[{"value":"small","label":"t:sections.shared.options.small"},{"value":"standard","label":"t:sections.shared.options.standard"},{"value":"large","label":"t:sections.shared.options.large"}]},{"type":"select","id":"text_alignment","label":"t:sections.shared.settings.text_alignment.label","default":"left","options":[{"value":"left","label":"t:sections.shared.options.left"},{"value":"center","label":"t:sections.shared.options.center"}]},{"type":"select","id":"layout","label":"t:sections.shared.settings.layout.label","default":"grid","options":[{"value":"grid","label":"t:sections.shared.options.grid"},{"value":"editorial","label":"t:sections.shared.options.editorial"},{"value":"scroll","label":"t:sections.behind_the_scenes.settings.layout.options.scroll"}]},{"type":"select","id":"columns_desktop","label":"t:sections.behind_the_scenes.settings.columns_desktop.label","default":"3","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}]},{"type":"select","id":"image_ratio","label":"t:sections.shared.settings.image_ratio.label","default":"landscape","options":[{"value":"square","label":"t:sections.shared.options.square"},{"value":"portrait","label":"t:sections.shared.options.portrait"},{"value":"landscape","label":"t:sections.shared.options.landscape"}]},{"type":"color_scheme","id":"color_scheme","label":"t:sections.shared.settings.color_scheme.label","default":"scheme-1"},{"type":"range","id":"padding_top","label":"t:sections.shared.settings.desktop_top_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"t:sections.shared.settings.desktop_bottom_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"mobile_padding_top","label":"t:sections.shared.settings.mobile_top_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_padding_bottom","label":"t:sections.shared.settings.mobile_bottom_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48}],"blocks":[{"type":"gallery_item","name":"t:sections.behind_the_scenes.blocks.gallery_item","settings":[{"type":"image_picker","id":"image","label":"t:sections.shared.settings.image.label"},{"type":"image_picker","id":"mobile_image","label":"t:sections.shared.settings.mobile_image.label","info":"t:sections.shared.settings.mobile_image.info"},{"type":"video","id":"video","label":"t:sections.shared.settings.hosted_video.label"},{"type":"text","id":"caption","label":"t:sections.shared.settings.caption.label"},{"type":"text","id":"location","label":"t:sections.behind_the_scenes.settings.location.label"},{"type":"text","id":"date","label":"t:sections.behind_the_scenes.settings.date.label"}]}],"max_blocks":12,"presets":[{"name":"t:sections.behind_the_scenes.preset","blocks":[{"type":"gallery_item"},{"type":"gallery_item"}]}]}
{% endschema %}
