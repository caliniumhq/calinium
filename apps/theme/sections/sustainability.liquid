{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% liquid
  assign sustainability_heading_id = 'SustainabilityHeading-' | append: section.id
  assign sustainability_classes = 'co-sustainability co-brand-story-section co-color-scheme-' | append: section.settings.color_scheme
  assign initiative_blocks = section.blocks | where: 'type', 'initiative'
  assign metric_blocks = section.blocks | where: 'type', 'metric'
  assign certification_blocks = section.blocks | where: 'type', 'certification'
%}
{% render 'section-spacing', section: section %}
<section class="{{ sustainability_classes }}"{% if section.settings.heading != blank %} aria-labelledby="{{ sustainability_heading_id }}"{% endif %} {{ section.shopify_attributes }}><div class="co-page-width"><div class="co-sustainability__layout"><div class="co-brand-story-section__content">{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.text, id: sustainability_heading_id, level: 'h2', alignment: section.settings.text_alignment, size: section.settings.heading_size %}{% if section.settings.verification_note != blank %}<p class="co-brand-story-section__note">{{ section.settings.verification_note | escape }}</p>{% endif %}{% if section.settings.button_label != blank and section.settings.button_link != blank %}<div class="co-brand-story-section__actions">{% render 'button', label: section.settings.button_label, url: section.settings.button_link, variant: 'secondary' %}</div>{% endif %}</div>{% if initiative_blocks.size > 0 %}<div class="co-sustainability__initiatives" role="list">{% for block in initiative_blocks %}<div class="co-sustainability__initiative" role="listitem" {{ block.shopify_attributes }}>{% render 'feature-item', icon: block.settings.initiative_icon, image: block.settings.image, heading: block.settings.heading, text: block.settings.text, image_loading: 'lazy', image_sizes: '240px', image_widths: '165, 240, 360, 535', image_ratio: 'landscape' %}{% if block.settings.certification_reference != blank %}<p class="co-brand-story-section__note">{{ block.settings.certification_reference | escape }}</p>{% endif %}</div>{% endfor %}</div>{% endif %}</div>{% if metric_blocks.size > 0 %}<div class="co-sustainability__metrics">{% for block in metric_blocks %}<div {{ block.shopify_attributes }}>{% render 'statistic', value: block.settings.value, label: block.settings.label, description: block.settings.description, icon: block.settings.metric_icon, class: 'co-sustainability__metric' %}</div>{% endfor %}</div>{% endif %}{% if certification_blocks.size > 0 %}<div class="co-sustainability__certifications">{% for block in certification_blocks %}<article class="co-sustainability__certification" {{ block.shopify_attributes }}>{% render 'logo-item', image: block.settings.logo, company_name: block.settings.issuer, loading: 'lazy', image_sizes: '180px', image_widths: '96, 144, 180, 240' %}{% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}{% if block.settings.text != blank %}{% render 'rich-text', content: block.settings.text %}{% endif %}</article>{% endfor %}</div>{% endif %}{% if section.blocks.size == 0 and request.design_mode %}<p class="co-brand-story-section__empty">{{ 'sections.sustainability.empty' | t }}</p>{% endif %}</div></section>
{% schema %}
{"name":"t:sections.sustainability.name","tag":"section","class":"co-section-sustainability","settings":[{"type":"text","id":"eyebrow","label":"t:sections.shared.settings.eyebrow.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label","default":"Our commitments"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"},{"type":"textarea","id":"verification_note","label":"t:sections.sustainability.settings.verification_note.label","info":"t:sections.sustainability.settings.verification_note.info"},{"type":"text","id":"button_label","label":"t:sections.shared.settings.button_label.label"},{"type":"url","id":"button_link","label":"t:sections.shared.settings.button_link.label"},{"type":"select","id":"heading_size","label":"t:sections.shared.settings.heading_size.label","default":"large","options":[{"value":"small","label":"t:sections.shared.options.small"},{"value":"standard","label":"t:sections.shared.options.standard"},{"value":"large","label":"t:sections.shared.options.large"}]},{"type":"select","id":"text_alignment","label":"t:sections.shared.settings.text_alignment.label","default":"left","options":[{"value":"left","label":"t:sections.shared.options.left"},{"value":"center","label":"t:sections.shared.options.center"}]},{"type":"color_scheme","id":"color_scheme","label":"t:sections.shared.settings.color_scheme.label","default":"scheme-1"},{"type":"range","id":"padding_top","label":"t:sections.shared.settings.desktop_top_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"t:sections.shared.settings.desktop_bottom_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"mobile_padding_top","label":"t:sections.shared.settings.mobile_top_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_padding_bottom","label":"t:sections.shared.settings.mobile_bottom_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48}],"blocks":[{"type":"initiative","name":"t:sections.sustainability.blocks.initiative","limit":8,"settings":[{"type":"select","id":"initiative_icon","label":"t:sections.shared.settings.icon.label","default":"leaf","options":[{"value":"leaf","label":"t:sections.shared.options.leaf"},{"value":"recycle","label":"t:sections.shared.options.recycle"},{"value":"globe","label":"t:sections.shared.options.globe"},{"value":"heart","label":"t:sections.shared.options.heart"}]},{"type":"image_picker","id":"image","label":"t:sections.shared.settings.image.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"},{"type":"text","id":"certification_reference","label":"t:sections.sustainability.settings.certification_reference.label"}]},{"type":"metric","name":"t:sections.sustainability.blocks.metric","limit":4,"settings":[{"type":"text","id":"value","label":"t:sections.sustainability.settings.metric_value.label"},{"type":"text","id":"label","label":"t:sections.sustainability.settings.metric_label.label"},{"type":"textarea","id":"description","label":"t:sections.shared.settings.description.label"},{"type":"select","id":"metric_icon","label":"t:sections.shared.settings.icon.label","default":"leaf","options":[{"value":"leaf","label":"t:sections.shared.options.leaf"},{"value":"recycle","label":"t:sections.shared.options.recycle"},{"value":"globe","label":"t:sections.shared.options.globe"}]}]},{"type":"certification","name":"t:sections.sustainability.blocks.certification","limit":4,"settings":[{"type":"image_picker","id":"logo","label":"t:sections.shared.settings.logo.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label"},{"type":"text","id":"issuer","label":"t:sections.sustainability.settings.issuer.label"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"}]}],"max_blocks":12,"presets":[{"name":"t:sections.sustainability.preset","blocks":[{"type":"initiative"},{"type":"initiative"}]}]}
{% endschema %}
