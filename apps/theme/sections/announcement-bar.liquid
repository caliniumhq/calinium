{% liquid
  assign has_legacy_message = false
  assign message_count = 0
  assign announcement_classes = 'co-announcement-bar co-color-scheme-' | append: section.settings.color_scheme

  if section.settings.text != blank
    assign has_legacy_message = true
  endif

  for block in section.blocks
    if block.settings.text != blank
      assign message_count = message_count | plus: 1
    endif
  endfor

  if message_count == 0 and has_legacy_message
    assign message_count = 1
  endif

  if section.settings.desktop_visibility == 'hide'
    assign announcement_classes = announcement_classes | append: ' co-announcement-bar--desktop-hidden'
  endif

  if section.settings.mobile_visibility == 'hide'
    assign announcement_classes = announcement_classes | append: ' co-announcement-bar--mobile-hidden'
  endif

  if section.settings.alignment == 'left'
    assign announcement_classes = announcement_classes | append: ' co-announcement-bar--align-left'
  elsif section.settings.alignment == 'right'
    assign announcement_classes = announcement_classes | append: ' co-announcement-bar--align-right'
  endif
%}

{% if section.settings.show and message_count > 0 %}
  {{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}
  {% if message_count > 1 and section.settings.enable_rotation %}
    <script src="{{ 'announcement-bar.js' | asset_url }}" type="module"></script>
  {% endif %}

  <aside
    class="{{ announcement_classes }}"
    aria-label="{{ 'announcement_bar.label' | t }}"
    data-announcement-alignment="{{ section.settings.alignment }}"
    {% if message_count > 1 and section.settings.enable_rotation %}
      data-announcement-bar
      data-announcement-interval="{{ section.settings.rotation_interval | times: 1000 }}"
    {% endif %}
  >
    <div class="co-announcement-bar__inner{% if section.settings.width == 'contained' %} co-page-width{% endif %}">
      <div class="co-announcement-bar__messages"{% if message_count > 1 and section.settings.enable_rotation %} aria-live="polite"{% endif %}>
        {% if message_count > 0 %}
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              <div class="co-announcement-bar__message" data-announcement-message {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a class="co-announcement-bar__link" href="{{ block.settings.link | escape }}">{{ block.settings.text | escape }}</a>
                {% else %}
                  <p class="co-announcement-bar__text">{{ block.settings.text | escape }}</p>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {% elsif has_legacy_message %}
          <div class="co-announcement-bar__message" data-announcement-message>
            {% if section.settings.link != blank %}
              <a class="co-announcement-bar__link" href="{{ section.settings.link | escape }}">{{ section.settings.text | escape }}</a>
            {% else %}
              <p class="co-announcement-bar__text">{{ section.settings.text | escape }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </aside>
{% endif %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "section",
  "class": "co-section-announcement-bar",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "checkbox", "id": "show", "label": "t:sections.announcement_bar.settings.show.label", "default": true },
    { "type": "text", "id": "text", "label": "t:sections.announcement_bar.settings.text.label", "info": "t:sections.announcement_bar.settings.text.info" },
    { "type": "url", "id": "link", "label": "t:sections.announcement_bar.settings.link.label", "info": "t:sections.announcement_bar.settings.link.info" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.announcement_bar.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "select", "id": "width", "label": "t:sections.announcement_bar.settings.width.label", "default": "full", "options": [
      { "value": "contained", "label": "t:sections.announcement_bar.settings.width.options.contained" },
      { "value": "full", "label": "t:sections.announcement_bar.settings.width.options.full" }
    ] },
    { "type": "select", "id": "alignment", "label": "t:sections.announcement_bar.settings.alignment.label", "default": "center", "options": [
      { "value": "left", "label": "t:sections.announcement_bar.settings.alignment.options.left" },
      { "value": "center", "label": "t:sections.announcement_bar.settings.alignment.options.center" },
      { "value": "right", "label": "t:sections.announcement_bar.settings.alignment.options.right" }
    ] },
    { "type": "select", "id": "desktop_visibility", "label": "t:sections.announcement_bar.settings.desktop_visibility.label", "default": "show", "options": [
      { "value": "show", "label": "t:sections.announcement_bar.settings.visibility.options.show" },
      { "value": "hide", "label": "t:sections.announcement_bar.settings.visibility.options.hide" }
    ] },
    { "type": "select", "id": "mobile_visibility", "label": "t:sections.announcement_bar.settings.mobile_visibility.label", "default": "show", "options": [
      { "value": "show", "label": "t:sections.announcement_bar.settings.visibility.options.show" },
      { "value": "hide", "label": "t:sections.announcement_bar.settings.visibility.options.hide" }
    ] },
    { "type": "checkbox", "id": "enable_rotation", "label": "t:sections.announcement_bar.settings.enable_rotation.label", "info": "t:sections.announcement_bar.settings.enable_rotation.info", "default": false },
    { "type": "range", "id": "rotation_interval", "label": "t:sections.announcement_bar.settings.rotation_interval.label", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement_bar.blocks.announcement.name",
      "settings": [
        { "type": "text", "id": "text", "label": "t:sections.announcement_bar.blocks.announcement.settings.text.label", "default": "Free shipping on orders over $100" },
        { "type": "url", "id": "link", "label": "t:sections.announcement_bar.blocks.announcement.settings.link.label" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "t:sections.announcement_bar.presets.default", "blocks": [{ "type": "announcement" }] }]
}
{% endschema %}
