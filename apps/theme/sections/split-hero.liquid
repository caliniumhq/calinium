{% liquid
  assign split_use_video = false
  assign split_heading_id = 'SplitHeroHeading-' | append: section.id
  assign split_classes = 'co-split-hero co-editorial-pack-section co-color-scheme-' | append: section.settings.color_scheme
  assign split_classes = split_classes | append: ' co-split-hero--media-' | append: section.settings.media_position
  assign split_classes = split_classes | append: ' co-split-hero--ratio-' | append: section.settings.desktop_ratio
  assign split_classes = split_classes | append: ' co-split-hero--content-' | append: section.settings.content_position
  assign split_classes = split_classes | append: ' co-split-hero--align-' | append: section.settings.text_alignment
  assign split_classes = split_classes | append: ' co-split-hero--height-' | append: section.settings.section_height
  assign split_has_actions = false

  if section.settings.media_type == 'video' and section.settings.video != blank
    assign split_use_video = true
  endif
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign split_has_actions = true
  endif
  if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank
    assign split_has_actions = true
  endif
%}

{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}

<section class="{{ split_classes }}" {% if section.settings.heading != blank %}aria-labelledby="{{ split_heading_id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="co-split-hero__media">
    {% if split_use_video %}
      {{ section.settings.video | video_tag: controls: true, muted: true, preload: 'metadata', class: 'co-split-hero__video' }}
    {% elsif section.settings.image != blank %}
      {% render 'responsive-image', image: section.settings.image, mobile_image: section.settings.mobile_image, loading: 'lazy', sizes: '(min-width: 48rem) 60vw, 100vw', widths: '375, 550, 750, 1000, 1500, 2000', ratio: section.settings.media_ratio, class: 'co-split-hero__image' %}
    {% elsif request.design_mode %}
      <div class="co-editorial-pack-section__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
    {% endif %}
  </div>
  <div class="co-split-hero__content">
    <div class="co-split-hero__content-inner co-editorial-pack-section__content">
      {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, id: split_heading_id, level: 'h2', alignment: section.settings.text_alignment, size: section.settings.heading_size %}
      {% if section.settings.text != blank %}{% render 'rich-text', content: section.settings.text, alignment: section.settings.text_alignment, class: 'co-editorial-pack-section__text' %}{% endif %}
      {% if split_has_actions %}
        <div class="co-editorial-pack-section__actions">
          {% if section.settings.button_label != blank and section.settings.button_link != blank %}{% render 'button', label: section.settings.button_label, url: section.settings.button_link, variant: 'primary' %}{% endif %}
          {% if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank %}{% render 'button', label: section.settings.secondary_button_label, url: section.settings.secondary_button_link, variant: 'secondary' %}{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.split_hero.name",
  "tag": "section",
  "class": "co-section-split-hero",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "t:sections.split_hero.settings.media_type.label",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "t:sections.split_hero.settings.media_type.options.image"
        },
        {
          "value": "video",
          "label": "t:sections.split_hero.settings.media_type.options.video"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.shared.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.shared.settings.mobile_image.label"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.shared.settings.hosted_video.label"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:sections.shared.settings.media_position.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.shared.options.left"
        },
        {
          "value": "right",
          "label": "t:sections.shared.options.right"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_ratio",
      "label": "t:sections.split_hero.settings.desktop_ratio.label",
      "default": "50-50",
      "options": [
        {
          "value": "40-60",
          "label": "t:sections.split_hero.settings.desktop_ratio.options.40_60"
        },
        {
          "value": "50-50",
          "label": "t:sections.split_hero.settings.desktop_ratio.options.50_50"
        },
        {
          "value": "60-40",
          "label": "t:sections.split_hero.settings.desktop_ratio.options.60_40"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:sections.split_hero.settings.media_ratio.label",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "t:sections.shared.options.square"
        },
        {
          "value": "portrait",
          "label": "t:sections.shared.options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:sections.shared.options.landscape"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.shared.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.shared.settings.heading.label",
      "default": "A considered approach"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.shared.settings.text.label",
      "default": "<p>Pair a strong visual with a clear editorial point of view.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.shared.settings.button_label.label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.shared.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:sections.split_hero.settings.secondary_button_label.label"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "t:sections.split_hero.settings.secondary_button_link.label"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.shared.settings.text_alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.shared.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.shared.options.center"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.split_hero.settings.content_position.label",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "t:sections.split_hero.settings.content_position.options.top"
        },
        {
          "value": "center",
          "label": "t:sections.shared.options.center"
        },
        {
          "value": "bottom",
          "label": "t:sections.split_hero.settings.content_position.options.bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:sections.split_hero.settings.section_height.label",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "t:sections.shared.options.standard"
        },
        {
          "value": "full-screen",
          "label": "t:sections.split_hero.settings.section_height.options.full_screen"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.shared.settings.heading_size.label",
      "default": "standard",
      "options": [
        {
          "value": "small",
          "label": "t:sections.shared.options.small"
        },
        {
          "value": "standard",
          "label": "t:sections.shared.options.standard"
        },
        {
          "value": "large",
          "label": "t:sections.shared.options.large"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.split_hero.preset"
    }
  ]
}
{% endschema %}
