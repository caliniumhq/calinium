{{ 'component-image.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{% if section.settings.enable_quick_add %}
  {{ 'component-quantity-input.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
{% endif %}

{% liquid
  assign shop_look_heading_id = 'ShopTheLookHeading-' | append: section.id
  assign shop_look_classes = 'co-shop-the-look co-commerce-section co-color-scheme-' | append: section.settings.color_scheme
  assign shop_look_image = section.settings.image | default: section.settings.mobile_image
  assign shop_look_mobile_image = section.settings.mobile_image
  if section.settings.image == blank and section.settings.mobile_image != blank
    assign shop_look_mobile_image = blank
  endif
%}

{% render 'section-spacing', section: section %}

<section class="{{ shop_look_classes }}" {% if section.settings.heading != blank %}aria-labelledby="{{ shop_look_heading_id }}"{% endif %} data-co-section-behavior data-shop-the-look {{ section.shopify_attributes }}>
  <div class="co-page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.description, id: shop_look_heading_id, alignment: section.settings.text_alignment, size: section.settings.heading_size, class: 'co-commerce-section__header' %}
    <div class="co-shop-the-look__layout">
      <div class="co-shop-the-look__media">
        {% if shop_look_image != blank %}
          {% render 'responsive-image', image: shop_look_image, mobile_image: shop_look_mobile_image, loading: 'lazy', sizes: '(min-width: 48rem) 70vw, 100vw', widths: '375, 550, 750, 1000, 1500, 2000', ratio: section.settings.image_ratio, class: 'co-shop-the-look__image' %}
        {% elsif request.design_mode %}
          <div class="co-commerce-section__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
        {% endif %}
        {% if section.blocks.size > 0 %}
          <div class="co-shop-the-look__markers" aria-label="{{ 'sections.shop_the_look.markers_label' | t | escape }}">
            {% for block in section.blocks %}
              {% if block.settings.product != blank %}
                {% assign marker_label = 'sections.shop_the_look.marker_label' | t: number: forloop.index, product: block.settings.product.title %}
                <button class="co-shop-the-look__marker" type="button" data-look-marker="{{ forloop.index }}" aria-label="{{ marker_label | escape }}" aria-pressed="false" style="--co-marker-x: {{ block.settings.x_position }}%; --co-marker-y: {{ block.settings.y_position }}%;">{{ forloop.index }}</button>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
      <div class="co-shop-the-look__products" aria-label="{{ 'sections.shop_the_look.products_label' | t | escape }}">
        {% for block in section.blocks %}
          <div class="co-shop-the-look__product" data-look-product="{{ forloop.index }}" {{ block.shopify_attributes }}>
            {% if block.settings.product != blank %}
              {% render 'product-card', product: block.settings.product, section_id: section.id, image_ratio: 'square', image_loading: 'lazy', image_sizes: '(min-width: 48rem) 28vw, 100vw', image_widths: '165, 360, 535, 750, 1000', show_vendor: section.settings.show_vendor, show_rating: false, show_compare_at_price: true, show_sale_badge: true, show_sold_out_badge: true, show_secondary_image: false, show_inventory: false, show_quick_add: section.settings.enable_quick_add, card_alignment: 'left' %}
            {% elsif request.design_mode %}
              <p class="co-commerce-section__empty">{{ 'sections.shop_the_look.select_product' | t }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.shop_the_look.name",
  "tag": "section",
  "class": "co-section-shop-the-look",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.shared.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.shared.settings.mobile_image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.shared.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.shared.settings.heading.label",
      "default": "Shop the look"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.shared.settings.description.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.shared.settings.heading_size.label",
      "default": "standard",
      "options": [
        {
          "value": "small",
          "label": "t:sections.shared.options.small"
        },
        {
          "value": "standard",
          "label": "t:sections.shared.options.standard"
        },
        {
          "value": "large",
          "label": "t:sections.shared.options.large"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.shared.settings.text_alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.shared.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.shared.options.center"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.shared.settings.image_ratio.label",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "t:sections.shared.options.square"
        },
        {
          "value": "portrait",
          "label": "t:sections.shared.options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:sections.shared.options.landscape"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.shared.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "t:sections.shared.settings.enable_quick_add.label",
      "info": "t:sections.shared.settings.enable_quick_add.info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.shared.settings.desktop_top_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.shared.settings.desktop_bottom_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:sections.shared.settings.mobile_top_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:sections.shared.settings.mobile_bottom_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.shop_the_look.blocks.product_name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.shared.settings.product.label"
        },
        {
          "type": "range",
          "id": "x_position",
          "label": "t:sections.shop_the_look.settings.x_position.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y_position",
          "label": "t:sections.shop_the_look.settings.y_position.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.shop_the_look.preset",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
