{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% liquid
  assign team_heading_id = 'TeamHeading-' | append: section.id
  assign team_classes = 'co-team co-brand-story-section co-color-scheme-' | append: section.settings.color_scheme
%}
{% render 'section-spacing', section: section %}
<section class="{{ team_classes }}" style="--co-team-desktop-columns: {{ section.settings.columns_desktop }}; --co-team-mobile-columns: {{ section.settings.columns_mobile }};"{% if section.settings.heading != blank %} aria-labelledby="{{ team_heading_id }}"{% endif %} {{ section.shopify_attributes }}><div class="co-page-width">{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.text, id: team_heading_id, level: 'h2', alignment: section.settings.text_alignment, size: section.settings.heading_size, class: 'co-brand-story-section__header' %}{% if section.blocks.size > 0 %}<div class="co-team__grid" role="list">{% for block in section.blocks %}<article class="co-team__member" role="listitem" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="co-team__portrait">{% render 'responsive-image', image: block.settings.image, loading: 'lazy', sizes: '(min-width: 48rem) 25vw, 50vw', widths: '165, 240, 360, 535, 750', ratio: section.settings.image_ratio, class: 'co-team__image' %}</div>{% elsif request.design_mode %}<div class="co-brand-story-section__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div class="co-team__details">{% if block.settings.name != blank %}<h3 class="co-team__name">{{ block.settings.name | escape }}</h3>{% endif %}{% if block.settings.role != blank %}<p class="co-team__role">{{ block.settings.role | escape }}</p>{% endif %}{% if block.settings.bio != blank %}<div class="co-team__bio">{{ block.settings.bio }}</div>{% endif %}{% if block.settings.email != blank or block.settings.link != blank %}<div class="co-team__links">{% if block.settings.email != blank %}<a href="mailto:{{ block.settings.email | escape }}">{{ 'sections.team.email' | t }}</a>{% endif %}{% if block.settings.link != blank and block.settings.link_label != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div>{% endif %}</div></article>{% endfor %}</div>{% elsif request.design_mode %}<p class="co-brand-story-section__empty">{{ 'sections.team.empty' | t }}</p>{% endif %}</div></section>
{% schema %}
{"name":"t:sections.team.name","tag":"section","class":"co-section-team","settings":[{"type":"text","id":"eyebrow","label":"t:sections.shared.settings.eyebrow.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label","default":"Meet the team"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"},{"type":"select","id":"heading_size","label":"t:sections.shared.settings.heading_size.label","default":"standard","options":[{"value":"small","label":"t:sections.shared.options.small"},{"value":"standard","label":"t:sections.shared.options.standard"},{"value":"large","label":"t:sections.shared.options.large"}]},{"type":"select","id":"text_alignment","label":"t:sections.shared.settings.text_alignment.label","default":"left","options":[{"value":"left","label":"t:sections.shared.options.left"},{"value":"center","label":"t:sections.shared.options.center"}]},{"type":"select","id":"columns_desktop","label":"t:sections.team.settings.columns_desktop.label","default":"4","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}]},{"type":"select","id":"columns_mobile","label":"t:sections.team.settings.columns_mobile.label","default":"2","options":[{"value":"1","label":"t:sections.shared.options.one"},{"value":"2","label":"t:sections.shared.options.two"}]},{"type":"select","id":"image_ratio","label":"t:sections.shared.settings.image_ratio.label","default":"portrait","options":[{"value":"square","label":"t:sections.shared.options.square"},{"value":"portrait","label":"t:sections.shared.options.portrait"},{"value":"landscape","label":"t:sections.shared.options.landscape"}]},{"type":"color_scheme","id":"color_scheme","label":"t:sections.shared.settings.color_scheme.label","default":"scheme-1"},{"type":"range","id":"padding_top","label":"t:sections.shared.settings.desktop_top_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"t:sections.shared.settings.desktop_bottom_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"mobile_padding_top","label":"t:sections.shared.settings.mobile_top_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_padding_bottom","label":"t:sections.shared.settings.mobile_bottom_spacing.label","min":0,"max":120,"step":4,"unit":"px","default":48}],"blocks":[{"type":"team_member","name":"t:sections.team.blocks.team_member","settings":[{"type":"image_picker","id":"image","label":"t:sections.team.settings.portrait.label"},{"type":"text","id":"name","label":"t:sections.team.settings.name.label"},{"type":"text","id":"role","label":"t:sections.shared.settings.role.label"},{"type":"richtext","id":"bio","label":"t:sections.team.settings.bio.label"},{"type":"text","id":"email","label":"t:sections.team.settings.email.label"},{"type":"url","id":"link","label":"t:sections.shared.settings.link.label"},{"type":"text","id":"link_label","label":"t:sections.shared.settings.link_label.label"}]}],"max_blocks":12,"presets":[{"name":"t:sections.team.preset","blocks":[{"type":"team_member"},{"type":"team_member"}]}]}
{% endschema %}
