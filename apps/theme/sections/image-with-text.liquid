{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{% liquid
  assign image_with_text_has_content = false
  assign image_with_text_has_actions = false
  assign image_with_text_use_blocks = false
  assign image_with_text_classes = 'co-image-with-text co-library-section co-color-scheme-' | append: section.settings.color_scheme
  assign image_with_text_classes = image_with_text_classes | append: ' co-image-with-text--image-' | append: section.settings.image_position
  assign image_with_text_classes = image_with_text_classes | append: ' co-image-with-text--mobile-' | append: section.settings.mobile_layout
  assign image_with_text_classes = image_with_text_classes | append: ' co-image-with-text--align-' | append: section.settings.content_alignment
  assign image_with_text_classes = image_with_text_classes | append: ' co-image-with-text--width-' | append: section.settings.image_width
  assign image_with_text_image = section.settings.image

  if image_with_text_image == blank
    assign image_with_text_image = section.settings.mobile_image
  endif

  if section.settings.overlap
    assign image_with_text_classes = image_with_text_classes | append: ' co-image-with-text--overlap'
  endif

  if section.blocks.size > 0
    assign image_with_text_use_blocks = true
    assign image_with_text_has_content = true
  elsif section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank
    assign image_with_text_has_content = true
  endif

  if section.settings.button_label_1 != blank and section.settings.button_link_1 != blank
    assign image_with_text_has_content = true
    assign image_with_text_has_actions = true
  endif

  if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank
    assign image_with_text_has_content = true
    assign image_with_text_has_actions = true
  endif

  if section.settings.image != blank or section.settings.mobile_image != blank
    assign image_with_text_classes = image_with_text_classes | append: ' co-image-with-text--has-image'
  endif

  if image_with_text_has_content
    assign image_with_text_classes = image_with_text_classes | append: ' co-image-with-text--has-content'
  endif
%}

{% render 'section-spacing', section: section %}

<section class="{{ image_with_text_classes }}" {{ section.shopify_attributes }}>
  <div class="co-image-with-text__inner co-page-width">
    {% capture image_with_text_media %}
      <div class="co-image-with-text__media">
        {% if section.settings.image != blank or section.settings.mobile_image != blank %}
          {% render 'responsive-image', image: image_with_text_image, mobile_image: section.settings.mobile_image, loading: 'lazy', sizes: '(min-width: 48rem) 50vw, 100vw', widths: '375, 550, 750, 1000, 1500', ratio: section.settings.image_ratio, class: 'co-image-with-text__image' %}
        {% else %}
          <div class="co-image-with-text__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </div>
    {% endcapture %}

    {% capture image_with_text_content %}
      {% if image_with_text_has_content %}
        <div class="co-image-with-text__content">
          {% if image_with_text_use_blocks %}
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'eyebrow' %}
                  {% if block.settings.text != blank %}<p class="co-image-with-text__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>{% endif %}
                {% when 'heading' %}
                  {% if block.settings.heading != blank %}<h2 class="co-image-with-text__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>{% endif %}
                {% when 'text' %}
                  {% if block.settings.text != blank %}<div class="co-image-with-text__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{% endif %}
                {% when 'button' %}
                  {% if block.settings.label != blank and block.settings.link != blank %}<div class="co-image-with-text__actions" {{ block.shopify_attributes }}>{% render 'button', label: block.settings.label, url: block.settings.link, variant: block.settings.style %}</div>{% endif %}
                {% when 'icon_text' %}
                  {% if block.settings.text != blank %}<p class="co-image-with-text__icon-text" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon, size: 20 %}<span>{{ block.settings.text | escape }}</span></p>{% endif %}
              {% endcase %}
            {% endfor %}
          {% else %}
            {% if section.settings.eyebrow != blank %}<p class="co-image-with-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
            {% if section.settings.heading != blank %}
              {% if section.settings.heading_tag == 'h3' %}<h3 class="co-image-with-text__heading">{{ section.settings.heading }}</h3>{% else %}<h2 class="co-image-with-text__heading">{{ section.settings.heading }}</h2>{% endif %}
            {% endif %}
            {% if section.settings.text != blank %}<div class="co-image-with-text__text">{{ section.settings.text }}</div>{% endif %}
            {% if image_with_text_has_actions %}
              <div class="co-image-with-text__actions">
                {% if section.settings.button_label_1 != blank and section.settings.button_link_1 != blank %}{% render 'button', label: section.settings.button_label_1, url: section.settings.button_link_1, variant: 'primary' %}{% endif %}
                {% if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank %}{% render 'button', label: section.settings.button_label_2, url: section.settings.button_link_2, variant: 'secondary' %}{% endif %}
              </div>
            {% endif %}
          {% endif %}
        </div>
      {% endif %}
    {% endcapture %}

    {% if section.settings.mobile_layout == 'content-first' %}
      {{ image_with_text_content }}{{ image_with_text_media }}
    {% else %}
      {{ image_with_text_media }}{{ image_with_text_content }}
    {% endif %}
  </div>
</section>

