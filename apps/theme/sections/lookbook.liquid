{% liquid
  assign lookbook_classes = 'co-lookbook co-library-section co-editorial-pack-section co-color-scheme-' | append: section.settings.color_scheme
  assign lookbook_classes = lookbook_classes | append: ' co-lookbook--align-' | append: section.settings.text_alignment
  assign lookbook_heading_id = 'LookbookHeading-' | append: section.id
%}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% render 'section-spacing', section: section %}
<section class="{{ lookbook_classes }}" {% if section.settings.heading != blank %}aria-labelledby="{{ lookbook_heading_id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="co-page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.description, id: lookbook_heading_id, alignment: section.settings.text_alignment, size: section.settings.heading_size %}
    {% if section.blocks.size > 0 %}
      <div class="co-lookbook__grid co-lookbook__grid--{{ section.settings.layout }}" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign lookbook_image = block.settings.image
            assign lookbook_url = block.settings.link
            if lookbook_url == blank and block.settings.product != blank
              assign lookbook_url = block.settings.product.url
            endif
            if lookbook_url == blank and block.settings.collection != blank
              assign lookbook_url = block.settings.collection.url
            endif
          %}
          <article class="co-lookbook__item" role="listitem" {{ block.shopify_attributes }}>
            {% capture lookbook_content %}
              {% if lookbook_image != blank %}{% render 'responsive-image', image: lookbook_image, mobile_image: block.settings.mobile_image, loading: 'lazy', sizes: '(min-width: 48rem) 34vw, 50vw', widths: '240, 360, 535, 750, 1000, 1500', ratio: block.settings.media_ratio, class: 'co-lookbook__media' %}{% elsif request.design_mode %}<div class="co-editorial-pack-section__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>{% endif %}
              {% if block.settings.title != blank or block.settings.text != blank %}<div class="co-lookbook__caption">{% if section.settings.show_numbers %}<span class="co-lookbook__number">{{ forloop.index | prepend: '0' }}</span>{% endif %}<div>{% if block.settings.title != blank %}<h3 class="co-lookbook__title">{{ block.settings.title }}</h3>{% endif %}{% if block.settings.text != blank %}<p class="co-lookbook__text">{{ block.settings.text | escape }}</p>{% endif %}</div></div>{% endif %}
            {% endcapture %}
            {% if lookbook_url != blank %}<a class="co-lookbook__link" href="{{ lookbook_url | escape }}"{% if block.settings.title != blank %} aria-label="{{ block.settings.title | escape }}"{% endif %}>{{ lookbook_content }}</a>{% else %}{{ lookbook_content }}{% endif %}
          </article>
        {% endfor %}
      </div>
    {% elsif request.design_mode %}<p>{{ 'sections.lookbook.empty' | t }}</p>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.lookbook.name",
  "tag": "section",
  "class": "co-section-lookbook",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.shared.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.shared.settings.heading.label",
      "default": "Editorial story"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.shared.settings.description.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.shared.settings.heading_size.label",
      "default": "standard",
      "options": [
        {
          "value": "small",
          "label": "t:sections.shared.options.small"
        },
        {
          "value": "standard",
          "label": "t:sections.shared.options.standard"
        },
        {
          "value": "large",
          "label": "t:sections.shared.options.large"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.shared.settings.text_alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.shared.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.shared.options.center"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.shared.settings.layout.label",
      "default": "editorial",
      "options": [
        {
          "value": "editorial",
          "label": "t:sections.shared.options.editorial"
        },
        {
          "value": "feature-first",
          "label": "t:sections.lookbook.settings.layout.options.feature_first"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "t:sections.lookbook.settings.show_numbers.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.shared.settings.desktop_top_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.shared.settings.desktop_bottom_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:sections.shared.settings.mobile_top_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:sections.shared.settings.mobile_bottom_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.lookbook.blocks.item_name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.shared.settings.image.label"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:sections.shared.settings.mobile_image.label"
        },
        {
          "type": "select",
          "id": "media_ratio",
          "label": "t:sections.shared.settings.image_ratio.label",
          "default": "portrait",
          "options": [
            {
              "value": "portrait",
              "label": "t:sections.shared.options.portrait"
            },
            {
              "value": "landscape",
              "label": "t:sections.shared.options.landscape"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.shared.settings.heading.label",
          "default": "Editorial detail"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.shared.settings.text.label"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.shared.settings.product.label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.shared.settings.collection.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.shared.settings.link.label"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.lookbook.preset",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
