{{ 'component-image.css' | asset_url | stylesheet_tag }}

{% liquid
  assign social_gallery_classes = 'co-social-gallery co-library-section co-color-scheme-' | append: section.settings.color_scheme
  assign social_gallery_classes = social_gallery_classes | append: ' co-social-gallery--desktop-columns-' | append: section.settings.desktop_columns
  assign social_gallery_classes = social_gallery_classes | append: ' co-social-gallery--mobile-columns-' | append: section.settings.mobile_columns
  assign social_gallery_classes = social_gallery_classes | append: ' co-social-gallery--layout-' | append: section.settings.layout
  assign social_gallery_heading_id = 'SocialGalleryHeading-' | append: section.id
%}

{% render 'section-spacing', section: section %}

<section class="{{ social_gallery_classes }}" {% if section.settings.heading != blank %}aria-labelledby="{{ social_gallery_heading_id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="co-social-gallery__inner co-page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.description, id: social_gallery_heading_id, alignment: section.settings.text_alignment, size: section.settings.heading_size %}
    {% if section.blocks.size > 0 %}
      <ul class="co-social-gallery__grid" role="list">
        {% for block in section.blocks %}
          {% assign social_gallery_alt = block.settings.accessible_label | default: block.settings.image.alt %}
          <li class="co-social-gallery__item" {{ block.shopify_attributes }}>
            {% capture social_gallery_content %}
              {% if block.settings.image != blank %}{% render 'responsive-image', image: block.settings.image, alt: social_gallery_alt, loading: 'lazy', sizes: '(min-width: 48rem) 25vw, 70vw', widths: '165, 360, 535, 750, 1000', ratio: section.settings.image_ratio, class: 'co-social-gallery__image' %}{% else %}<div class="co-social-gallery__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>{% endif %}
              {% if section.settings.show_captions and block.settings.caption != blank %}<p class="co-social-gallery__caption">{{ block.settings.caption | escape }}</p>{% endif %}
            {% endcapture %}
            {% if block.settings.link != blank %}<a class="co-social-gallery__link" href="{{ block.settings.link | escape }}" {% if block.settings.accessible_label != blank %}aria-label="{{ block.settings.accessible_label | escape }}"{% endif %}>{{ social_gallery_content }}</a>{% else %}{{ social_gallery_content }}{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% elsif request.design_mode %}<p>{{ 'sections.social_gallery.placeholder_text' | t }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.social_gallery.name",
  "tag": "section",
  "class": "co-section-social-gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.shared.settings.eyebrow.label" },
    { "type": "inline_richtext", "id": "heading", "label": "t:sections.shared.settings.heading.label", "default": "From the community" },
    { "type": "richtext", "id": "description", "label": "t:sections.shared.settings.description.label" },
    { "type": "select", "id": "heading_size", "label": "t:sections.shared.settings.heading_size.label", "default": "standard", "options": [{ "value": "small", "label": "t:sections.shared.options.small" }, { "value": "standard", "label": "t:sections.shared.options.standard" }, { "value": "large", "label": "t:sections.shared.options.large" }] },
    { "type": "select", "id": "text_alignment", "label": "t:sections.shared.settings.text_alignment.label", "default": "left", "options": [{ "value": "left", "label": "t:sections.shared.options.left" }, { "value": "center", "label": "t:sections.shared.options.center" }] },
    { "type": "select", "id": "desktop_columns", "label": "t:sections.shared.settings.desktop_columns.label", "default": "4", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }] },
    { "type": "select", "id": "mobile_columns", "label": "t:sections.shared.settings.mobile_columns.label", "default": "2", "options": [{ "value": "1", "label": "t:sections.shared.options.one" }, { "value": "2", "label": "t:sections.shared.options.two" }] },
    { "type": "select", "id": "image_ratio", "label": "t:sections.shared.settings.image_ratio.label", "default": "square", "options": [{ "value": "square", "label": "t:sections.shared.options.square" }, { "value": "portrait", "label": "t:sections.shared.options.portrait" }, { "value": "landscape", "label": "t:sections.shared.options.landscape" }] },
    { "type": "select", "id": "layout", "label": "t:sections.shared.settings.layout.label", "default": "grid", "options": [{ "value": "grid", "label": "t:sections.shared.options.grid" }, { "value": "scroll", "label": "t:sections.shared.options.horizontal_scroll" }] },
    { "type": "checkbox", "id": "show_captions", "label": "t:sections.shared.settings.show_captions.label", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.shared.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:sections.shared.settings.desktop_top_spacing.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.shared.settings.desktop_bottom_spacing.label", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "mobile_padding_top", "label": "t:sections.shared.settings.mobile_top_spacing.label", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "t:sections.shared.settings.mobile_bottom_spacing.label", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "image", "name": "t:sections.social_gallery.blocks.image", "settings": [{ "type": "image_picker", "id": "image", "label": "t:sections.shared.settings.image.label" }, { "type": "text", "id": "caption", "label": "t:sections.shared.settings.caption.label" }, { "type": "url", "id": "link", "label": "t:sections.shared.settings.link.label" }, { "type": "text", "id": "accessible_label", "label": "t:sections.shared.settings.accessible_label.label", "info": "t:sections.shared.settings.accessible_label.info" }] }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "t:sections.social_gallery.preset", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
