{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% liquid
  assign awards_heading_id = 'AwardsCertificationsHeading-' | append: section.id
  assign awards_classes = 'co-awards-certifications co-brand-story-section co-color-scheme-' | append: section.settings.color_scheme
%}
{% render 'section-spacing', section: section %}
<section class="{{ awards_classes }}" style="--co-awards-desktop-columns: {{ section.settings.columns_desktop }}; --co-awards-mobile-columns: {{ section.settings.columns_mobile }};"{% if section.settings.heading != blank %} aria-labelledby="{{ awards_heading_id }}"{% endif %} {{ section.shopify_attributes }}><div class="co-page-width">{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.text, id: awards_heading_id, level: 'h2', alignment: section.settings.text_alignment, size: section.settings.heading_size, class: 'co-brand-story-section__header' %}{% if section.blocks.size > 0 %}<div class="co-awards-certifications__grid" role="list">{% for block in section.blocks %}<article class="co-awards-certifications__item" role="listitem" {{ block.shopify_attributes }}>{% if block.settings.logo != blank %}<div class="co-awards-certifications__logo">{% render 'responsive-image', image: block.settings.logo, alt: '', loading: 'lazy', sizes: '180px', widths: '96, 144, 180, 240', ratio: 'natural', fit: 'contain' %}</div>{% elsif block.settings.award_icon != 'none' %}<span class="co-awards-certifications__icon">{% render 'icon', icon: block.settings.award_icon, size: 28, decorative: true %}</span>{% endif %}{% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}{% if block.settings.issuer != blank %}<p class="co-awards-certifications__issuer">{{ block.settings.issuer | escape }}</p>{% endif %}{% if block.settings.year != blank %}<p class="co-awards-certifications__year">{{ block.settings.year | escape }}</p>{% endif %}{% if block.settings.text != blank %}<div class="co-awards-certifications__description">{{ block.settings.text }}</div>{% endif %}{% if block.settings.verification_link != blank and block.settings.verification_label != blank %}{% render 'button', label: block.settings.verification_label, url: block.settings.verification_link, variant: 'text', icon: 'external-link', icon_position: 'end' %}{% endif %}</article>{% endfor %}</div>{% elsif request.design_mode %}<p class="co-brand-story-section__empty">{{ 'sections.awards_certifications.empty' | t }}</p>{% endif %}</div></section>
{% schema %}
