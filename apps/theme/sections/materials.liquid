{"type":"text","id":"eyebrow","label":"t:sections.shared.settings.eyebrow.label"},{"type":"inline_richtext","id":"heading","label":"t:sections.shared.settings.heading.label","default":"Materials"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"},{"type":"select","id":"heading_size","label":"t:sections.shared.settings.heading_size.label","default":"standard","options":[{"value":"small","label":"t:sections.shared.options.small"},{"value":"standard","label":"t:sections.shared.options.standard"},{"value":"large","label":"t:sections.shared.options.large"}]},{"type":"select","id":"text_alignment","label":"t:sections.shared.settings.text_alignment.label","default":"left","options":[{"value":"left","label":"t:sections.shared.options.left"},{"value":"center","label":"t:sections.shared.options.center"}]},{"type":"select","id":"layout","label":"t:sections.shared.settings.layout.label","default":"grid","options":[{"value":"grid","label":"t:sections.shared.options.grid"},{"value":"editorial","label":"t:sections.shared.options.editorial"}]},{"type":"select","id":"image_ratio","label":"t:sections.shared.settings.image_ratio.label","default":"square","options":[{"value":"square","label":"t:sections.shared.options.square"},{"value":"portrait","label":"t:sections.shared.options.portrait"},{"value":"landscape","label":"t:sections.shared.options.landscape"}]},{"type":"text","id":"button_label","label":"t:sections.shared.settings.button_label.label"},{"type":"url","id":"button_link","label":"t:sections.shared.settings.button_link.label"},{"type":"color_scheme","id":"color_scheme","label":"t:sections.shared.settings.color_scheme.label","default":"scheme-1"},{"type":"range","id":"padding_top","label":"t:sections.shared.settings.desktop_top_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"t:sections.shared.settings.desktop_bottom_spacing.label","min":0,"max":160,"step":4,"unit":"px","default":8