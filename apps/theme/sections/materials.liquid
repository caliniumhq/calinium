{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% liquid
  assign materials_heading_id = 'MaterialsHeading-' | append: section.id
  assign materials_classes = 'co-materials co-brand-story-section co-color-scheme-' | append: section.settings.color_scheme
  assign materials_classes = materials_classes | append: ' co-materials--' | append: section.settings.layout
%}
{% render 'section-spacing', section: section %}
<section class="{{ materials_classes }}"{% if section.settings.heading != blank %} aria-labelledby="{{ materials_heading_id }}"{% endif %} {{ section.shopify_attributes }}><div class="co-page-width">
  {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.text, id: materials_heading_id, level: 'h2', alignment: section.settings.text_alignment, size: section.settings.heading_size, class: 'co-brand-story-section__header' %}
  {% if section.blocks.size > 0 %}<div class="co-materials__grid" role="list">{% for block in section.blocks %}<article class="co-materials__item" role="listitem" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="co-materials__media">{% render 'responsive-image', image: block.settings.image, loading: 'lazy', sizes: '(min-width: 48rem) 33vw, 50vw', widths: '240, 360, 535, 750, 1000', ratio: section.settings.image_ratio, class: 'co-materials__image' %}</div>{% endif %}<div class="co-materials__details">{% if block.settings.material_icon != 'none' %}<span class="co-materials__icon">{% render 'icon', icon: block.settings.material_icon, size: 24, decorative: true %}</span>{% endif %}{% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}{% if block.settings.text != blank %}{% render 'rich-text', content: block.settings.text %}{% endif %}{% if block.settings.origin != blank %}<p class="co-materials__meta">{{ block.settings.origin | escape }}</p>{% endif %}{% if block.settings.properties != blank %}<p class="co-materials__meta">{{ block.settings.properties | escape }}</p>{% endif %}</div></article>{% endfor %}</div>{% elsif request.design_mode %}<p class="co-brand-story-section__empty">{{ 'sections.materials.empty' | t }}</p>{% endif %}
  {% if section.settings.button_label != blank and section.settings.button_link != blank %}<div class="co-brand-story-section__actions">{% render 'button', label: section.settings.button_label, url: section.settings.button_link, variant: 'secondary' %}</div>{% endif %}
</div></section>
{% schema %}
