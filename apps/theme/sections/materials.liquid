"blocks":[{"type":"material","name":"t:sections.materials.blocks.material","settings":[{"type":"image_picker","id":"image","label":"t:sections.shared.settings.image.label"},{"type":"select","id":"material_icon","label":"t:sections.shared.settings.icon.label","default":"none","options":[{"value":"none","label":"t:sections.shared.options.none"},{"value":"diamond","label":"t:sections.shared.options.diamond"},{"value":"leaf","label":"t:sections.shared.options.leaf"},{"value":"sparkle","label":"t:sections.shared.options.sparkle"},{"value":"recycle","label":"t:sections.shared.options.recycle"}]},{"type":"inline_richtext","id":"heading","label":"t:sections.materials.settings.material_name.label"},{"type":"richtext","id":"text","label":"t:sections.shared.settings.text.label"},{"type":"text","id":"origin","label":"t:sections.materials.settings.origin.label"},{"type":"text","id":"properties","label":"t:sections.materials.settings.properties.label"}]}],"max_blocks":8,"presets":[{"name":"t:sections.materials.preset","blocks":[{"type":"material"},{"type":"material"}]}]}
