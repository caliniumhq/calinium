{% liquid
  assign manifesto_classes = 'co-brand-manifesto co-library-section co-editorial-pack-section co-color-scheme-' | append: section.settings.color_scheme
  assign manifesto_classes = manifesto_classes | append: ' co-brand-manifesto--' | append: section.settings.layout
  assign manifesto_heading_id = 'BrandManifestoHeading-' | append: section.id
  if section.settings.enable_animation
    assign manifesto_classes = manifesto_classes | append: ' co-brand-manifesto--animate'
  endif
%}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-image.css' | asset_url | stylesheet_tag }}
{% render 'section-spacing', section: section %}
<section class="{{ manifesto_classes }}" {% if section.settings.heading != blank %}aria-labelledby="{{ manifesto_heading_id }}"{% endif %} {{ section.shopify_attributes }}><div class="co-brand-manifesto__layout co-page-width"><div class="co-brand-manifesto__content co-editorial-pack-section__content">{% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, id: manifesto_heading_id, level: 'h2', alignment: 'left', size: 'large' %}{% if section.settings.text != blank %}{% render 'rich-text', content: section.settings.text, class: 'co-editorial-pack-section__text' %}{% endif %}{% if section.settings.button_label != blank and section.settings.button_link != blank %}<div class="co-editorial-pack-section__actions">{% render 'button', label: section.settings.button_label, url: section.settings.button_link, variant: 'primary' %}</div>{% endif %}{% if section.blocks.size > 0 %}<div class="co-brand-manifesto__principles" role="list">{% for block in section.blocks %}<article class="co-brand-manifesto__principle" role="listitem" {{ block.shopify_attributes }}>{% if section.settings.show_numbers %}<span class="co-brand-manifesto__number">{{ forloop.index | prepend: '0' }}</span>{% endif %}<div>{% if block.settings.heading != blank %}<h3 class="co-brand-manifesto__principle-title">{{ block.settings.heading }}</h3>{% endif %}{% if block.settings.text != blank %}<div class="co-editorial-pack-section__text">{{ block.settings.text }}</div>{% endif %}</div></article>{% endfor %}</div>{% endif %}</div>{% if section.settings.image != blank %}<div class="co-brand-manifesto__media">{% render 'responsive-image', image: section.settings.image, mobile_image: section.settings.mobile_image, loading: 'lazy', sizes: '(min-width: 48rem) 50vw, 100vw', widths: '375, 550, 750, 1000, 1500, 2000', ratio: section.settings.media_ratio, class: 'co-brand-manifesto__image' %}</div>{% endif %}</div></section>
{% schema %}
{
  "name": "t:sections.brand_manifesto.name",
  "tag": "section",
  "class": "co-section-brand-manifesto",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.shared.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.shared.settings.heading.label",
      "default": "A considered approach"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.shared.settings.text.label",
      "default": "<p>Use this space to articulate the values behind the work.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.shared.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.shared.settings.mobile_image.label"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:sections.brand_manifesto.settings.media_ratio.label",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "t:sections.shared.options.square"
        },
        {
          "value": "portrait",
          "label": "t:sections.shared.options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:sections.shared.options.landscape"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.shared.settings.button_label.label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.shared.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.shared.settings.layout.label",
      "default": "minimal",
      "options": [
        {
          "value": "minimal",
          "label": "t:sections.brand_manifesto.settings.layout.options.minimal"
        },
        {
          "value": "split",
          "label": "t:sections.brand_manifesto.settings.layout.options.split"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "t:sections.brand_manifesto.settings.show_numbers.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:sections.brand_manifesto.settings.enable_animation.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.shared.settings.desktop_top_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.shared.settings.desktop_bottom_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:sections.shared.settings.mobile_top_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:sections.shared.settings.mobile_bottom_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "t:sections.brand_manifesto.blocks.principle",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.shared.settings.heading.label",
          "default": "A clear principle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.shared.settings.text.label",
          "default": "<p>A short supporting thought.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.brand_manifesto.preset",
      "blocks": [
        {
          "type": "principle"
        },
        {
          "type": "principle"
        },
        {
          "type": "principle"
        }
      ]
    }
  ]
}
{% endschema %}
