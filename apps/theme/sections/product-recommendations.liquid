{{ 'component-image.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{% if section.settings.enable_quick_add %}
  {{ 'component-quantity-input.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
{% endif %}

{% liquid
  assign recommendation_heading_id = 'ProductRecommendationsHeading-' | append: section.id
  assign recommendation_classes = 'co-commerce-recommendation co-commerce-section co-color-scheme-' | append: section.settings.color_scheme
  assign recommendation_url = blank
  assign recommendation_loading_label = 'sections.product_recommendations.loading' | t
  if product != blank
    capture recommendation_url
      echo routes.product_recommendations_url
      echo '?section_id='
      echo section.id
      echo '&product_id='
      echo product.id
      echo '&limit='
      echo section.settings.products_to_show
      echo '&intent=related'
    endcapture
  endif
%}

{% render 'section-spacing', section: section %}

<section class="{{ recommendation_classes }}" style="--co-commerce-desktop-columns: {{ section.settings.columns_desktop }}; --co-commerce-mobile-columns: {{ section.settings.columns_mobile }};"{% if request.design_mode %} data-design-mode="true"{% endif %}{% if recommendation_url != blank and recommendations.performed == false %} data-co-section-behavior data-commerce-recommendation data-recommendation-url="{{ recommendation_url | strip | escape }}"{% endif %} {% if section.settings.heading != blank %}aria-labelledby="{{ recommendation_heading_id }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="co-page-width" data-commerce-recommendation-content{% if recommendations.performed and recommendations.products_count > 0 %} data-commerce-recommendation-results{% endif %}>
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, description: section.settings.description, id: recommendation_heading_id, alignment: section.settings.text_alignment, size: section.settings.heading_size, class: 'co-commerce-section__header' %}
    {% if recommendations.performed %}
      {% if recommendations.products_count > 0 %}
        <ul class="co-commerce-recommendation__grid" role="list">
          {% for recommendation_product in recommendations.products limit: section.settings.products_to_show %}
            <li>{% render 'product-card', product: recommendation_product, section_id: section.id, image_ratio: section.settings.image_ratio, image_loading: 'lazy', image_sizes: '(min-width: 48rem) 25vw, 50vw', image_widths: '165, 360, 535, 750, 1000', show_vendor: section.settings.show_vendor, show_rating: false, show_compare_at_price: true, show_sale_badge: section.settings.show_badges, show_sold_out_badge: section.settings.show_badges, show_secondary_image: section.settings.show_secondary_image, show_inventory: false, show_quick_add: section.settings.enable_quick_add, card_alignment: section.settings.text_alignment %}</li>
          {% endfor %}
        </ul>
      {% elsif request.design_mode %}
        <p class="co-commerce-section__empty">{{ 'sections.product_recommendations.empty' | t }}</p>
      {% endif %}
    {% elsif request.design_mode %}
      <p class="co-commerce-section__empty">{{ 'sections.product_recommendations.preview' | t }}</p>
    {% elsif product != blank %}
      <div class="co-commerce-loading">{% render 'loading-spinner', size: 20, label: recommendation_loading_label %}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "tag": "section",
  "class": "co-section-product-recommendations",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.shared.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.shared.settings.heading.label",
      "default": "You may also like"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.shared.settings.description.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.shared.settings.heading_size.label",
      "default": "standard",
      "options": [
        {
          "value": "small",
          "label": "t:sections.shared.options.small"
        },
        {
          "value": "standard",
          "label": "t:sections.shared.options.standard"
        },
        {
          "value": "large",
          "label": "t:sections.shared.options.large"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.shared.settings.text_alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.shared.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.shared.options.center"
        }
      ]
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product_recommendations.settings.products_to_show.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.product_recommendations.settings.columns_desktop.label",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.product_recommendations.settings.columns_mobile.label",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "t:sections.shared.options.one"
        },
        {
          "value": "2",
          "label": "t:sections.shared.options.two"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.shared.settings.image_ratio.label",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "t:sections.shared.options.square"
        },
        {
          "value": "portrait",
          "label": "t:sections.shared.options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:sections.shared.options.landscape"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.shared.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "t:sections.product_recommendations.settings.show_badges.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.shared.settings.show_secondary_image.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "t:sections.shared.settings.enable_quick_add.label",
      "info": "t:sections.shared.settings.enable_quick_add.info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.shared.settings.desktop_top_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.shared.settings.desktop_bottom_spacing.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "t:sections.shared.settings.mobile_top_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "t:sections.shared.settings.mobile_bottom_spacing.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_recommendations.preset"
    }
  ]
}
{% endschema %}
