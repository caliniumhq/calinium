{{ 'component-button.css' | asset_url | stylesheet_tag }}

{% liquid
  assign marquee_classes = 'co-marquee co-color-scheme-' | append: section.settings.color_scheme
  assign marquee_classes = marquee_classes | append: ' co-marquee--direction-' | append: section.settings.direction
  assign marquee_classes = marquee_classes | append: ' co-marquee--size-' | append: section.settings.text_size
  assign marquee_pause_label = 'sections.marquee.pause' | t
  assign marquee_resume_label = 'sections.marquee.resume' | t
  if section.settings.static_fallback
    assign marquee_classes = marquee_classes | append: ' co-marquee--static'
  endif
  if section.settings.pause_on_hover
    assign marquee_classes = marquee_classes | append: ' co-marquee--pause-hover'
  endif
%}

<section class="{{ marquee_classes }}" style="--co-marquee-duration: {{ section.settings.speed }}s; --co-marquee-gap: {{ section.settings.gap }}px;" data-co-section-behavior data-co-marquee data-pause-label="{{ marquee_pause_label | escape }}" data-resume-label="{{ marquee_resume_label | escape }}" {{ section.shopify_attributes }}>
  <div class="co-marquee__viewport">
    <div class="co-marquee__track">
      <ul class="co-marquee__list" role="list">
        {% for block in section.blocks %}<li class="co-marquee__item" {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{% endif %}{% if block.settings.icon != 'none' %}{% render 'icon', name: block.settings.icon, size: 20 %}{% endif %}<span>{{ block.settings.text | escape }}</span>{% if block.settings.link != blank %}</a>{% endif %}</li>{% endfor %}
      </ul>
      <ul class="co-marquee__list" role="list" aria-hidden="true">
        {% for block in section.blocks %}<li class="co-marquee__item">{% if block.settings.icon != 'none' %}{% render 'icon', name: block.settings.icon, size: 20 %}{% endif %}<span>{{ block.settings.text | escape }}</span></li>{% endfor %}
      </ul>
    </div>
  </div>
  {% unless section.settings.static_fallback %}{% render 'button', label: marquee_pause_label, type: 'button', variant: 'text', class: 'co-marquee__pause', data_action: 'marquee-pause' %}{% endunless %}
</section>

{% schema %}
