    { "type": "range", "id": "speed", "label": "t:sections.shared.settings.speed.label", "min": 10, "max": 60, "step": 2, "unit": "s", "default": 28 },
    { "type": "range", "id": "gap", "label": "t:sections.shared.settings.gap.label", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 48 },
