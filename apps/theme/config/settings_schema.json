[
  {
    "name": "t:settings_schema.brand.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings_schema.brand.settings.logo.label",
        "info": "t:settings_schema.brand.settings.logo.info"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 280,
        "step": 4,
        "unit": "px",
        "label": "t:settings_schema.brand.settings.logo_width.label",
        "default": 144
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.brand.settings.favicon.label",
        "info": "t:settings_schema.brand.settings.favicon.info"
      }
    ]
  },
  {
    "name": "t:settings_schema.colors.name",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:settings_schema.colors.settings.background.label",
            "default": "#FFFCF7"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:settings_schema.colors.settings.background_gradient.label",
            "info": "t:settings_schema.colors.settings.background_gradient.info"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "t:settings_schema.colors.settings.surface.label",
            "default": "#F4EFE6"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:settings_schema.colors.settings.text.label",
            "default": "#1D1D1B"
          },
          {
            "type": "color",
            "id": "text_muted",
            "label": "t:settings_schema.colors.settings.text_muted.label",
            "default": "#65615B"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings_schema.colors.settings.button.label",
            "default": "#1D1D1B"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings_schema.colors.settings.button_label.label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button",
            "label": "t:settings_schema.colors.settings.secondary_button.label",
            "default": "#FFFCF7"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:settings_schema.colors.settings.secondary_button_label.label",
            "default": "#1D1D1B"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:settings_schema.colors.settings.border.label",
            "default": "#D7D0C4"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:settings_schema.colors.settings.accent.label",
            "default": "#53483B"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "accent",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "secondary_button",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "border"
        }
      },
      {
        "type": "color_scheme",
        "id": "default_color_scheme",
        "label": "t:settings_schema.colors.settings.default_color_scheme.label",
        "info": "t:settings_schema.colors.settings.default_color_scheme.info",
        "default": "scheme-1"
      }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n4",
        "label": "t:settings_schema.typography.settings.type_heading_font.label"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 140,
        "step": 5,
        "unit": "%",
        "label": "t:settings_schema.typography.settings.heading_scale.label",
        "default": 110
      },
      {
        "type": "select",
        "id": "heading_line_height",
        "label": "t:settings_schema.typography.settings.heading_line_height.label",
        "default": "1.1",
        "options": [
          {
            "value": "1",
            "label": "t:settings_schema.typography.settings.heading_line_height.options.compact"
          },
          {
            "value": "1.1",
            "label": "t:settings_schema.typography.settings.heading_line_height.options.standard"
          },
          {
            "value": "1.2",
            "label": "t:settings_schema.typography.settings.heading_line_height.options.relaxed"
          }
        ]
      },
      {
        "type": "select",
        "id": "heading_letter_spacing",
        "label": "t:settings_schema.typography.settings.heading_letter_spacing.label",
        "default": "-0.02em",
        "options": [
          {
            "value": "-0.02em",
            "label": "t:settings_schema.typography.settings.heading_letter_spacing.options.tight"
          },
          {
            "value": "0em",
            "label": "t:settings_schema.typography.settings.heading_letter_spacing.options.normal"
          },
          {
            "value": "0.04em",
            "label": "t:settings_schema.typography.settings.heading_letter_spacing.options.wide"
          }
        ]
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "t:settings_schema.typography.settings.type_body_font.label"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "t:settings_schema.typography.settings.body_scale.label",
        "default": 100
      },
      {
        "type": "select",
        "id": "body_line_height",
        "label": "t:settings_schema.typography.settings.body_line_height.label",
        "default": "1.6",
        "options": [
          {
            "value": "1.5",
            "label": "t:settings_schema.typography.settings.body_line_height.options.compact"
          },
          {
            "value": "1.6",
            "label": "t:settings_schema.typography.settings.body_line_height.options.standard"
          },
          {
            "value": "1.7",
            "label": "t:settings_schema.typography.settings.body_line_height.options.relaxed"
          }
        ]
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
