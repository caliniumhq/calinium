# Dashboard environment — copy to a local .env file that is never committed.
CALINIUM_ENVIRONMENT=development
# Shopify CLI injects APP_URL, HOST, SHOPIFY_API_KEY, and SHOPIFY_API_SECRET
# for `shopify app dev`. Do not copy a temporary tunnel URL into this file.
# The dashboard uses those injected values only for the current CLI session.
CALINIUM_APPLICATION_URL=https://YOUR-SHOPIFY-CLI-URL
CALINIUM_DASHBOARD_SESSION_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
# Keep these legacy-compatible values for direct local OAuth only. Shopify CLI
# supplies the active app credentials at runtime and takes precedence.
CALINIUM_SHOPIFY_CLIENT_ID=REPLACE_WITH_DEV_DASHBOARD_CLIENT_ID
CALINIUM_SHOPIFY_CLIENT_SECRET=REPLACE_WITH_DEV_DASHBOARD_CLIENT_SECRET
CALINIUM_SHOPIFY_OAUTH_REDIRECT_URI=https://YOUR-SHOPIFY-CLI-URL/api/shopify/oauth/callback
CALINIUM_SHOPIFY_ADMIN_API_VERSION=2026-07
CALINIUM_SHOPIFY_WEBHOOK_API_VERSION=2026-07
CALINIUM_SHOPIFY_MANAGED_INSTALLATION=true
CALINIUM_SHOPIFY_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_OR_64_HEX_KEY
CALINIUM_SHOPIFY_TOKEN_ENCRYPTION_KEY_ID=development-v1
# Optional for a local development store only. Never use a production store.
CALINIUM_SHOPIFY_DEVELOPMENT_STORE_URL=
CALINIUM_SQLITE_PATH=.calinium-data/dashboard.sqlite
CALINIUM_ASSET_STORAGE_PATH=.calinium-data/assets
# Paid custom-theme flow. Prices are versioned in
# config/custom-theme-price-catalog.json; never put a price or Shopify
# credential in this file. Shopify Admin GraphQL billing is the default.
# Use development_simulator only in test/local development, never production.
CALINIUM_PAYMENT_PROVIDER=shopify_one_time
CALINIUM_PAYMENT_MODE=
# Test purchases are allowed only outside production. Development stores are
# not charged. Set false only when validating a non-production live charge flow.
CALINIUM_SHOPIFY_BILLING_TEST_MODE=true
