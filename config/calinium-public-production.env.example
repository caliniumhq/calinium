# Public Calinium production contract. This file contains no credentials and
# must never be populated with staging or LEGACY_EXAMPLE values.
CALINIUM_ENVIRONMENT=production
CALINIUM_DEPLOYMENT_IDENTITY=calinium-public-production
CALINIUM_SHOPIFY_APP_IDENTITY=calinium-public
CALINIUM_APPLICATION_URL=https://app.calinium.com
CALINIUM_SHOPIFY_OAUTH_REDIRECT_URI=https://app.calinium.com/api/shopify/oauth/callback
CALINIUM_SHOPIFY_CLIENT_ID=
CALINIUM_SHOPIFY_CLIENT_SECRET=
CALINIUM_SHOPIFY_TOKEN_ENCRYPTION_KEY=
CALINIUM_DASHBOARD_SESSION_SECRET=

CALINIUM_STORAGE_DRIVER=postgres
CALINIUM_DATABASE_IDENTITY=calinium-public-production
# Founder-approved provider identity: fly_mpg, neon, or supabase.
CALINIUM_DATABASE_PROVIDER=
DATABASE_URL=
DATABASE_SSL=true
CALINIUM_DATABASE_POOL_MAX=10
CALINIUM_DATABASE_CONNECTION_TIMEOUT_MS=5000
CALINIUM_DATABASE_IDLE_TIMEOUT_MS=300000
CALINIUM_DATABASE_MAX_LIFETIME_SECONDS=600
CALINIUM_DATABASE_STATEMENT_TIMEOUT_MS=30000
CALINIUM_DATABASE_BACKUP_CONFIGURATION_ID=
CALINIUM_DATABASE_RESTORE_CONFIGURATION_ID=

CALINIUM_ASSET_STORAGE_DRIVER=object
CALINIUM_ARTIFACT_STORAGE_DRIVER=object
CALINIUM_OBJECT_STORAGE_IDENTITY=calinium-public-production
CALINIUM_OBJECT_STORAGE_PROVIDER=tigris
CALINIUM_OBJECT_STORAGE_ENDPOINT=https://t3.storage.dev
CALINIUM_OBJECT_STORAGE_REGION=auto
CALINIUM_OBJECT_STORAGE_BUCKET=
CALINIUM_OBJECT_STORAGE_PREFIX=public
CALINIUM_OBJECT_STORAGE_BACKUP_CONFIGURATION_ID=
CALINIUM_OBJECT_STORAGE_LIFECYCLE_POLICY_ID=authoritative-no-expiry-v1
CALINIUM_OBJECT_STORAGE_RESTORE_POLICY_ID=provider-restore-acceptance-v1
# Supply only through the production secret store. Never commit values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

CALINIUM_SECRET_STORE_IDENTITY=calinium-public-production
CALINIUM_LOG_ENVIRONMENT=public-production
CALINIUM_LOG_DESTINATION=structured-stdout
CALINIUM_PUBLIC_OPERATOR_USER_IDS=
CALINIUM_INCIDENT_CONFIGURATION_ID=

CALINIUM_MERCHANT_FLOW_BETA_ENABLED=false
CALINIUM_ALLOWED_SHOP_DOMAINS=
CALINIUM_PRIVACY_WEBHOOKS_ENABLED=true
CALINIUM_PRIVACY_WEBHOOK_TOPICS=customers/data_request,customers/redact,shop/redact

# These must be real, published destinations below calinium.com. Do not use
# placeholders. Production readiness remains NOT_READY while any are blank.
CALINIUM_PRIVACY_POLICY_URL=
CALINIUM_TERMS_URL=
CALINIUM_SUPPORT_URL=
