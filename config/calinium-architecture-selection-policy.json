    "profile.current_calinium.v1": {
      "summary": "Conventional commerce hierarchy for broader or more complex catalog exploration, utility-led navigation, denser product discovery, and stores whose decision path cannot depend on rich imagery.",
      "structural_evidence": [
        "single-grid commerce header and disclosure navigation",
        "uniform commerce product-card hierarchy",
        "conventional collection grid with facets, sorting, and pagination",
        "balanced product-detail media and purchase relationship"
      ]
    },
    "profile.editorial_discovery.v1": {
      "summary": "Image-led, story-rich discovery for stores that can support editorial merchandising rhythm, stronger media hierarchy, asymmetric product detail, and restrained catalog/navigation complexity.",
      "structural_evidence": [
        "editorial masthead and distinct utility/navigation hierarchy",
        "independent media-led product-card composition",
        "feature-first editorial merchandising grid",
        "media-led asymmetric product-detail relationship"
      ]
    }
  },
