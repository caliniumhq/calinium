    {"section_id":"image-mosaic","works_with":["story-banner","featured-collection","newsletter"],"avoid_directly_before":["lookbook","social-gallery","behind-the-scenes"],"avoid_directly_after":[],"rationale":"Keep visual-gallery sequences distinct so the purpose of each image remains clear."},
    {"section_id":"product-carousel","works_with":["featured-categories","product-highlights","testimonials","newsletter"],"avoid_directly_before":["featured-collection","product-carousel"],"avoid_directly_after":[],"rationale":"Avoid consecutive product grids unless the second has a materially different browsing task."},
    {"section_id":"product-comparison","works_with":["product-highlights","faq","product-carousel"],"avoid_directly_before":["comparison-table"],"avoid_directly_after":[],"rationale":"One structured comparison is enough; adjacent comparison tables create cognitive overload."},
