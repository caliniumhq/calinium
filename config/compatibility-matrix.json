    {"section_id":"hero-slideshow","works_with":["founder-story","craftsmanship","featured-collection","testimonials"],"avoid_directly_before":["hero-banner","editorial-hero","full-screen-hero"],"avoid_directly_after":[],"rationale":"A slideshow establishes orientation; another hero directly after it repeats that job."},
    {"section_id":"editorial-hero","works_with":["lookbook","story-banner","founder-story","featured-collection"],"avoid_directly_before":["hero-banner","hero-slideshow","full-screen-hero"],"avoid_directly_after":[],"rationale":"Follow a typography-led hero with one story or discovery action, not a second competing hero."},
    {"section_id":"full-screen-hero","works_with":["story-banner","behind-the-scenes","product-carousel","newsletter"],"avoid_directly_before":["hero-banner","hero-slideshow","editorial-hero"],"avoid_directly_after":[],"rationale":"An immersive hero needs a calmer supporting section to preserve hierarchy."},
    {"section_id":"founder-story","works_with":["brand-timeline","brand-values","craftsmanship","team"],"avoid_directly_before":["founder-story"],"avoid_directly_after":[],"rationale":"Founder context is strongest when followed by verified values, history, or craft evidence."},
    {"section_id":"brand-timeline","works_with":["founder-story","craftsmanship","manufacturing-process","brand-values"],"avoid_directly_before":["brand-timeline"],"avoid_directly_after":[],"rationale":"Chronological sections should be singular and should not compete with another long sequence."},
    {"section_id":"craftsmanship","works_with":["materials","behind-the-scenes","featured-collection"],"avoid_directly_before":["manufacturing-process"],"avoid_directly_after":[],"rationale":"Pair process evidence with products or real media; avoid two dense process explanations consecutively."},
