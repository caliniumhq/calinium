{% liquid
  assign ed_image = section.settings.image | default: collection.image
  assign ed_heading_id = 'EditorialCollectionHeading-' | append: section.id
  assign ed_classes = 'co-ed-collection-banner co-color-scheme-' | append: section.settings.color_scheme
  assign ed_classes = ed_classes | append: ' co-ed-collection-banner--' | append: section.settings.content_alignment
  assign ed_classes = ed_classes | append: ' co-ed-collection-banner--' | append: section.settings.layout
  if ed_image == blank or section.settings.show_image == false
    assign ed_classes = ed_classes | append: ' co-ed-collection-banner--without-media'
  endif
%}

{% if collection != blank %}
  {% if section.settings.show_image and ed_image != blank %}{{ 'component-image.css' | asset_url | stylesheet_tag }}{% endif %}
  {{ 'editorial-discovery-collection.css' | asset_url | stylesheet_tag }}
  {{ 'editorial-discovery-responsive.css' | asset_url | stylesheet_tag }}

  <section
    class="{{ ed_classes }}"
    aria-labelledby="{{ ed_heading_id }}"
    data-editorial-discovery-collection-banner
    data-calinium-presenter="section.collection_banner.editorial_discovery"
    data-calinium-responsive-family="family.responsive_behavior.editorial_discovery.v1"
    style="--co-ed-collection-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  >
    <div class="co-ed-collection-banner__inner{% if section.settings.layout == 'contained' %} co-page-width{% endif %}">
      <div class="co-ed-collection-banner__content">
        <span class="co-ed-collection-banner__index" aria-hidden="true">Collection</span>
        <h1 id="{{ ed_heading_id }}" class="co-ed-collection-banner__heading">{{ collection.title | escape }}</h1>
        {% if section.settings.show_description and collection.description != blank %}<div class="co-ed-collection-banner__description rte">{{ collection.description }}</div>{% endif %}
        {% if section.settings.editorial_text != blank %}<p class="co-ed-collection-banner__editorial">{{ section.settings.editorial_text | escape }}</p>{% endif %}
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <div class="co-ed-collection-banner__action">{% render 'button', label: section.settings.button_label, url: section.settings.button_link, variant: 'text', icon: 'arrow-right', icon_position: 'end' %}</div>
        {% endif %}
      </div>

      {% if section.settings.show_image and ed_image != blank %}
        <div class="co-ed-collection-banner__media{% if section.settings.enable_overlay %} co-ed-collection-banner__media--overlay{% endif %}">
          {% render 'responsive-image', image: ed_image, mobile_image: section.settings.mobile_image, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 64rem) 58vw, (min-width: 48rem) 52vw, 100vw', widths: '375, 550, 750, 1000, 1500, 2000', ratio: section.settings.image_ratio, class: 'co-ed-collection-banner__image' %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:sections.collection_banner.name",
  "tag": "section",
  "class": "co-section-collection-banner",
  "limit": 1,
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "header", "content": "Collection hero" },
    { "type": "checkbox", "id": "show_image", "label": "t:sections.collection_banner.settings.show_image.label", "default": true },
    { "type": "image_picker", "id": "image", "label": "Collection image override", "info": "Takes priority over the collection image." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image override" },
    { "type": "checkbox", "id": "show_description", "label": "t:sections.collection_banner.settings.show_description.label", "default": true },
    { "type": "text", "id": "editorial_text", "label": "Editorial text", "info": "Optional context supplied by the merchant." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "contained", "options": [{ "value": "contained", "label": "Contained" }, { "value": "full_width", "label": "Full width" }] },
    { "type": "select", "id": "image_ratio", "label": "t:sections.collection_banner.settings.image_ratio.label", "default": "wide", "options": [{ "value": "landscape", "label": "t:sections.collection_banner.settings.image_ratio.options.landscape" }, { "value": "wide", "label": "t:sections.collection_banner.settings.image_ratio.options.wide" }] },
    { "type": "select", "id": "content_alignment", "label": "t:sections.collection_banner.settings.content_alignment.label", "default": "left", "options": [{ "value": "left", "label": "t:sections.collection_banner.settings.content_alignment.options.left" }, { "value": "center", "label": "t:sections.collection_banner.settings.content_alignment.options.center" }, { "value": "right", "label": "Right" }] },
    { "type": "checkbox", "id": "enable_overlay", "label": "Add a media overlay", "default": false },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 80, "step": 5, "default": 25, "unit": "%" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.collection_banner.settings.color_scheme.label", "default": "scheme-1" }
  ]
}
{% endschema %}
