# Reference only. The released production Dev Dashboard values remain the
# authority until app.calinium.com is deployed.
name = "Calinium"
client_id = "REPLACE_WITH_SHOPIFY_DEV_DASHBOARD_CLIENT_ID"
application_url = "https://app.calinium.com"
embedded = true

[access_scopes]
scopes = "read_content,read_files,read_markets,read_online_store_navigation,read_products,read_themes"
use_legacy_install_flow = false

[auth]
redirect_urls = [ "https://app.calinium.com/api/shopify/oauth/callback" ]

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
topics = [ "app/uninstalled", "app/scopes_update", "themes/delete" ]
uri = "/api/shopify/webhooks"

[[webhooks.subscriptions]]
compliance_topics = [ "customers/data_request", "customers/redact", "shop/redact" ]
uri = "/api/shopify/webhooks"
