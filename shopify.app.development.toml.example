# Copy to shopify.app.development.toml only after linking the existing Calinium
# app in the Shopify Dev Dashboard. The real client ID is an environment value
# and must never be committed.
name = "Calinium"
client_id = "REPLACE_WITH_SHOPIFY_DEV_DASHBOARD_CLIENT_ID"
application_url = "https://YOUR-SHOPIFY-CLI-URL"
embedded = true
web_directories = [ "apps/dashboard" ]

[access_scopes]
scopes = "read_content,read_files,read_markets,read_online_store_navigation,read_products,read_themes"
use_legacy_install_flow = false

[auth]
redirect_urls = [ "https://YOUR-SHOPIFY-CLI-URL/api/shopify/oauth/callback" ]

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
topics = [ "app/uninstalled", "app/scopes_update", "themes/delete" ]
uri = "/api/shopify/webhooks"

[build]
automatically_update_urls_on_dev = true
