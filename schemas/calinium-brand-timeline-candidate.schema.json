{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-brand-timeline-candidate.schema.json",
  "title": "Calinium Brand Timeline Candidate Plan",
  "description": "Mutable, project-scoped review state for merchant-confirmed chronology. It is never a generated history or an Approved Block Plan revision.",
  "type": "object", "additionalProperties": false,
  "required": ["version", "status", "candidate_version", "milestones", "warnings", "updated_at"],
  "properties": {"version":{"type":"integer","const":1},"status":{"type":"string","enum":["not_required","draft","approved"]},"candidate_version":{"type":"integer","minimum":0},"milestones":{"type":"array","maxItems":12,"items":{"$ref":"#/$defs/item"}},"warnings":{"type":"array","items":{"type":"string","minLength":1,"maxLength":240}},"updated_at":{"type":"string","minLength":1}},
  "$defs": {"item":{"type":"object","additionalProperties":false,"required":["content_id","placement_id","date","title","text","timeline_icon","image_asset_id","image_alt_text","decorative_media","evidence_note","order"],"properties":{"content_id":{"type":"string","pattern":"^abpc_[a-z0-9][a-z0-9_-]*$"},"placement_id":{"type":"string","pattern":"^abpl_[a-z0-9][a-z0-9_-]*$"},"date":{"type":"string","maxLength":80},"title":{"type":"string","maxLength":240},"text":{"type":"string","maxLength":1200},"timeline_icon":{"type":"string","enum":["none","sparkle","star","calendar","arrow-right"]},"image_asset_id":{"type":["string","null"],"minLength":1,"maxLength":240},"image_alt_text":{"type":["string","null"],"maxLength":500},"decorative_media":{"type":"boolean"},"evidence_note":{"type":"string","maxLength":1200},"order":{"type":"integer","minimum":1}}}}
}
