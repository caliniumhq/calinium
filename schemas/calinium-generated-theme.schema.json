{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-generated-theme.schema.json",
  "title": "Calinium generated theme manifest",
  "description": "Traceable manifest for Shopify configuration generated exclusively in an isolated review workspace.",
  "type": "object",
  "required": ["version", "generator_version", "generation_id", "draft_version", "source_strategy_version", "generation_timestamp", "compatibility_version", "approval", "approved_block_plan_provenance", "approved_preset_provenance", "approved_recommendation_provenance", "approved_design_dna_provenance", "architecture_selection", "preset_application", "design_dna_application", "workspace", "generated_files", "generated_section_instances", "generated_settings", "merchant_references", "validation_status", "warnings", "unsupported_items"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "generator_version": {"type": "string", "const": "1.0.0"},
    "generation_id": {"type": "string", "pattern": "^generation-run-[a-z0-9-]+$"},
    "draft_version": {"type": "integer", "const": 1},
    "source_strategy_version": {"type": "integer", "const": 1},
    "generation_timestamp": {"type": "string", "minLength": 1},
    "compatibility_version": {"type": "string", "const": "1.0.0"},
    "approval": {"type": "object", "required": ["approval_id", "approval_reference"], "properties": {"approval_id": {"type": "string", "minLength": 1}, "approval_reference": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "approved_block_plan_provenance": {"type": ["object", "null"], "properties": {"plan_id": {"type": "string", "minLength": 1}, "revision_id": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1}, "parent_revision_id": {"type": ["string", "null"]}, "plan_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "resource_snapshot_id": {"type": "string", "minLength": 1}, "resource_snapshot_revision_id": {"type": "string", "minLength": 1}, "resource_snapshot_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "approval_id": {"type": "string", "minLength": 1}, "approval_reference": {"type": "string", "minLength": 1}, "approval_revision_id": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "minLength": 1}, "organization_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "merchant_scope_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "approved_preset_provenance": {"type": ["object", "null"], "additionalProperties": false, "properties": {"revision_id": {"type": "string"}, "preset_id": {"type": "string"}, "preset_version": {"type": "string"}, "catalog_version": {"type": "string"}, "selection_source": {"type": "string"}, "approval_reference": {"type": "string"}, "approved_at": {"type": "string"}, "strategy_revision": {"type": "string"}, "compatibility_result": {"type": "object"}, "fallback": {"type": ["object", "null"]}, "target_theme": {"type": "object"}, "preset_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "approved_recommendation_provenance": {"$ref": "#/$defs/recommendationProvenance"},
    "approved_design_dna_provenance": {"$ref": "#/$defs/designDnaProvenance"},
    "architecture_selection": {"$ref": "#/$defs/architectureProvenance"},
    "preset_application": {"type": ["object", "null"], "additionalProperties": false, "properties": {"recipe": {"type": "string"}, "section_order": {"type": "array", "items": {"type": "string"}}, "applied_global_setting_keys": {"type": "array", "items": {"type": "string"}}, "applied_section_default_keys": {"type": "array", "items": {"type": "string"}}, "omissions": {"type": "array", "items": {"type": "object"}}, "fallbacks": {"type": "array", "items": {"type": "object"}}}},
    "design_dna_application": {"type": ["object", "null"], "additionalProperties": false, "required": ["applied_global_setting_keys", "applied_section_setting_keys"], "properties": {"applied_global_setting_keys": {"type": "array", "items": {"type": "string"}}, "applied_section_setting_keys": {"type": "array", "items": {"type": "string"}}}},
    "workspace": {"type": "string", "minLength": 1},
    "generated_files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "generated_section_instances": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "generated_settings": {"type": "array", "items": {"$ref": "#/$defs/setting"}},
    "merchant_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "validation_status": {"$ref": "#/$defs/status"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "unsupported_items": {"type": "array", "items": {"$ref": "#/$defs/unsupported"}}
  },
  "$defs": {
    "trace": {"type": "object", "required": ["source_draft", "source_mapping", "compiler_decision", "reasoning", "confidence", "approval_reference"], "properties": {"source_draft": {"type": "string", "minLength": 1}, "source_mapping": {"type": ["string", "null"]}, "compiler_decision": {"type": ["string", "null"]}, "reasoning": {"type": "string", "minLength": 1}, "confidence": {"type": "string", "enum": ["high", "medium", "low", "unresolved"]}, "approval_reference": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "file": {"type": "object", "required": ["path", "kind", "trace"], "properties": {"path": {"type": "string", "pattern": "^(theme/(templates|config)/|reports/|manifests/)"}, "kind": {"type": "string", "enum": ["template", "settings", "report", "manifest"]}, "trace": {"$ref": "#/$defs/trace"}}, "additionalProperties": false},
    "section": {"type": "object", "required": ["template", "instance_id", "section_id", "position", "origin", "trace"], "properties": {"template": {"type": "string", "pattern": "^templates/.+\\.json$"}, "instance_id": {"type": "string", "minLength": 1}, "section_id": {"type": "string", "minLength": 1}, "position": {"type": "integer", "minimum": 1}, "origin": {"type": "string", "enum": ["generated", "preserved"]}, "trace": {"$ref": "#/$defs/trace"}}, "additionalProperties": false},
    "setting": {"type": "object", "required": ["setting_id", "value", "origin", "trace"], "properties": {"setting_id": {"type": "string", "minLength": 1}, "value": {}, "origin": {"type": "string", "enum": ["draft", "approval", "preserved"]}, "trace": {"$ref": "#/$defs/trace"}}, "additionalProperties": false},
    "reference": {"type": "object", "required": ["reference_id", "value", "trace"], "properties": {"reference_id": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "trace": {"$ref": "#/$defs/trace"}}, "additionalProperties": false},
    "status": {"type": "object", "required": ["valid", "errors", "warnings"], "properties": {"valid": {"type": "boolean"}, "errors": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "unsupported": {"type": "object", "required": ["id", "reason", "trace"], "properties": {"id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "trace": {"$ref": "#/$defs/trace"}}, "additionalProperties": false},
    "recommendationProvenance": {"type": ["object", "null"], "additionalProperties": false, "required": ["revision_id", "candidate_revision_id", "approval_checksum"], "properties": {"revision_id": {"type": "string", "minLength": 1}, "candidate_revision_id": {"type": "string", "minLength": 1}, "approval_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "designDnaProvenance": {"type": ["object", "null"], "additionalProperties": false, "required": ["revision_id", "candidate_revision_id", "recommendation_approval_revision_id", "engine_version", "preset_id", "approval_reference", "approved_at", "approval_checksum"], "properties": {"revision_id": {"type": "string", "minLength": 1}, "candidate_revision_id": {"type": "string", "minLength": 1}, "recommendation_approval_revision_id": {"type": "string", "minLength": 1}, "engine_version": {"type": "string", "pattern": "^design-dna-v[0-9]+$"}, "preset_id": {"type": "string", "enum": ["atelier", "maison", "gallery", "ritual", "essential", "signal"]}, "approval_reference": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "minLength": 1}, "approval_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "architectureProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_revision_id", "profile_id", "profile_schema_version", "profile_version", "selected_families", "selection_source", "selection_reason", "eligibility_result", "fit_result", "material_question", "store_intelligence_revision", "merchant_intent_revision", "compatibility_result", "fallback"],
      "properties": {
        "selection_revision_id": {"type": "string", "pattern": "^architecture-selection-[a-f0-9]{20}$"},
        "profile_id": {"type": "string", "pattern": "^profile\\.[a-z0-9_]+\\.v[0-9]+$"},
        "profile_schema_version": {"type": "string", "const": "1.0"},
        "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "selected_families": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["family", "family_id", "family_version"], "properties": {"family": {"type": "string"}, "family_id": {"type": "string"}, "family_version": {"type": "string"}}}},
        "selection_source": {"type": "string", "enum": ["default_fallback", "explicit_profile", "automatic_policy", "conservative_fallback"]},
        "selection_reason": {"type": "object", "additionalProperties": false, "required": ["codes", "summary"], "properties": {"codes": {"type": "array", "items": {"type": "string"}}, "summary": {"type": "string", "minLength": 1}}},
        "eligibility_result": {"type": "object", "additionalProperties": false, "required": ["eligible", "evaluator_version", "required_signals", "missing_signals"], "properties": {"eligible": {"type": "boolean", "const": true}, "evaluator_version": {"type": "string", "enum": ["architecture-eligibility-v1", "architecture-eligibility-v2"]}, "required_signals": {"type": "array", "items": {"type": "string"}}, "missing_signals": {"type": "array", "maxItems": 0, "items": {"type": "string"}}}},
        "fit_result": {"type": "object", "additionalProperties": false, "required": ["evaluator_version", "candidate_count", "rank", "score", "reason_codes"], "properties": {"evaluator_version": {"type": "string", "enum": ["architecture-fit-v1", "architecture-fit-v2"]}, "candidate_count": {"type": "integer", "minimum": 1}, "rank": {"type": "integer", "const": 1}, "score": {"type": "number"}, "confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
        "material_question": {"type": "null"},
        "store_intelligence_revision": {"type": ["string", "null"]},
        "merchant_intent_revision": {"type": "string", "pattern": "^merchant-intent-[a-f0-9]{20}$"},
        "compatibility_result": {"type": "object", "additionalProperties": false, "required": ["valid", "solver_version", "checked_capabilities", "errors"], "properties": {"valid": {"type": "boolean", "const": true}, "solver_version": {"type": "string", "const": "architecture-compatibility-v1"}, "checked_capabilities": {"type": "array", "items": {"type": "string"}}, "errors": {"type": "array", "maxItems": 0, "items": {"type": "string"}}}},
        "fallback": {"type": ["object", "null"], "additionalProperties": false, "required": ["applied", "reason", "profile_id"], "properties": {"applied": {"type": "boolean", "const": true}, "reason": {"type": "string", "enum": ["profile_unspecified", "signals_insufficient", "question_unavailable", "exact_tie_after_known_intent"]}, "profile_id": {"type": "string"}}},
        "automatic_policy": {"type": "object", "required": ["policy_revision", "selection_mode", "signal_derivation_revision", "selection_confidence", "candidate_results", "ambiguity_result", "input_bindings", "observed_signal_paths", "safety"], "properties": {"policy_revision": {"type": "string", "const": "architecture-selection-policy-v1"}, "selection_mode": {"type": "string", "const": "automatic_beta"}, "signal_derivation_revision": {"type": "string", "const": "architecture-store-signal-derivation-v1"}, "selection_confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "candidate_results": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "calinium-architecture-selection-outcome.schema.json#/$defs/candidate"}}, "ambiguity_result": {"$ref": "calinium-architecture-selection-outcome.schema.json#/$defs/ambiguity"}, "input_bindings": {"$ref": "calinium-architecture-selection-outcome.schema.json#/$defs/inputBindings"}, "observed_signal_paths": {"type": "object", "required": ["store_intelligence", "merchant_intent"], "properties": {"store_intelligence": {"type": "array", "items": {"type": "string"}}, "merchant_intent": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}, "safety": {"$ref": "calinium-architecture-selection-outcome.schema.json#/$defs/safety"}}, "additionalProperties": false},
        "material_clarification": {"$ref": "calinium-architecture-material-clarification.schema.json"}
      }
    }
  },
  "additionalProperties": false
}
