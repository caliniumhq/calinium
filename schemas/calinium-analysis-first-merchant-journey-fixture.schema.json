{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-analysis-first-merchant-journey-fixture.schema.json",
  "title": "Calinium analysis-first merchant-journey fixture",
  "type": "object",
  "required": ["fixture_revision", "project_binding", "merchant_context", "session_revision", "commercial", "build_eligibility", "cases"],
  "properties": {
    "fixture_revision": {"const": "analysis-first-merchant-journey-fixture-v1"},
    "project_binding": {"type": "object", "required": ["project_id", "organization_id", "shop"], "properties": {"project_id": {"type": "string"}, "organization_id": {"type": "string"}, "shop": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.myshopify\\.com$"}}, "additionalProperties": false},
    "merchant_context": {"type": "object", "required": ["project_id", "store_id", "merchant_id"], "properties": {"project_id": {"type": "string"}, "store_id": {"type": "string"}, "merchant_id": {"type": "string"}}, "additionalProperties": false},
    "session_revision": {"type": "string", "minLength": 1},
    "commercial": {"type": "object", "required": ["status", "paid_generation_required", "revision"], "properties": {"status": {"enum": ["known", "pending", "not_required", "unavailable"]}, "paid_generation_required": {"type": "boolean"}, "revision": {"type": ["string", "null"]}}, "additionalProperties": false},
    "build_eligibility": {"type": "object", "required": ["analysis_complete", "direction_resolved", "architecture_ready", "mandatory_fact_resolved", "project_shop_authority_valid", "resource_content_eligible", "commercial_boundary_known", "no_conflicting_active_flow"], "properties": {"analysis_complete": {"type": "boolean"}, "direction_resolved": {"type": "boolean"}, "architecture_ready": {"type": "boolean"}, "mandatory_fact_resolved": {"type": "boolean"}, "project_shop_authority_valid": {"type": "boolean"}, "resource_content_eligible": {"type": "boolean"}, "commercial_boundary_known": {"type": "boolean"}, "no_conflicting_active_flow": {"type": "boolean"}}, "additionalProperties": false},
    "cases": {"type": "array", "minItems": 16, "items": {"type": "object", "required": ["id", "session_stage", "expected_stage", "expected_briefing", "expected_primary"], "properties": {"id": {"type": "string", "pattern": "^[a-p]_[a-z0-9_]+$"}, "source_case": {"type": "string"}, "inference_only": {"type": "boolean"}, "explicit_direction": {"enum": ["current_calinium", "editorial_discovery"]}, "material_question": {"type": "boolean"}, "hard_ineligible_direction": {"enum": ["visual_story_led", "direct_efficient"]}, "essential_question": {"enum": ["products", "audience", "goal"]}, "selection_blocked": {"type": "boolean"}, "session_stage": {"type": "string"}, "flow_state": {"type": "string"}, "previous_flow_state": {"type": "string"}, "flow_sequence": {"type": "integer", "minimum": 0}, "failure_category": {"type": "string"}, "failure_retryable": {"type": "boolean"}, "expected_stage": {"enum": ["analyzing_store", "building_storefront", "review_preview"]}, "expected_briefing": {"enum": ["analyzing", "recommendation_ready", "direction_choice_required", "essential_detail_required", "blocked", "accepted", "superseded", "build_in_progress", "preview_ready"]}, "expected_direction": {"enum": ["visual_story_led", "direct_efficient"]}, "expected_primary": {"type": ["string", "null"]}, "expected_option_count": {"type": "integer", "minimum": 0, "maximum": 2}, "expected_headline": {"type": "string"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
