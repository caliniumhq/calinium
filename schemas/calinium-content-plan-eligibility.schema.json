{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-content-plan-eligibility.schema.json",
  "title": "Calinium omission-aware content-plan eligibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "materialization_revision",
    "input_checksum",
    "effective_composition",
    "targets",
    "global_blockers",
    "summary",
    "stage_resolution",
    "reconciliation_history",
    "scope_binding",
    "classified_at",
    "revision_id",
    "checksum"
  ],
  "properties": {
    "policy_version": {"const": "content-plan-eligibility-v1"},
    "materialization_revision": {"const": "content-plan-materialization-v1"},
    "input_checksum": {"$ref": "#/$defs/checksum"},
    "effective_composition": {"$ref": "#/$defs/effectiveComposition"},
    "targets": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/target"}
    },
    "global_blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/globalBlocker"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "stage_resolution": {"$ref": "#/$defs/stageResolution"},
    "reconciliation_history": {
      "type": "array",
      "items": {"$ref": "#/$defs/reconciliation"}
    },
    "scope_binding": {"$ref": "#/$defs/scopeBinding"},
    "classified_at": {"type": "string", "format": "date-time"},
    "revision_id": {"type": "string", "pattern": "^cpe_[a-f0-9]{32}$"},
    "checksum": {"$ref": "#/$defs/checksum"}
  },
  "$defs": {
    "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableChecksum": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "nullableString": {"type": ["string", "null"], "minLength": 1},
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "checksumArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/checksum"}
    },
    "moduleId": {
      "enum": [
        "editorial-grid",
        "lookbook",
        "craftsmanship",
        "manufacturing-process",
        "brand-timeline",
        "sustainability",
        "team",
        "awards-certifications",
        "cross-sell-products",
        "product-bundle-showcase",
        "shop-the-look",
        "complementary-products"
      ]
    },
    "targetKey": {
      "enum": [
        "editorial_grid",
        "lookbook",
        "craftsmanship",
        "manufacturing_process",
        "brand_timeline",
        "sustainability",
        "team",
        "awards_certifications",
        "cross_sell_products",
        "product_bundle_showcase",
        "shop_the_look",
        "complementary_products_fallback"
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_role", "module_id", "instance_id", "ordinal"],
      "properties": {
        "page_role": {"enum": ["homepage", "productPage", "collectionPage", "standardPage"]},
        "module_id": {"type": "string", "minLength": 1},
        "instance_id": {"$ref": "#/$defs/nullableString"},
        "ordinal": {"type": "integer", "minimum": 1}
      }
    },
    "excludedModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "state",
        "actor",
        "confirmation_ids",
        "policy_item_checksums",
        "decision_checksums"
      ],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["omitted_by_policy", "merchant_omitted"]},
        "actor": {"enum": ["system_policy", "merchant"]},
        "confirmation_ids": {"$ref": "#/$defs/stringArray"},
        "policy_item_checksums": {"$ref": "#/$defs/checksumArray"},
        "decision_checksums": {"$ref": "#/$defs/checksumArray"}
      }
    },
    "effectiveComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "original_preset_module_ids",
        "original_preset_placements",
        "effective_module_ids",
        "effective_placements",
        "excluded_modules",
        "preset_revision_id",
        "resource_policy_revision_id",
        "resource_policy_checksum",
        "resource_decision_revision_id",
        "resource_decision_checksum",
        "source_revision",
        "derived_at",
        "checksum"
      ],
      "properties": {
        "contract_version": {"const": "resource-resolved-effective-composition-v1"},
        "original_preset_module_ids": {"$ref": "#/$defs/stringArray"},
        "original_preset_placements": {"type": "array", "items": {"$ref": "#/$defs/placement"}},
        "effective_module_ids": {"$ref": "#/$defs/stringArray"},
        "effective_placements": {"type": "array", "items": {"$ref": "#/$defs/placement"}},
        "excluded_modules": {"type": "array", "items": {"$ref": "#/$defs/excludedModule"}},
        "preset_revision_id": {"$ref": "#/$defs/nullableString"},
        "resource_policy_revision_id": {"type": ["string", "null"], "pattern": "^rce_[a-f0-9]{32}$"},
        "resource_policy_checksum": {"$ref": "#/$defs/nullableChecksum"},
        "resource_decision_revision_id": {"type": ["string", "null"], "pattern": "^rcd_[a-f0-9]{32}$"},
        "resource_decision_checksum": {"$ref": "#/$defs/nullableChecksum"},
        "source_revision": {"type": "string", "minLength": 1},
        "derived_at": {"type": "string", "format": "date-time"},
        "checksum": {"$ref": "#/$defs/checksum"}
      }
    },
    "resourcePolicyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "actor", "confirmation_ids", "policy_item_checksums", "decision_checksums"],
      "properties": {
        "state": {"enum": ["omitted_by_policy", "merchant_omitted", "retained_by_resource_policy", "not_applicable"]},
        "actor": {"enum": ["system_policy", "merchant"]},
        "confirmation_ids": {"$ref": "#/$defs/stringArray"},
        "policy_item_checksums": {"$ref": "#/$defs/checksumArray"},
        "decision_checksums": {"$ref": "#/$defs/checksumArray"}
      }
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation_id", "source_section", "dependent_modules", "omission_scope", "omission_target", "classification", "policy_state", "decision_state", "decision_actor", "policy_item_checksum", "decision_checksum"],
      "properties": {
        "confirmation_id": {"type": "string", "minLength": 1},
        "source_section": {"$ref": "#/$defs/nullableString"},
        "dependent_modules": {"$ref": "#/$defs/stringArray"},
        "omission_scope": {"enum": ["module", "field", null]},
        "omission_target": {"$ref": "#/$defs/nullableString"},
        "classification": {"enum": ["auto_verifiable", "merchant_confirmation_required", "optional_omittable", "critical_confirmation_required", "unresolved_review_required"]},
        "policy_state": {"enum": ["verified_automatically", "awaiting_confirmation", "omitted_by_policy", "unresolved_review_required"]},
        "decision_state": {"enum": ["verified_automatically", "awaiting_confirmation", "merchant_confirmed", "omitted_by_policy", "merchant_omitted", "unresolved_review_required"]},
        "decision_actor": {"enum": ["merchant", "system", "system_policy"]},
        "policy_item_checksum": {"$ref": "#/$defs/checksum"},
        "decision_checksum": {"$ref": "#/$defs/nullableChecksum"}
      }
    },
    "dependentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "supported_page_roles", "approved_block_page_role", "section_roles", "effective_placements", "resource_bindings"],
      "properties": {
        "module_id": {"$ref": "#/$defs/moduleId"},
        "supported_page_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["homepage", "productPage", "collectionPage", "standardPage"]}},
        "approved_block_page_role": {"enum": ["homepage", "product_page", "collection_page", "standard_page"]},
        "section_roles": {"$ref": "#/$defs/stringArray"},
        "effective_placements": {"type": "array", "items": {"$ref": "#/$defs/placement"}},
        "resource_bindings": {"type": "array", "items": {"$ref": "#/$defs/resourceBinding"}}
      }
    },
    "itemCounts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "stories": {"type": "integer", "minimum": 0},
        "frames": {"type": "integer", "minimum": 0},
        "steps": {"type": "integer", "minimum": 0},
        "milestones": {"type": "integer", "minimum": 0},
        "initiatives": {"type": "integer", "minimum": 0},
        "members": {"type": "integer", "minimum": 0},
        "recognitions": {"type": "integer", "minimum": 0},
        "products": {"type": "integer", "minimum": 0}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "raw_status",
        "candidate_version",
        "item_counts",
        "scalar_content_present",
        "approved_for_target",
        "warnings_present",
        "merchant_or_approved_content_present",
        "progressed_beyond_initial_empty_draft",
        "already_not_required",
        "safe_automatic_not_required_transition",
        "fingerprint"
      ],
      "properties": {
        "status": {"enum": ["not_required", "draft", "approved"]},
        "raw_status": {"enum": ["not_required", "draft", "approved"]},
        "candidate_version": {"type": "integer", "minimum": 0},
        "item_counts": {"$ref": "#/$defs/itemCounts"},
        "scalar_content_present": {"type": "boolean"},
        "approved_for_target": {"type": "boolean"},
        "warnings_present": {"type": "boolean"},
        "merchant_or_approved_content_present": {"type": "boolean"},
        "progressed_beyond_initial_empty_draft": {"type": "boolean"},
        "already_not_required": {"type": "boolean"},
        "safe_automatic_not_required_transition": {"type": "boolean"},
        "fingerprint": {"$ref": "#/$defs/checksum"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_key",
        "module_id",
        "merchant_label",
        "original_preset_module",
        "effective_composition_status",
        "resource_policy_decision",
        "dependent_identity",
        "eligibility_state",
        "actionable",
        "blocked",
        "reason",
        "candidate",
        "blocker_confirmation_ids",
        "policy_version",
        "source_revision",
        "actor",
        "classified_at",
        "checksum"
      ],
      "properties": {
        "target_key": {"$ref": "#/$defs/targetKey"},
        "module_id": {"$ref": "#/$defs/moduleId"},
        "merchant_label": {
          "enum": [
            "Editorial Grid",
            "Lookbook",
            "Craftsmanship",
            "Manufacturing Process",
            "Brand Timeline",
            "Sustainability",
            "Team",
            "Awards and Certifications",
            "Cross-sell Products",
            "Product Bundle Showcase",
            "Shop the Look",
            "Complementary Products fallback"
          ]
        },
        "original_preset_module": {"type": "boolean"},
        "effective_composition_status": {"enum": ["selected", "omitted", "not_selected"]},
        "resource_policy_decision": {"$ref": "#/$defs/resourcePolicyDecision"},
        "dependent_identity": {"$ref": "#/$defs/dependentIdentity"},
        "eligibility_state": {
          "enum": [
            "action_required",
            "ready_from_authoritative_content",
            "not_required_omitted_by_policy",
            "not_required_not_selected",
            "blocked_critical_confirmation",
            "unresolved_review_required"
          ]
        },
        "actionable": {"type": "boolean"},
        "blocked": {"type": "boolean"},
        "reason": {
          "enum": [
            "preserved_merchant_or_approved_content_requires_review",
            "critical_resource_confirmation_required",
            "resource_eligibility_unresolved",
            "approved_content_provenance_missing",
            "unsupported_effective_placement",
            "omitted_by_policy",
            "merchant_omitted",
            "module_not_selected_in_effective_composition",
            "approved_content_plan_available",
            "selected_module_requires_content_work"
          ]
        },
        "candidate": {"$ref": "#/$defs/candidate"},
        "blocker_confirmation_ids": {"$ref": "#/$defs/stringArray"},
        "policy_version": {"const": "content-plan-eligibility-v1"},
        "source_revision": {"type": "string", "minLength": 1},
        "actor": {"enum": ["system_policy", "merchant", "operator"]},
        "classified_at": {"type": "string", "format": "date-time"},
        "checksum": {"$ref": "#/$defs/checksum"}
      }
    },
    "globalBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation_id", "classification", "state", "policy_item_checksum"],
      "properties": {
        "confirmation_id": {"type": "string", "minLength": 1},
        "classification": {"enum": ["auto_verifiable", "merchant_confirmation_required", "optional_omittable", "critical_confirmation_required", "unresolved_review_required"]},
        "state": {
          "enum": [
            "verified_automatically",
            "awaiting_confirmation",
            "merchant_confirmed",
            "omitted_by_policy",
            "merchant_omitted",
            "unresolved_review_required"
          ]
        },
        "policy_item_checksum": {"$ref": "#/$defs/checksum"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_targets", "actionable_count", "ready_count", "omitted_count", "not_selected_count", "blocked_count"],
      "properties": {
        "total_targets": {"const": 12},
        "actionable_count": {"type": "integer", "minimum": 0, "maximum": 12},
        "ready_count": {"type": "integer", "minimum": 0, "maximum": 12},
        "omitted_count": {"type": "integer", "minimum": 0, "maximum": 12},
        "not_selected_count": {"type": "integer", "minimum": 0, "maximum": 12},
        "blocked_count": {"type": "integer", "minimum": 0}
      }
    },
    "stageResolution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "reason", "actor", "resolved_at", "reference"],
      "properties": {
        "status": {"const": "resolved"},
        "reason": {"const": "zero_actionable_content_plans"},
        "actor": {"const": "system_policy"},
        "resolved_at": {"type": "string", "format": "date-time"},
        "reference": {"type": "string", "pattern": "^cpsr_[a-f0-9]{24}$"}
      }
    },
    "scopeBinding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["project_id", "shop"],
      "properties": {
        "project_id": {"$ref": "#/$defs/nullableString"},
        "shop": {"$ref": "#/$defs/nullableString"}
      }
    },
    "transitionOldState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate_version", "item_counts", "fingerprint"],
      "properties": {
        "status": {"enum": ["not_required", "draft", "approved"]},
        "candidate_version": {"type": "integer", "minimum": 0},
        "item_counts": {"$ref": "#/$defs/itemCounts"},
        "fingerprint": {"$ref": "#/$defs/checksum"}
      }
    },
    "transitionNewState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate_version", "item_counts"],
      "properties": {
        "status": {"const": "not_required"},
        "candidate_version": {"type": "integer", "minimum": 1},
        "item_counts": {"$ref": "#/$defs/itemCounts"}
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_key",
        "module_id",
        "old_state",
        "new_state",
        "reason",
        "actor",
        "reconciled_at",
        "policy_version",
        "effective_composition_checksum",
        "resource_policy_revision_id",
        "resource_policy_checksum",
        "reconciliation_id"
      ],
      "properties": {
        "target_key": {"$ref": "#/$defs/targetKey"},
        "module_id": {"$ref": "#/$defs/moduleId"},
        "old_state": {"$ref": "#/$defs/transitionOldState"},
        "new_state": {"$ref": "#/$defs/transitionNewState"},
        "reason": {"enum": ["omitted_by_policy", "not_selected"]},
        "actor": {"const": "system_policy"},
        "reconciled_at": {"type": "string", "format": "date-time"},
        "policy_version": {"const": "content-plan-eligibility-v1"},
        "effective_composition_checksum": {"$ref": "#/$defs/checksum"},
        "resource_policy_revision_id": {"type": ["string", "null"], "pattern": "^rce_[a-f0-9]{32}$"},
        "resource_policy_checksum": {"$ref": "#/$defs/nullableChecksum"},
        "reconciliation_id": {"type": "string", "pattern": "^cpr_[a-f0-9]{24}$"}
      }
    }
  }
}
