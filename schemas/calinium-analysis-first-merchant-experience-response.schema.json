{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-analysis-first-merchant-experience-response.schema.json",
  "title": "Calinium F1-B sanitized experience response",
  "type": "object",
  "required": ["contract_version", "eligible", "fallback", "projection", "projection_key", "action_bindings", "preview_link"],
  "properties": {
    "contract_version": {"const": "analysis-first-merchant-experience-response-v1"},
    "eligible": {"type": "boolean"},
    "fallback": {"type": ["string", "null"], "enum": ["existing_interface", null]},
    "projection": {"oneOf": [{"type": "null"}, {"$ref": "calinium-analysis-first-merchant-projection.schema.json"}]},
    "projection_key": {"type": ["string", "null"], "pattern": "^f1b_[A-Za-z0-9_-]{43}$"},
    "action_bindings": {
      "type": "object",
      "properties": {"choose_direction": {"type": "string", "pattern": "^f1b_[A-Za-z0-9_-]{43}$"}},
      "additionalProperties": false
    },
    "preview_link": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["label", "url"],
          "properties": {
            "label": {"const": "Open Calinium preview"},
            "url": {"type": "string", "format": "uri", "pattern": "^https://"}
          },
          "additionalProperties": false
        }
      ]
    },
    "preview_availability": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["available", "preparing", "needs_attention", "not_applicable"]}},
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"eligible": {"const": true}}},
      "then": {"properties": {"fallback": {"type": "null"}, "projection": {"$ref": "calinium-analysis-first-merchant-projection.schema.json"}, "projection_key": {"type": "string"}}}
    },
    {
      "if": {"properties": {"eligible": {"const": false}}},
      "then": {"properties": {"fallback": {"const": "existing_interface"}, "projection": {"type": "null"}, "projection_key": {"type": "null"}}}
    }
  ],
  "additionalProperties": false
}
