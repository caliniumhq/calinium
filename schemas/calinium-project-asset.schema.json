{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.example/schemas/calinium-project-asset.schema.json",
  "title": "Calinium project asset",
  "description": "Organization- and project-scoped metadata for a merchant-provided file. The file itself is held by a storage provider, never in a relational database field.",
  "type": "object",
  "required": ["version", "id", "organization_id", "project_id", "asset_type", "display_title", "original_filename", "safe_filename", "mime_type", "size_bytes", "checksum_sha256", "storage_key", "upload_status", "source_type", "processing_state", "width", "height", "alt_text", "notes", "created_by_user_id", "created_at", "updated_at", "deleted_at"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^ast_[a-z0-9-]+$"},
    "organization_id": {"type": "string", "pattern": "^org_[a-z0-9-]+$"},
    "project_id": {"type": "string", "pattern": "^prj_[a-z0-9-]+$"},
    "asset_type": {"type": "string", "enum": ["logo", "alternate_logo", "favicon", "brand_guidelines", "font_reference", "product_image", "lifestyle_image", "campaign_image", "video", "inspiration_screenshot", "competitor_screenshot", "miscellaneous_reference"]},
    "display_title": {"type": "string", "minLength": 1, "maxLength": 160},
    "original_filename": {"type": "string", "minLength": 1, "maxLength": 255},
    "safe_filename": {"type": "string", "pattern": "^[a-z0-9-]+\\.(png|jpe?g|webp|pdf|mp4|webm)$"},
    "mime_type": {"type": "string", "enum": ["image/png", "image/jpeg", "image/webp", "application/pdf", "video/mp4", "video/webm"]},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 26214400},
    "checksum_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "storage_key": {"type": "string", "pattern": "^organizations/[a-z0-9_-]+/projects/[a-z0-9_-]+/[a-z0-9_-]+/[a-z0-9-]+\\.(png|jpe?g|webp|pdf|mp4|webm)$"},
    "upload_status": {"type": "string", "enum": ["ready", "failed", "deleted"]},
    "source_type": {"type": "string", "enum": ["merchant_upload", "merchant_reference"]},
    "processing_state": {"type": "string", "enum": ["ready", "pending", "failed"]},
    "width": {"type": ["integer", "null"], "minimum": 1},
    "height": {"type": ["integer", "null"], "minimum": 1},
    "alt_text": {"type": ["string", "null"], "maxLength": 500},
    "notes": {"type": ["string", "null"], "maxLength": 2000},
    "created_by_user_id": {"type": "string", "pattern": "^usr_[a-z0-9-]+$"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "deleted_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
