{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-architecture-selection-outcome.schema.json",
  "title": "Calinium Core 2.0 automatic architecture material-question outcome",
  "type": "object",
  "required": ["schema_version", "selection_engine_version", "selection_policy_revision", "status", "selection_mode", "frozen", "candidate_results", "ambiguity_result", "material_question", "input_bindings", "safety", "outcome_id"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "selection_engine_version": {"type": "string", "const": "architecture-selection-v2"},
    "selection_policy_revision": {"type": "string", "const": "architecture-selection-policy-v1"},
    "status": {"type": "string", "const": "material_question_required"},
    "selection_mode": {"type": "string", "const": "automatic_beta"},
    "frozen": {"type": "boolean", "const": false},
    "candidate_results": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/candidate"}},
    "ambiguity_result": {"$ref": "#/$defs/ambiguity"},
    "material_question": {"type": "object", "required": ["topic", "intent_path", "why_it_matters", "profiles_affected", "decision_to_resolve"], "properties": {"topic": {"type": "string"}, "intent_path": {"type": "string"}, "why_it_matters": {"type": "string"}, "profiles_affected": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}, "decision_to_resolve": {"type": "string"}}, "additionalProperties": false},
    "input_bindings": {"$ref": "#/$defs/inputBindings"},
    "safety": {"$ref": "#/$defs/safety"},
    "outcome_id": {"type": "string", "pattern": "^architecture-selection-outcome-[a-f0-9]{20}$"}
  },
  "$defs": {
    "hardConstraint": {"type": "object", "required": ["id", "passed", "reason"], "properties": {"id": {"type": "string"}, "passed": {"type": "boolean"}, "reason": {"type": "string"}}, "additionalProperties": false},
    "eligibility": {"type": "object", "required": ["eligible", "evaluator_version", "required_signals", "missing_signals", "hard_constraints"], "properties": {"eligible": {"type": "boolean"}, "evaluator_version": {"type": "string", "const": "architecture-eligibility-v2"}, "required_signals": {"type": "array", "items": {"type": "string"}}, "missing_signals": {"type": "array", "items": {"type": "string"}}, "hard_constraints": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/hardConstraint"}}}, "additionalProperties": false},
    "compatibility": {"type": "object", "required": ["valid", "solver_version", "checked_capabilities", "errors"], "properties": {"valid": {"type": "boolean"}, "solver_version": {"type": "string", "const": "architecture-compatibility-v1"}, "checked_capabilities": {"type": "array", "items": {"type": "string"}}, "errors": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["signal_id", "signal_path", "observed_value", "source", "source_revision", "derivation_revision", "confidence", "impact", "weight", "reason_code"], "properties": {"signal_id": {"type": "string"}, "signal_path": {"type": "string"}, "observed_value": {}, "source": {"type": "string", "enum": ["store_intelligence", "merchant_intent"]}, "source_revision": {"type": ["string", "null"]}, "derivation_revision": {"type": "string"}, "confidence": {"type": "string", "enum": ["High", "Medium", "Low", "Unknown"]}, "impact": {"type": "string", "enum": ["low", "medium", "high"]}, "weight": {"type": "number"}, "reason_code": {"type": "string"}}, "additionalProperties": false},
    "candidate": {"type": "object", "required": ["candidate_id", "eligibility", "compatibility_result", "positive_signals", "negative_signals", "score", "rank", "confidence", "explanation"], "properties": {"candidate_id": {"type": "string"}, "eligibility": {"$ref": "#/$defs/eligibility"}, "compatibility_result": {"$ref": "#/$defs/compatibility"}, "positive_signals": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "negative_signals": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "score": {"type": "number"}, "rank": {"type": ["integer", "null"]}, "confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "explanation": {"type": "object", "required": ["summary", "leading_reason_codes"], "properties": {"summary": {"type": "string"}, "leading_reason_codes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}, "additionalProperties": false},
    "ambiguity": {"type": "object", "required": ["evaluator_version", "material", "score_margin", "threshold", "high_impact_unknowns", "changeable_by_one_answer", "reason_codes"], "properties": {"evaluator_version": {"type": "string", "const": "architecture-ambiguity-v1"}, "material": {"type": "boolean"}, "score_margin": {"type": ["number", "null"]}, "threshold": {"type": "number"}, "high_impact_unknowns": {"type": "array", "items": {"type": "string"}}, "changeable_by_one_answer": {"type": "boolean"}, "reason_codes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "inputBindings": {"type": "object", "required": ["store_intelligence_revision", "store_intelligence_checksum", "merchant_intent_revision", "merchant_intent_checksum"], "properties": {"store_intelligence_revision": {"type": ["string", "null"]}, "store_intelligence_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "merchant_intent_revision": {"type": "string", "pattern": "^merchant-intent-[a-f0-9]{20}$"}, "merchant_intent_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "safety": {"type": "object", "required": ["automatic_repair_allowed", "merchant_ui_activation", "live_theme_mutation_allowed", "maximum_material_questions"], "properties": {"automatic_repair_allowed": {"type": "boolean", "const": false}, "merchant_ui_activation": {"type": "boolean", "const": false}, "live_theme_mutation_allowed": {"type": "boolean", "const": false}, "maximum_material_questions": {"type": "integer", "const": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
