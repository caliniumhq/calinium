{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.example/schemas/creative-director-conversation-liveness.schema.json",
  "title": "Calinium Creative Director conversation liveness",
  "type": "object",
  "required": [
    "policy_version",
    "status",
    "current_question",
    "recovery_question",
    "reason"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "const": "creative-director-conversation-liveness-v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "question_required",
        "merchant_correction_available",
        "ready_to_advance",
        "explicitly_blocked",
        "invalid_actionless_state"
      ]
    },
    "current_question": {
      "anyOf": [
        { "$ref": "#/$defs/publicQuestion" },
        { "type": "null" }
      ]
    },
    "recovery_question": {
      "anyOf": [
        { "$ref": "#/$defs/publicQuestion" },
        { "type": "null" }
      ]
    },
    "reason": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "publicQuestion": {
      "type": "object",
      "required": ["question_id", "prompt"],
      "properties": {
        "question_id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
