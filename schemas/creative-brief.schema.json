{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.example/schemas/creative-brief.schema.json",
  "title": "Calinium Creative Brief",
  "description": "Calinium's structured, reviewable understanding of a merchant. Merchant-facing language may call this a Brand Blueprint.",
  "type": "object",
  "required": ["version", "business", "audience", "positioning", "brand", "goals", "content", "facts", "assumptions", "uncertainties", "confidence", "validation"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "business": {"$ref": "#/$defs/business"},
    "audience": {"$ref": "#/$defs/audience"},
    "positioning": {"$ref": "#/$defs/positioning"},
    "brand": {"$ref": "#/$defs/brand"},
    "goals": {"$ref": "#/$defs/goals"},
    "content": {"$ref": "#/$defs/content"},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "uncertainties": {"type": "array", "items": {"$ref": "#/$defs/uncertainty"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "validation": {"type": "object", "required": ["ready", "missingCriticalFacts", "warnings"], "properties": {"ready": {"type": "boolean"}, "missingCriticalFacts": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "$defs": {
    "business": {"type": "object", "required": ["name", "summary", "offer", "businessModel", "markets"], "properties": {"name": {"type": ["string", "null"]}, "summary": {"type": ["string", "null"]}, "offer": {"type": "array", "items": {"type": "string"}}, "businessModel": {"type": ["string", "null"]}, "markets": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "audience": {"type": "object", "required": ["primary", "needs", "motivations", "objections"], "properties": {"primary": {"type": ["string", "null"]}, "needs": {"type": "array", "items": {"type": "string"}}, "motivations": {"type": "array", "items": {"type": "string"}}, "objections": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "positioning": {"type": "object", "required": ["marketPosition", "valueProposition", "differentiators"], "properties": {"marketPosition": {"type": ["string", "null"]}, "valueProposition": {"type": ["string", "null"]}, "differentiators": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "brand": {"type": "object", "required": ["personality", "desiredFeeling", "existingAssets", "constraints"], "properties": {"personality": {"type": "array", "items": {"type": "string"}}, "desiredFeeling": {"type": "array", "items": {"type": "string"}}, "existingAssets": {"type": "array", "items": {"type": "string"}}, "constraints": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "goals": {"type": "object", "required": ["primary", "secondary"], "properties": {"primary": {"type": ["string", "null"]}, "secondary": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "content": {"type": "object", "required": ["available", "missing"], "properties": {"available": {"type": "array", "items": {"type": "string"}}, "missing": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "fact": {"type": "object", "required": ["path", "value", "confidence", "source"], "properties": {"path": {"type": "string"}, "value": {}, "confidence": {"type": "number", "minimum": 0.7, "maximum": 1}, "source": {"type": "string", "enum": ["merchant", "merchant_confirmation"]}}, "additionalProperties": false},
    "assumption": {"type": "object", "required": ["id", "statement", "confidence", "rationale"], "properties": {"id": {"type": "string"}, "statement": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 0.89}, "rationale": {"type": "string"}}, "additionalProperties": false},
    "uncertainty": {"type": "object", "required": ["path", "reason", "critical"], "properties": {"path": {"type": "string"}, "reason": {"type": "string"}, "critical": {"type": "boolean"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
