{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-review-session.schema.json",
  "title": "Calinium review session",
  "description": "Immutable review-session root for a generated Calinium theme workspace. Current status is derived only by replaying append-only audit events.",
  "type": "object",
  "required": ["version", "engine_version", "session_id", "generated_workspace", "generated_theme", "workspace_fingerprint", "created_at", "required_review_items", "traceability", "audit_log_directory", "validation"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "engine_version": {"type": "string", "const": "1.0.0"},
    "session_id": {"type": "string", "pattern": "^review-session-[a-z0-9-]+$"},
    "generated_workspace": {"type": "string", "minLength": 1},
    "generated_theme": {"type": "object", "required": ["generation_id", "manifest_path", "manifest_hash", "approval_reference"], "properties": {"generation_id": {"type": "string", "pattern": "^generation-run-[a-z0-9-]+$"}, "manifest_path": {"type": "string", "minLength": 1}, "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "approval_reference": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "workspace_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "required_review_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/review_item"}},
    "traceability": {"$ref": "#/$defs/traceability"},
    "audit_log_directory": {"type": "string", "pattern": "^audit$"},
    "validation": {"$ref": "#/$defs/status"}
  },
  "$defs": {
    "trace": {"type": "object", "required": ["source_draft", "source_mapping", "compiler_decision", "reasoning", "confidence", "approval_reference"], "properties": {"source_draft": {"type": "string", "minLength": 1}, "source_mapping": {"type": ["string", "null"]}, "compiler_decision": {"type": ["string", "null"]}, "reasoning": {"type": "string", "minLength": 1}, "confidence": {"type": "string", "enum": ["high", "medium", "low", "unresolved"]}, "approval_reference": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "review_item": {"type": "object", "required": ["id", "label", "required", "reasoning", "trace"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "label": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "reasoning": {"type": "string", "minLength": 1}, "trace": {"$ref": "#/$defs/trace"}}, "additionalProperties": false},
    "traceability": {"type": "object", "required": ["strategy", "draft", "mapping_references", "generated_theme"], "properties": {"strategy": {"type": "object", "required": ["version", "source"], "properties": {"version": {"type": "integer", "minimum": 1}, "source": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "draft": {"type": "object", "required": ["version", "source"], "properties": {"version": {"type": "integer", "minimum": 1}, "source": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "mapping_references": {"type": "array", "items": {"type": "string", "minLength": 1}}, "generated_theme": {"type": "object", "required": ["generation_id", "source"], "properties": {"generation_id": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "additionalProperties": false},
    "status": {"type": "object", "required": ["valid", "errors", "warnings"], "properties": {"valid": {"type": "boolean"}, "errors": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
