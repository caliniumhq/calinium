{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.example/schemas/calinium-custom-theme-price-catalog.schema.json",
  "title": "Calinium Custom Theme Price Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "products"],
  "properties": {
    "$schema": {"type": "string"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_code", "display_name", "billing_type", "prices"],
        "properties": {
          "product_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,80}$"},
          "display_name": {"type": "string", "minLength": 3, "maxLength": 160},
          "billing_type": {"const": "one_time"},
          "prices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["price_version", "amount_cents", "currency", "active", "environments"],
              "properties": {
                "price_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,80}$"},
                "amount_cents": {"type": "integer", "minimum": 1},
                "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                "active": {"type": "boolean"},
                "environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["development", "test", "staging", "production"]}}
              }
            }
          }
        }
      }
    }
  }
}
