{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-merchant-flow-render-target-succession.schema.json",
  "title": "Calinium merchant-flow render-target succession",
  "type": "object",
  "required": ["schema_version", "contract_version", "succession_revision", "succession_id", "succession_checksum", "status", "scope", "flow", "artifact", "prior_target", "successor_target", "shopify_inventory", "main_authority", "source", "readiness", "operator", "submission", "successor_job", "superseded_evidence", "safety", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "merchant-flow-render-target-succession-v1"},
    "succession_revision": {"const": "merchant-flow-render-target-succession-v1"},
    "succession_id": {"type": "string", "pattern": "^merchant-flow-render-target-succession-[a-f0-9]{20}$"},
    "succession_checksum": {"$ref": "#/$defs/checksum"},
    "status": {"const": "authorized"},
    "scope": {
      "type": "object",
      "required": ["organization_id", "project_id", "connection_id", "canonical_shop"],
      "properties": {
        "organization_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "connection_id": {"type": "string", "minLength": 1},
        "canonical_shop": {"$ref": "#/$defs/shop"}
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": ["flow_id", "expected_state", "expected_sequence", "expected_checksum"],
      "properties": {
        "flow_id": {"type": "string", "pattern": "^merchant-flow-[a-f0-9]{20}$"},
        "expected_state": {"const": "preview_ready"},
        "expected_sequence": {"type": "integer", "minimum": 0},
        "expected_checksum": {"$ref": "#/$defs/checksum"}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "artifact_checksum", "generation_id"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_checksum": {"$ref": "#/$defs/checksum"},
        "generation_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "prior_target": {
      "type": "object",
      "required": ["binding", "authority"],
      "properties": {
        "binding": {"$ref": "#/$defs/runtimeBinding"},
        "authority": {"$ref": "#/$defs/absentAuthority"}
      },
      "additionalProperties": false
    },
    "successor_target": {
      "type": "object",
      "required": ["binding", "theme_gid", "main_theme_id", "main_excluded", "authority"],
      "properties": {
        "binding": {"$ref": "#/$defs/runtimeBinding"},
        "theme_gid": {"type": "string", "pattern": "^gid://shopify/OnlineStoreTheme/[1-9][0-9]*$"},
        "main_theme_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "main_excluded": {"const": true},
        "authority": {"$ref": "#/$defs/verifiedAuthority"}
      },
      "additionalProperties": false
    },
    "shopify_inventory": {
      "type": "object",
      "required": ["authoritative_source", "completeness", "shop_domain", "connection_id", "checked_at", "theme_count", "inventory_checksum", "evidence_checksum"],
      "properties": {
        "authoritative_source": {"const": "shopify_admin_api"},
        "completeness": {"const": "complete"},
        "shop_domain": {"$ref": "#/$defs/shop"},
        "connection_id": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "format": "date-time"},
        "theme_count": {"type": "integer", "minimum": 2, "maximum": 10000},
        "inventory_checksum": {"$ref": "#/$defs/checksum"},
        "evidence_checksum": {"$ref": "#/$defs/checksum"}
      },
      "additionalProperties": false
    },
    "main_authority": {"$ref": "#/$defs/mainAuthority"},
    "source": {
      "type": "object",
      "required": ["source_revision", "build_revision", "runtime_configuration_revision", "render_target_configuration_revision", "configuration_checksum"],
      "properties": {
        "source_revision": {"$ref": "#/$defs/sourceRevision"},
        "build_revision": {"$ref": "#/$defs/sourceRevision"},
        "runtime_configuration_revision": {"type": "string", "minLength": 1},
        "render_target_configuration_revision": {"type": "string", "minLength": 1},
        "configuration_checksum": {"$ref": "#/$defs/checksum"}
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": ["snapshot_id", "snapshot_checksum", "binding_checksum", "status", "checked_at", "valid_until"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^controlled-readiness-snapshot-[a-f0-9]{20}$"},
        "snapshot_checksum": {"$ref": "#/$defs/checksum"},
        "binding_checksum": {"$ref": "#/$defs/checksum"},
        "status": {"const": "READY"},
        "checked_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "operator": {
      "type": "object",
      "required": ["actor_user_id", "role", "explicitly_allowlisted", "authorization_contract"],
      "properties": {
        "actor_user_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["owner", "administrator"]},
        "explicitly_allowlisted": {"const": true},
        "authorization_contract": {"const": "merchant-flow-operator-authorization-v1"}
      },
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": ["contract_version", "flow_id", "expected_flow_sequence", "expected_flow_checksum", "idempotency_key", "request_checksum"],
      "properties": {
        "contract_version": {"const": "merchant-flow-render-target-succession-submission-v1"},
        "flow_id": {"type": "string", "pattern": "^merchant-flow-[a-f0-9]{20}$"},
        "expected_flow_sequence": {"type": "integer", "minimum": 0},
        "expected_flow_checksum": {"$ref": "#/$defs/checksum"},
        "idempotency_key": {"type": "string", "pattern": "^merchant-flow-render-target-succession-[a-f0-9]{32}$"},
        "request_checksum": {"$ref": "#/$defs/checksum"}
      },
      "additionalProperties": false
    },
    "successor_job": {
      "type": "object",
      "required": ["job_id", "identity_checksum", "job_kind", "initial_status"],
      "properties": {
        "job_id": {"type": "string", "pattern": "^merchant-flow-job-[a-f0-9]{20}$"},
        "identity_checksum": {"$ref": "#/$defs/checksum"},
        "job_kind": {"const": "render_qa"},
        "initial_status": {"const": "queued"}
      },
      "additionalProperties": false
    },
    "superseded_evidence": {
      "type": "object",
      "required": ["status", "render", "d1", "d2_7", "d2_7_failure", "legacy_lineage_resolution", "preview_binding", "qa_review", "repair", "terminal_recovery", "merchant_action", "graph_checksum"],
      "properties": {
        "status": {"const": "historical_only"},
        "render": {
          "type": "object",
          "required": ["status", "revision", "result_ids", "checksum", "human_review_required", "request", "manifest"],
          "properties": {
            "status": {"type": "string", "minLength": 1, "maxLength": 80},
            "revision": {"type": "string", "minLength": 1, "maxLength": 160},
            "result_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
            "checksum": {"$ref": "#/$defs/checksum"},
            "human_review_required": {"type": "boolean"},
            "request": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
            "manifest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]}
          },
          "additionalProperties": false
        },
        "d1": {"$ref": "#/$defs/gateEvidence"},
        "d2_7": {"$ref": "#/$defs/gateEvidence"},
        "d2_7_failure": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
        "legacy_lineage_resolution": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
        "preview_binding": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
        "qa_review": {
          "type": "object",
          "required": ["operation_id", "decision", "evaluation", "review"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/nullableIdentifier"},
            "decision": {"type": ["string", "null"], "maxLength": 80},
            "evaluation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
            "review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]}
          },
          "additionalProperties": false
        },
        "repair": {
          "type": "object",
          "required": ["status", "repair_class", "evidence", "resolution_operation_id", "resolution_status", "plan", "plan_approval", "execution", "post_repair_qa", "final_human_review", "final_state"],
          "properties": {
            "status": {"type": ["string", "null"], "maxLength": 80},
            "repair_class": {"type": ["string", "null"], "maxLength": 80},
            "evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
            "resolution_operation_id": {"$ref": "#/$defs/nullableIdentifier"},
            "resolution_status": {"type": ["string", "null"], "maxLength": 80},
            "plan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
            "plan_approval": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
            "execution": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
            "post_repair_qa": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
            "final_human_review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
            "final_state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]}
          },
          "additionalProperties": false
        },
        "terminal_recovery": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locatableEvidence"}]},
        "merchant_action": {
          "type": "object",
          "required": ["status", "operation_reference"],
          "properties": {
            "status": {"enum": ["not_authorized", "authorized", "completed"]},
            "operation_reference": {"$ref": "#/$defs/nullableIdentifier"}
          },
          "additionalProperties": false
        },
        "graph_checksum": {"$ref": "#/$defs/checksum"}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["old_evidence_reused_as_current", "artifact_bytes_mutated", "generation_created", "purchase_created", "architecture_reselected", "design_dna_regenerated", "provider_call_made", "shopify_theme_created", "main_theme_mutated", "automatic_retry_allowed", "automatic_repair_allowed", "automatic_publish_allowed"],
      "properties": {
        "old_evidence_reused_as_current": {"const": false},
        "artifact_bytes_mutated": {"const": false},
        "generation_created": {"const": false},
        "purchase_created": {"const": false},
        "architecture_reselected": {"const": false},
        "design_dna_regenerated": {"const": false},
        "provider_call_made": {"const": false},
        "shopify_theme_created": {"const": false},
        "main_theme_mutated": {"const": false},
        "automatic_retry_allowed": {"const": false},
        "automatic_repair_allowed": {"const": false},
        "automatic_publish_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "shop": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.myshopify\\.com$"},
    "nullableIdentifier": {"type": ["string", "null"], "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "nullableEvidenceReference": {"type": ["string", "null"], "minLength": 1, "maxLength": 500, "pattern": "^(?:output|plans|fixtures)/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.json$"},
    "locatableEvidence": {
      "type": "object",
      "required": ["id", "checksum", "status", "reference"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "checksum": {"$ref": "#/$defs/checksum"},
        "status": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9_-]*$"},
        "reference": {"$ref": "#/$defs/nullableEvidenceReference"}
      },
      "additionalProperties": false
    },
    "gateEvidence": {
      "type": "object",
      "required": ["status", "id", "checksum", "reference"],
      "properties": {
        "status": {"enum": ["passed", "review_required", "failed", "not_required", "unavailable"]},
        "id": {"$ref": "#/$defs/nullableIdentifier"},
        "checksum": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/checksum"}]},
        "reference": {"$ref": "#/$defs/nullableEvidenceReference"}
      },
      "additionalProperties": false
    },
    "runtimeBinding": {
      "type": "object",
      "required": ["schema_version", "binding_revision", "runtime_configuration_revision", "render_target_configuration_revision", "project_id", "organization_id", "connection_id", "shop_domain", "theme_id", "expected_theme_role", "artifact_id", "artifact_checksum", "binding_checksum"],
      "properties": {
        "schema_version": {"const": "2.0"},
        "binding_revision": {"const": "merchant-flow-controlled-render-binding-v1"},
        "runtime_configuration_revision": {"type": "string", "minLength": 1},
        "render_target_configuration_revision": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "organization_id": {"type": "string", "minLength": 1},
        "connection_id": {"type": "string", "minLength": 1},
        "shop_domain": {"$ref": "#/$defs/shop"},
        "theme_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "expected_theme_role": {"const": "development"},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_checksum": {"$ref": "#/$defs/checksum"},
        "binding_checksum": {"$ref": "#/$defs/checksum"}
      },
      "additionalProperties": false
    },
    "absentAuthority": {
      "type": "object",
      "required": ["authoritative_source", "status", "shop_domain", "connection_id", "theme_id", "theme_gid", "checked_at", "evidence_checksum"],
      "properties": {
        "authoritative_source": {"const": "shopify_admin_api"},
        "status": {"const": "not_found"},
        "shop_domain": {"$ref": "#/$defs/shop"},
        "connection_id": {"type": "string", "minLength": 1},
        "theme_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "theme_gid": {"type": "string", "pattern": "^gid://shopify/OnlineStoreTheme/[1-9][0-9]*$"},
        "checked_at": {"type": "string", "format": "date-time"},
        "evidence_checksum": {"$ref": "#/$defs/checksum"},
        "theme_role": {"const": "development"},
        "processing": {"const": false},
        "processing_failed": {"const": false}
      },
      "additionalProperties": false
    },
    "verifiedAuthority": {
      "type": "object",
      "required": ["authoritative_source", "status", "shop_domain", "connection_id", "theme_id", "theme_gid", "theme_role", "processing", "processing_failed", "checked_at", "evidence_checksum"],
      "properties": {
        "authoritative_source": {"const": "shopify_admin_api"},
        "status": {"const": "verified"},
        "shop_domain": {"$ref": "#/$defs/shop"},
        "connection_id": {"type": "string", "minLength": 1},
        "theme_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "theme_gid": {"type": "string", "pattern": "^gid://shopify/OnlineStoreTheme/[1-9][0-9]*$"},
        "theme_role": {"const": "development"},
        "processing": {"const": false},
        "processing_failed": {"const": false},
        "checked_at": {"type": "string", "format": "date-time"},
        "evidence_checksum": {"$ref": "#/$defs/checksum"}
      },
      "additionalProperties": false
    },
    "mainAuthority": {
      "type": "object",
      "required": ["authoritative_source", "status", "shop_domain", "connection_id", "theme_id", "theme_gid", "theme_role", "processing", "processing_failed", "checked_at", "evidence_checksum"],
      "properties": {
        "authoritative_source": {"const": "shopify_admin_api"},
        "status": {"const": "verified"},
        "shop_domain": {"$ref": "#/$defs/shop"},
        "connection_id": {"type": "string", "minLength": 1},
        "theme_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "theme_gid": {"type": "string", "pattern": "^gid://shopify/OnlineStoreTheme/[1-9][0-9]*$"},
        "theme_role": {"const": "main"},
        "processing": {"type": "boolean"},
        "processing_failed": {"type": "boolean"},
        "checked_at": {"type": "string", "format": "date-time"},
        "evidence_checksum": {"$ref": "#/$defs/checksum"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
