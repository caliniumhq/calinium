{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.example/schemas/design-intelligence.schema.json",
  "title": "Calinium design intelligence shared schema",
  "$defs": {
    "id": {"type":"string","pattern":"^[a-z0-9_]+$"},
    "sectionId": {"type":"string","pattern":"^[a-z0-9-]+$"},
    "text": {"type":"string","minLength":1},
    "textArray": {"type":"array","items":{"$ref":"#/$defs/text"}},
    "idArray": {"type":"array","items":{"$ref":"#/$defs/id"}},
    "range": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":0}},
    "catalog": {"type":"object","required":["version","items"],"properties":{"version":{"type":"integer","const":1},"items":{"type":"array","minItems":1}},"additionalProperties":false},
    "designLanguage": {"type":"object","required":["id","name","description","characteristics","best_for","avoid_for","recommended_spacing","recommended_typography","recommended_motion","recommended_image_style","recommended_color_strategy","compatible_personalities","content_density"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"},"characteristics":{"$ref":"#/$defs/idArray"},"best_for":{"$ref":"#/$defs/idArray"},"avoid_for":{"$ref":"#/$defs/idArray"},"recommended_spacing":{"$ref":"#/$defs/id"},"recommended_typography":{"$ref":"#/$defs/id"},"recommended_motion":{"$ref":"#/$defs/id"},"recommended_image_style":{"$ref":"#/$defs/id"},"recommended_color_strategy":{"$ref":"#/$defs/id"},"compatible_personalities":{"$ref":"#/$defs/idArray"},"content_density":{"enum":["low","medium","high"]}},"additionalProperties":false},
    "industryProfile": {"type":"object","required":["id","name","preferred_design_languages","preferred_typography","spacing_profile","color_strategy","photography_style","content_density","trust_level","urgency_level","storytelling_importance","recommended_homepage_recipe","recommended_sections","recommended_cta_tone","product_focus","mobile_priority","preferred_personalities"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"preferred_design_languages":{"$ref":"#/$defs/idArray"},"preferred_typography":{"$ref":"#/$defs/id"},"spacing_profile":{"$ref":"#/$defs/id"},"color_strategy":{"$ref":"#/$defs/id"},"photography_style":{"$ref":"#/$defs/id"},"content_density":{"enum":["low","medium","high"]},"trust_level":{"enum":["low","medium","high"]},"urgency_level":{"enum":["low","medium","high"]},"storytelling_importance":{"enum":["low","medium","high"]},"recommended_homepage_recipe":{"$ref":"#/$defs/id"},"recommended_sections":{"type":"array","items":{"$ref":"#/$defs/sectionId"}},"recommended_cta_tone":{"$ref":"#/$defs/text"},"product_focus":{"$ref":"#/$defs/id"},"mobile_priority":{"enum":["low","medium","high"]},"preferred_personalities":{"$ref":"#/$defs/idArray"}},"additionalProperties":false},
    "layoutRecipe": {"type":"object","required":["id","name","page_type","why","appropriate_industries","design_language","typography","spacing","color_strategy","image_style","animation","conversion_strategy","section_sequence","maximum_sections","content_density"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"page_type":{"enum":["homepage"]},"why":{"$ref":"#/$defs/text"},"appropriate_industries":{"$ref":"#/$defs/idArray"},"design_language":{"$ref":"#/$defs/id"},"typography":{"$ref":"#/$defs/id"},"spacing":{"$ref":"#/$defs/id"},"color_strategy":{"$ref":"#/$defs/id"},"image_style":{"$ref":"#/$defs/id"},"animation":{"$ref":"#/$defs/id"},"conversion_strategy":{"$ref":"#/$defs/id"},"section_sequence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sectionId"}},"maximum_sections":{"type":"integer","minimum":1,"maximum":12},"content_density":{"enum":["low","medium","high"]}},"additionalProperties":false},
    "typographyProfile": {"type":"object","required":["id","name","heading_family_direction","body_family_direction","heading_scale","body_scale","heading_line_height","body_line_height","heading_tracking","casing","paragraph_width","button_typography","labels"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"heading_family_direction":{"$ref":"#/$defs/id"},"body_family_direction":{"$ref":"#/$defs/id"},"heading_scale":{"type":"object","required":["recommended_theme_percent_range","display_usage"],"properties":{"recommended_theme_percent_range":{"$ref":"#/$defs/range"},"display_usage":{"$ref":"#/$defs/id"}},"additionalProperties":false},"body_scale":{"type":"object","required":["recommended_theme_percent_range"],"properties":{"recommended_theme_percent_range":{"$ref":"#/$defs/range"}},"additionalProperties":false},"heading_line_height":{"enum":["1","1.1","1.2"]},"body_line_height":{"enum":["1.5","1.6","1.7"]},"heading_tracking":{"enum":["-0.02em","0em","0.04em"]},"casing":{"$ref":"#/$defs/id"},"paragraph_width":{"enum":["narrow","medium","wide"]},"button_typography":{"$ref":"#/$defs/id"},"labels":{"$ref":"#/$defs/id"}},"additionalProperties":false},
    "spacingProfile": {"type":"object","required":["id","name","section_spacing_range_px","card_spacing_range_px","grid_spacing_range_px","whitespace_philosophy","mobile_spacing_range_px"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"section_spacing_range_px":{"$ref":"#/$defs/range"},"card_spacing_range_px":{"$ref":"#/$defs/range"},"grid_spacing_range_px":{"$ref":"#/$defs/range"},"whitespace_philosophy":{"$ref":"#/$defs/text"},"mobile_spacing_range_px":{"$ref":"#/$defs/range"}},"additionalProperties":false},
    "colorStrategy": {"type":"object","required":["id","name","contrast_philosophy","cta_emphasis","background_strategy","card_strategy","accent_usage","warning_colors","success_colors","compatible_design_languages"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"contrast_philosophy":{"$ref":"#/$defs/text"},"cta_emphasis":{"$ref":"#/$defs/id"},"background_strategy":{"$ref":"#/$defs/id"},"card_strategy":{"$ref":"#/$defs/id"},"accent_usage":{"$ref":"#/$defs/id"},"warning_colors":{"$ref":"#/$defs/id"},"success_colors":{"$ref":"#/$defs/id"},"compatible_design_languages":{"$ref":"#/$defs/idArray"}},"additionalProperties":false},
    "imageStyle": {"type":"object","required":["id","name","composition","lighting","crop","negative_space","camera_distance","product_prominence","people_usage","emotion","background","color_grading"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"composition":{"$ref":"#/$defs/id"},"lighting":{"$ref":"#/$defs/id"},"crop":{"$ref":"#/$defs/id"},"negative_space":{"$ref":"#/$defs/id"},"camera_distance":{"$ref":"#/$defs/id"},"product_prominence":{"enum":["low","medium","high"]},"people_usage":{"$ref":"#/$defs/id"},"emotion":{"$ref":"#/$defs/id"},"background":{"$ref":"#/$defs/id"},"color_grading":{"$ref":"#/$defs/id"}},"additionalProperties":false},
    "animationProfile": {"type":"object","required":["id","name","duration_range_ms","easing","stagger","motion_amount","hover_philosophy","scroll_philosophy","reduced_motion_fallback"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"duration_range_ms":{"$ref":"#/$defs/range"},"easing":{"$ref":"#/$defs/id"},"stagger":{"$ref":"#/$defs/id"},"motion_amount":{"enum":["low","medium","high"]},"hover_philosophy":{"$ref":"#/$defs/id"},"scroll_philosophy":{"$ref":"#/$defs/id"},"reduced_motion_fallback":{"$ref":"#/$defs/id"}},"additionalProperties":false},
    "conversionStrategy": {"type":"object","required":["id","name","cta_density","urgency","scarcity","trust","reviews","social_proof","storytelling","email_timing","announcement_usage"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"cta_density":{"$ref":"#/$defs/id"},"urgency":{"$ref":"#/$defs/id"},"scarcity":{"$ref":"#/$defs/id"},"trust":{"$ref":"#/$defs/id"},"reviews":{"$ref":"#/$defs/id"},"social_proof":{"$ref":"#/$defs/id"},"storytelling":{"$ref":"#/$defs/id"},"email_timing":{"$ref":"#/$defs/id"},"announcement_usage":{"$ref":"#/$defs/id"}},"additionalProperties":false},
    "personality": {"type":"object","required":["id","name","typography","spacing","wording","cta_tone","animation","imagery","section_selection_bias"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"typography":{"$ref":"#/$defs/id"},"spacing":{"$ref":"#/$defs/id"},"wording":{"$ref":"#/$defs/id"},"cta_tone":{"$ref":"#/$defs/id"},"animation":{"$ref":"#/$defs/id"},"imagery":{"$ref":"#/$defs/id"},"section_selection_bias":{"type":"array","items":{"$ref":"#/$defs/sectionId"}}},"additionalProperties":false},
    "pageBlueprint": {"type":"object","required":["id","name","recommended_sections","maximum_sections","ideal_flow","conversion_goals","storytelling_balance","default_layout_recipes"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},"recommended_sections":{"type":"array","items":{"$ref":"#/$defs/sectionId"}},"maximum_sections":{"type":"integer","minimum":1,"maximum":12},"ideal_flow":{"$ref":"#/$defs/idArray"},"conversion_goals":{"$ref":"#/$defs/idArray"},"storytelling_balance":{"$ref":"#/$defs/id"},"default_layout_recipes":{"$ref":"#/$defs/idArray"}},"additionalProperties":false},
    "designRule": {"type":"object","required":["id","principle","applies_to_design_languages","applies_to_industries","rationale","validation"],"properties":{"id":{"$ref":"#/$defs/id"},"principle":{"$ref":"#/$defs/text"},"applies_to_design_languages":{"$ref":"#/$defs/idArray"},"applies_to_industries":{"$ref":"#/$defs/idArray"},"rationale":{"$ref":"#/$defs/text"},"validation":{"$ref":"#/$defs/text"}},"additionalProperties":false},
    "compatibilityEntry": {"type":"object","required":["section_id","works_with","avoid_directly_before","avoid_directly_after","rationale"],"properties":{"section_id":{"$ref":"#/$defs/sectionId"},"works_with":{"type":"array","items":{"$ref":"#/$defs/sectionId"}},"avoid_directly_before":{"type":"array","items":{"$ref":"#/$defs/sectionId"}},"avoid_directly_after":{"type":"array","items":{"$ref":"#/$defs/sectionId"}},"rationale":{"$ref":"#/$defs/text"}},"additionalProperties":false},
    "designLanguageCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/designLanguage"}}}}]},
    "industryProfileCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/industryProfile"}}}}]},
    "layoutRecipeCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/layoutRecipe"}}}}]},
    "typographyProfileCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/typographyProfile"}}}}]},
    "spacingProfileCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/spacingProfile"}}}}]},
    "colorStrategyCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/colorStrategy"}}}}]},
    "imageStyleCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/imageStyle"}}}}]},
    "animationProfileCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/animationProfile"}}}}]},
    "conversionStrategyCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/conversionStrategy"}}}}]},
    "personalityCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/personality"}}}}]},
    "pageBlueprintCatalog": {"allOf":[{"$ref":"#/$defs/catalog"},{"type":"object","properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/pageBlueprint"}}}}]},
    "designRules": {"type":"object","required":["version","rules"],"properties":{"version":{"type":"integer","const":1},"rules":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/designRule"}}},"additionalProperties":false},
    "compatibilityMatrix": {"type":"object","required":["version","entries"],"properties":{"version":{"type":"integer","const":1},"entries":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/compatibilityEntry"}}},"additionalProperties":false}
  }
}
