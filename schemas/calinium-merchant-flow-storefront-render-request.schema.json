{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-merchant-flow-storefront-render-request.schema.json",
  "title": "Calinium Merchant Flow Storefront Render Request",
  "type": "object",
  "required": ["schema_version", "contract_version", "request_id", "render_revision", "capture_purpose", "flow", "generation", "architecture", "target", "routes", "viewports", "safety", "provenance"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "contract_version": {"type": "string", "const": "merchant-flow-storefront-render-request-v1"},
    "request_id": {"type": "string", "pattern": "^merchant-render-request-[a-f0-9]{20}$"},
    "render_revision": {"type": "string", "const": "merchant-flow-storefront-render-v1"},
    "capture_purpose": {"type": "string", "const": "paid_merchant_flow_qa"},
    "flow": {
      "type": "object",
      "required": ["flow_id", "flow_sequence", "flow_checksum", "project_id", "organization_id", "order_id", "snapshot_id", "snapshot_checksum"],
      "properties": {
        "flow_id": {"type": "string", "minLength": 1},
        "flow_sequence": {"type": "integer", "minimum": 0},
        "flow_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "project_id": {"type": "string", "minLength": 1},
        "organization_id": {"type": "string", "minLength": 1},
        "order_id": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1},
        "snapshot_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "required": ["generation_id", "artifact"],
      "properties": {
        "generation_id": {"type": "string", "minLength": 1},
        "artifact": {
          "type": "object",
          "required": ["artifact_id", "source_kind", "source_reference", "sha256", "manifest_reference", "manifest_sha256"],
          "properties": {
            "artifact_id": {"type": "string", "pattern": "^theme-artifact-[a-f0-9]{20}$"},
            "source_kind": {"type": "string", "const": "paid_read_only_theme_zip"},
            "source_reference": {"type": "string", "pattern": "^output/"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "manifest_reference": {"type": "string", "pattern": "^output/"},
            "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "architecture": {"$ref": "calinium-storefront-render-request.schema.json#/properties/architecture"},
    "target": {
      "type": "object",
      "required": ["configuration_revision", "runtime_mode", "shop_domain", "theme_id", "expected_theme_role"],
      "properties": {
        "configuration_revision": {"type": "string", "minLength": 1},
        "runtime_mode": {"type": "string", "const": "shopify_development_proxy"},
        "shop_domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.myshopify\\.com$"},
        "theme_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "expected_theme_role": {"type": "string", "const": "development"}
      },
      "additionalProperties": false
    },
    "routes": {"$ref": "calinium-storefront-render-request.schema.json#/properties/routes"},
    "viewports": {"$ref": "calinium-storefront-render-request.schema.json#/properties/viewports"},
    "safety": {
      "type": "object",
      "required": ["live_theme_allowed", "publish_allowed", "cart_mutation_allowed", "fixture_fallback_allowed", "approved_replay_allowed", "automatic_repair_allowed", "human_review_required"],
      "properties": {
        "live_theme_allowed": {"const": false},
        "publish_allowed": {"const": false},
        "cart_mutation_allowed": {"const": false},
        "fixture_fallback_allowed": {"const": false},
        "approved_replay_allowed": {"const": false},
        "automatic_repair_allowed": {"const": false},
        "human_review_required": {"const": true}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_kind", "artifact_integrity_version", "artifact_integrity_checksum", "route_binding_revision", "route_registry_version", "viewport_registry_version", "capture_policy_revision", "runtime_configuration_revision"],
      "properties": {
        "source_kind": {"type": "string", "const": "paid_merchant_generation"},
        "artifact_integrity_version": {"type": "integer", "const": 1},
        "artifact_integrity_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "route_binding_revision": {"type": "string", "pattern": "^merchant-route-binding-[a-f0-9]{20}$"},
        "route_registry_version": {"type": "string"},
        "viewport_registry_version": {"type": "string"},
        "capture_policy_revision": {"type": "string", "const": "storefront-capture-policy-v1"},
        "runtime_configuration_revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
