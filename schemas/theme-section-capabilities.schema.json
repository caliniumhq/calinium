{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/theme-section-capabilities.schema.json",
  "allOf": [{"$ref": "theme-mapping.schema.json#/$defs/metadata"}],
  "required": ["sections"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "name", "purpose", "supported_blocks", "supports_app_blocks", "supported_layouts", "presets", "available_settings", "blocks", "required_settings", "optional_settings", "dependencies", "performance_cost", "merchant_required_fields", "ai_configurable_fields", "merchant_only_fields", "source"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "supported_blocks": {"type": "array"},
          "supports_app_blocks": {"type": "boolean"},
          "supported_layouts": {"type": "array"},
          "presets": {"type": "array"},
          "available_settings": {"type": "array", "items": {"$ref": "theme-mapping.schema.json#/$defs/setting"}},
          "blocks": {"type": "array"},
          "required_settings": {"type": "array", "items": {"type": "string"}},
          "optional_settings": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"$ref": "theme-mapping.schema.json#/$defs/dependencies"},
          "performance_cost": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
          "merchant_required_fields": {"type": "array", "items": {"type": "string"}},
          "ai_configurable_fields": {"type": "array", "items": {"type": "string"}},
          "merchant_only_fields": {"type": "array", "items": {"type": "string"}},
          "source": {"$ref": "theme-mapping.schema.json#/$defs/source"}
        }
      }
    }
  }
}
