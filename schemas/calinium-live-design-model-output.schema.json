{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-live-design-model-output.schema.json",
  "title": "Calinium Live Design Model Output",
  "type": "object",
  "required": ["schema_version", "summary", "dimension_assessments", "findings", "objective_fact_acknowledgements"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "dimension_assessments": {"type": "array", "minItems": 12, "maxItems": 64, "items": {"$ref": "#/$defs/assessment"}},
    "findings": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/finding"}},
    "objective_fact_acknowledgements": {"type": "array", "items": {"$ref": "#/$defs/objectiveAcknowledgement"}}
  },
  "$defs": {
    "scope": {"type": "object", "required": ["level", "profile_ids", "route_ids", "viewport_ids"], "properties": {"level": {"type": "string", "enum": ["per_cell", "route_pair", "architecture", "controlled_comparison"]}, "profile_ids": {"type": "array", "items": {"type": "string"}}, "route_ids": {"type": "array", "items": {"type": "string"}}, "viewport_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "assessment": {"type": "object", "required": ["dimension", "scope", "judgment", "importance", "confidence", "summary", "rationale", "evidence_cell_ids", "context_basis"], "properties": {"dimension": {"type": "string", "enum": ["visual_hierarchy", "spacing_and_rhythm", "typographic_hierarchy", "image_media_dominance", "composition", "product_discovery", "pdp_communication", "navigation_header_clarity", "mobile_adaptation_quality", "design_dna_coherence", "perceived_polish", "architecture_differentiation"]}, "scope": {"$ref": "#/$defs/scope"}, "judgment": {"type": "string", "enum": ["strong", "acceptable", "concern", "not_assessable"]}, "importance": {"type": "string", "enum": ["high", "medium", "low", "note"]}, "confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}, "rationale": {"type": "string", "minLength": 1, "maxLength": 1200}, "evidence_cell_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "context_basis": {"type": "array", "items": {"type": "string", "enum": ["screenshot", "route_purpose", "architecture_intent", "preset", "design_dna", "merchant_intent", "store_intelligence", "catalog", "objective_evaluation"]}}}, "additionalProperties": false},
    "findingEvidence": {"type": "object", "required": ["cell_id", "region", "visible_evidence"], "properties": {"cell_id": {"type": "string"}, "region": {"type": "string", "minLength": 1, "maxLength": 300}, "visible_evidence": {"type": "string", "minLength": 1, "maxLength": 600}}, "additionalProperties": false},
    "finding": {"type": "object", "required": ["dimension", "importance", "confidence", "diagnosis", "scope", "evidence", "context_relation", "recommendation_category", "responsibility", "objective_relation"], "properties": {"dimension": {"type": "string", "enum": ["visual_hierarchy", "spacing_and_rhythm", "typographic_hierarchy", "image_media_dominance", "composition", "product_discovery", "pdp_communication", "navigation_header_clarity", "mobile_adaptation_quality", "design_dna_coherence", "perceived_polish", "architecture_differentiation"]}, "importance": {"type": "string", "enum": ["high", "medium", "low", "note"]}, "confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "diagnosis": {"type": "string", "minLength": 1, "maxLength": 1200}, "scope": {"$ref": "#/$defs/scope"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/findingEvidence"}}, "context_relation": {"type": "object", "required": ["architecture_intent", "design_dna", "merchant_intent"], "properties": {"architecture_intent": {"type": "string"}, "design_dna": {"type": "string"}, "merchant_intent": {"type": "string"}}, "additionalProperties": false}, "recommendation_category": {"type": "string", "enum": ["hierarchy", "spacing_rhythm", "typography", "media_treatment", "composition", "content_omission", "product_discovery", "pdp_communication", "navigation_clarity", "responsive_adaptation", "design_dna", "polish", "architecture_differentiation"]}, "responsibility": {"type": "string", "enum": ["architecture_level", "design_token_level", "composition_level", "merchant_content_level", "data_quality_level", "uncertain"]}, "objective_relation": {"type": "object", "required": ["mode", "objective_finding_ids"], "properties": {"mode": {"type": "string", "enum": ["separate", "design_impact_of_objective"]}, "objective_finding_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}, "additionalProperties": false},
    "objectiveAcknowledgement": {"type": "object", "required": ["finding_id", "status", "impact"], "properties": {"finding_id": {"type": "string"}, "status": {"type": "string", "enum": ["acknowledged", "contradicted", "not_assessable"]}, "impact": {"type": "string", "minLength": 1, "maxLength": 600}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
