{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/strategy-setting-mapping.schema.json",
  "allOf": [{"$ref": "theme-mapping.schema.json#/$defs/metadata"}],
  "required": ["mappings"],
  "properties": {
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "decision_id", "support_status", "mapping_kind", "target", "reason", "fallback", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "decision_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "support_status": {"type": "string", "enum": ["full", "partial", "unsupported"]},
          "mapping_kind": {"type": "string", "enum": ["theme_setting", "section_composition", "strategy_context"]},
          "target": {
            "type": "object",
            "required": ["capability_ids", "global_setting_ids", "section_setting_refs", "section_ids"],
            "properties": {
              "capability_ids": {"type": "array", "items": {"type": "string"}},
              "global_setting_ids": {"type": "array", "items": {"type": "string"}},
              "section_setting_refs": {"type": "array", "items": {"type": "string"}},
              "section_ids": {"type": "array", "items": {"type": "string"}}
            }
          },
          "reason": {"type": "string", "minLength": 1},
          "fallback": {"type": "string", "minLength": 1},
          "source": {"$ref": "theme-mapping.schema.json#/$defs/source"}
        }
      }
    }
  }
}
