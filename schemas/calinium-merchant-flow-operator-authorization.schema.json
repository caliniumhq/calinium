{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-merchant-flow-operator-authorization.schema.json",
  "title": "Calinium merchant-flow operator authorization policy",
  "type": "object",
  "required": ["schema_version", "contract_version", "allowed_roles", "operator_user_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "merchant-flow-operator-authorization-v1"},
    "allowed_roles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["owner", "administrator"]}
    },
    "operator_user_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    }
  },
  "additionalProperties": false
}
