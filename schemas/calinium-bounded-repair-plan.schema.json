{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-bounded-repair-plan.schema.json",
  "title": "Calinium Bounded Repair Plan",
  "type": "object",
  "required": ["schema_version", "contract_version", "policy", "target", "evidence", "downstream_symptom", "root_cause", "responsibility", "ownership", "modification_scope", "intervention", "expected_effects", "forbidden_scope", "regression_risks", "acceptance", "verification", "rollback", "status", "safety", "repair_plan_id", "repair_plan_checksum"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "contract_version": {"type": "string", "const": "bounded-repair-plan-v1"},
    "policy": {"type": "object", "required": ["policy_id", "policy_version", "policy_revision"], "properties": {"policy_id": {"type": "string"}, "policy_version": {"type": "string"}, "policy_revision": {"type": "string"}}, "additionalProperties": false},
    "target": {"type": "object", "required": ["authoritative_finding_id", "human_decision", "architecture_profile_id", "route_id", "viewport_id", "browser_viewport", "rule_id", "severity"], "properties": {"authoritative_finding_id": {"type": "string"}, "human_decision": {"type": "string", "const": "needs_fix"}, "architecture_profile_id": {"type": "string"}, "route_id": {"type": "string"}, "viewport_id": {"type": "string"}, "browser_viewport": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}, "additionalProperties": false}, "rule_id": {"type": "string", "const": "root_horizontal_overflow"}, "severity": {"type": "string", "const": "high"}}, "additionalProperties": false},
    "evidence": {"type": "object"},
    "downstream_symptom": {"type": "object", "required": ["finding_id", "human_decision", "relationship", "independent_repair_target"], "properties": {"finding_id": {"type": "string"}, "human_decision": {"type": "string", "const": "false_positive"}, "relationship": {"type": "string", "const": "symptom_of_root_overflow"}, "independent_repair_target": {"type": "boolean", "const": false}}, "additionalProperties": false},
    "root_cause": {"type": "object", "required": ["status", "confidence", "summary", "causal_chain", "source_contributors", "minimum_non_mutating_diagnostic"], "properties": {"status": {"type": "string"}, "confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "summary": {"type": "string", "minLength": 1}, "causal_chain": {"type": "array", "minItems": 4, "items": {"type": "string"}}, "source_contributors": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "minimum_non_mutating_diagnostic": {"type": "object"}}, "additionalProperties": false},
    "responsibility": {"type": "object", "required": ["classification", "rationale"], "properties": {"classification": {"type": "string"}, "rationale": {"type": "string"}}, "additionalProperties": false},
    "ownership": {"type": "object", "required": ["architecture_family_id", "architecture_family_type", "source_scope", "editorial_uses_same_source_rule", "blast_radius"], "properties": {"architecture_family_id": {"type": "string"}, "architecture_family_type": {"type": "string"}, "source_scope": {"type": "string"}, "editorial_uses_same_source_rule": {"type": "boolean"}, "blast_radius": {"type": "string"}}, "additionalProperties": false},
    "modification_scope": {"type": "object", "required": ["maximum_file_count", "allowed_files", "unrelated_refactoring_allowed"], "properties": {"maximum_file_count": {"type": "integer", "minimum": 1}, "allowed_files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "before_sha256", "why_required", "permitted_change", "must_remain_untouched"], "properties": {"path": {"type": "string"}, "before_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "why_required": {"type": "string"}, "permitted_change": {"type": "string"}, "must_remain_untouched": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}}, "unrelated_refactoring_allowed": {"type": "boolean", "const": false}}, "additionalProperties": false},
    "intervention": {"type": "object", "required": ["type", "proposed_change", "rationale", "primary_selector", "global_overflow_suppression_allowed", "conditional_on_runtime_diagnostic"], "properties": {"type": {"type": "string"}, "proposed_change": {"type": "string"}, "rationale": {"type": "string"}, "primary_selector": {"type": "string"}, "global_overflow_suppression_allowed": {"type": "boolean", "const": false}, "conditional_on_runtime_diagnostic": {"type": "boolean", "const": true}}, "additionalProperties": false},
    "expected_effects": {"type": "object"},
    "forbidden_scope": {"type": "array", "minItems": 16, "items": {"type": "string"}},
    "regression_risks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "acceptance": {"type": "object", "required": ["before", "after"], "properties": {"before": {"type": "object", "required": ["viewport_width_css_px", "document_width_css_px", "horizontal_overflow_css_px", "d1_rule_id", "d1_severity"], "properties": {"viewport_width_css_px": {"type": "number"}, "document_width_css_px": {"type": "number"}, "horizontal_overflow_css_px": {"type": "number"}, "d1_rule_id": {"type": "string"}, "d1_severity": {"type": "string"}}, "additionalProperties": false}, "after": {"type": "object", "required": ["maximum_document_width_css_px", "rounding_tolerance_css_px", "root_horizontal_overflow_finding_allowed", "product_discovery_functional", "visual_failure_conditions"], "properties": {"maximum_document_width_css_px": {"type": "number"}, "rounding_tolerance_css_px": {"type": "number"}, "root_horizontal_overflow_finding_allowed": {"type": "boolean", "const": false}, "product_discovery_functional": {"type": "boolean", "const": true}, "visual_failure_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}}, "additionalProperties": false},
    "verification": {"type": "object", "required": ["loop", "required_checks", "regression_matrix", "editorial_byte_identical_expected", "human_review_required", "automatic_approval_allowed"], "properties": {"loop": {"type": "array", "minItems": 8, "items": {"type": "string"}}, "required_checks": {"type": "array", "minItems": 8, "items": {"type": "string"}}, "regression_matrix": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "object", "required": ["profile_id", "route_id", "viewport_id", "expectation"], "properties": {"profile_id": {"type": "string"}, "route_id": {"type": "string"}, "viewport_id": {"type": "string"}, "expectation": {"type": "string"}}, "additionalProperties": false}}, "editorial_byte_identical_expected": {"type": "boolean", "const": true}, "human_review_required": {"type": "boolean", "const": true}, "automatic_approval_allowed": {"type": "boolean", "const": false}}, "additionalProperties": false},
    "rollback": {"type": "object", "required": ["checkpoint_tag", "checkpoint_commit", "boundary", "method"], "properties": {"checkpoint_tag": {"type": "string"}, "checkpoint_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "boundary": {"type": "string"}, "method": {"type": "string"}}, "additionalProperties": false},
    "status": {"type": "string", "const": "proposed"},
    "safety": {"type": "object", "required": ["human_approval_required", "mutation_allowed", "automatic_repair_allowed", "repair_execution_available", "d3b_started", "api_calls_required"], "properties": {"human_approval_required": {"type": "boolean", "const": true}, "mutation_allowed": {"type": "boolean", "const": false}, "automatic_repair_allowed": {"type": "boolean", "const": false}, "repair_execution_available": {"type": "boolean", "const": false}, "d3b_started": {"type": "boolean", "const": false}, "api_calls_required": {"type": "boolean", "const": false}}, "additionalProperties": false},
    "repair_plan_id": {"type": "string", "pattern": "^repair-plan-[a-f0-9]{20}$"},
    "repair_plan_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
