{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-deployment-package.schema.json",
  "title": "Calinium approved deployment package",
  "type": "object",
  "required": ["version", "package_id", "generated_workspace", "workspace_fingerprint", "generated_theme_manifest", "generated_theme_manifest_hash", "review_session", "review_session_hash", "approval_manifest", "approval_manifest_hash", "change_manifest", "theme_diff", "preview_report", "files", "traceability", "validation"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "package_id": {"type": "string", "pattern": "^deployment-package-[a-z0-9-]+$"},
    "generated_workspace": {"type": "string", "minLength": 1},
    "workspace_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_theme_manifest": {"type": "string", "minLength": 1},
    "generated_theme_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_session": {"type": "string", "minLength": 1},
    "review_session_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approval_manifest": {"type": "string", "minLength": 1},
    "approval_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "change_manifest": {"type": "string", "minLength": 1},
    "theme_diff": {"type": "string", "minLength": 1},
    "preview_report": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "traceability": {"$ref": "calinium-review-session.schema.json#/$defs/traceability"},
    "validation": {"$ref": "calinium-review-session.schema.json#/$defs/status"}
  },
  "$defs": {
    "file": {"type": "object", "required": ["path", "checksum", "bytes"], "properties": {"path": {"type": "string", "pattern": "^(templates/.+\\.json|config/settings_data\\.json)$"}, "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
