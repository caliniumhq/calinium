{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-observation-stabilization-policy.schema.json",
  "title": "Calinium Observation Stabilization Policy",
  "type": "object",
  "required": ["schema_version", "policy_version", "policy_id", "policy_revision", "source_stabilization_policy_revision", "contracts", "phenomena", "components", "support_statuses", "comparison_types", "comparison_conclusions", "rejected_interpretation_terms", "reliability", "limited_live_validation"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "policy_version": {"type": "string"},
    "policy_id": {"type": "string", "const": "calinium_visual_observation_stabilization"},
    "policy_revision": {"type": "string"},
    "source_stabilization_policy_revision": {"type": "string"},
    "contracts": {"type": "object"},
    "phenomena": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind", "legacy_phenomenon", "definition"], "properties": {"id": {"type": "string"}, "kind": {"type": "string", "enum": ["issue", "structure"]}, "legacy_phenomenon": {"type": "string"}, "definition": {"type": "string"}}, "additionalProperties": false}},
    "components": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "support_statuses": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "comparison_types": {"type": "array", "items": {"type": "string"}},
    "comparison_conclusions": {"type": "array", "items": {"type": "string"}},
    "rejected_interpretation_terms": {"type": "array", "items": {"type": "string"}},
    "reliability": {"type": "object", "required": ["statuses", "thresholds", "human_review_required", "automatic_repair_allowed"], "properties": {"statuses": {"type": "array", "items": {"type": "string"}}, "thresholds": {"type": "object"}, "human_review_required": {"type": "boolean", "const": true}, "automatic_repair_allowed": {"type": "boolean", "const": false}}, "additionalProperties": false},
    "limited_live_validation": {"type": "object"}
  },
  "additionalProperties": false
}
