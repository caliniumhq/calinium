{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-manufacturing-process-candidate.schema.json",
  "title": "Calinium Manufacturing Process Candidate Plan",
  "description": "Mutable, project-scoped merchant review state for verified ordered Manufacturing Process stages. It is not an Approved Block Plan revision and cannot be consumed by generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "candidate_version", "steps", "warnings", "updated_at"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "status": {"type": "string", "enum": ["not_required", "draft", "approved"]},
    "candidate_version": {"type": "integer", "minimum": 0},
    "steps": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/step"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "placement_id", "title", "text", "process_icon", "image_asset_id", "image_alt_text", "decorative_media", "evidence_note", "order"],
      "properties": {
        "content_id": {"type": "string", "pattern": "^abpc_[a-z0-9][a-z0-9_-]*$"},
        "placement_id": {"type": "string", "pattern": "^abpl_[a-z0-9][a-z0-9_-]*$"},
        "title": {"type": "string", "maxLength": 240},
        "text": {"type": "string", "maxLength": 1200},
        "process_icon": {"type": "string", "enum": ["none", "settings", "factory", "check", "package"]},
        "image_asset_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
        "image_alt_text": {"type": ["string", "null"], "maxLength": 500},
        "decorative_media": {"type": "boolean"},
        "evidence_note": {"type": "string", "maxLength": 1200},
        "order": {"type": "integer", "minimum": 1}
      }
    }
  }
}
