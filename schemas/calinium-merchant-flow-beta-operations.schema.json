{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-merchant-flow-beta-operations.schema.json",
  "title": "Calinium merchant-flow beta operations policy",
  "type": "object",
  "required": ["policy_revision", "flow_contract", "activation", "merchant_statuses", "jobs", "operator_operations", "cancellation", "shopify_target", "qa", "safety"],
  "properties": {
    "policy_revision": {"const": "merchant-flow-beta-operations-v2"},
    "flow_contract": {"const": "merchant-generation-flow-v2"},
    "activation": {"type": "object", "required": ["environment_flag", "required_value", "controlled_beta_only"], "properties": {"environment_flag": {"const": "CALINIUM_MERCHANT_FLOW_BETA_ENABLED"}, "required_value": {"const": "true"}, "controlled_beta_only": {"const": true}}, "additionalProperties": false},
    "merchant_statuses": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"enum": ["analyzing_store", "understanding_direction", "designing_storefront", "building_theme", "reviewing_result", "preparing_preview", "action_needed", "ready_to_preview", "needs_attention"]}},
    "jobs": {"type": "object", "required": ["allowed_kinds", "statuses", "stable_identity_required", "lease_required", "server_authoritative", "controlled_runtime_required"], "properties": {"allowed_kinds": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["generation", "render_qa"]}}, "statuses": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["queued", "running", "completed", "retryable", "terminal", "cancellation_requested", "cancelled"]}}, "stable_identity_required": {"const": true}, "lease_required": {"const": true}, "server_authoritative": {"const": true}, "controlled_runtime_required": {"const": true}}, "additionalProperties": false},
    "operator_operations": {"type": "object", "required": ["contract_revision", "allowed_kinds", "persistent_idempotency_required", "checksum_binding_required"], "properties": {"contract_revision": {"const": "merchant-flow-operator-operation-v1"}, "allowed_kinds": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["qa_review", "repair_resolution", "cancel"]}}, "persistent_idempotency_required": {"const": true}, "checksum_binding_required": {"const": true}}, "additionalProperties": false},
    "cancellation": {"type": "object", "required": ["terminal_flow_state", "queued_job_state", "running_job_state", "immutable_evidence_preserved", "billing_mutation_allowed", "theme_mutation_allowed", "reopen_allowed"], "properties": {"terminal_flow_state": {"const": "cancelled"}, "queued_job_state": {"const": "cancelled"}, "running_job_state": {"const": "cancellation_requested"}, "immutable_evidence_preserved": {"const": true}, "billing_mutation_allowed": {"const": false}, "theme_mutation_allowed": {"const": false}, "reopen_allowed": {"const": false}}, "additionalProperties": false},
    "shopify_target": {"type": "object", "required": ["allowed_roles", "forbidden_roles", "shop_ownership_required"], "properties": {"allowed_roles": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["development", "unpublished", "demo", "staging"]}}, "forbidden_roles": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["main", "live", "published", "primary"]}}, "shop_ownership_required": {"const": true}}, "additionalProperties": false},
    "qa": {"type": "object", "required": ["d1_first", "d2_7_policy_gated", "accepted_result_reused", "human_review_required_when_paused"], "properties": {"d1_first": {"const": true}, "d2_7_policy_gated": {"const": true}, "accepted_result_reused": {"const": true}, "human_review_required_when_paused": {"const": true}}, "additionalProperties": false},
    "safety": {"type": "object", "required": ["automatic_repair_allowed", "automatic_publish_allowed", "automatic_theme_replacement_allowed", "live_theme_mutation_allowed", "merchant_action_required", "maximum_material_questions"], "properties": {"automatic_repair_allowed": {"const": false}, "automatic_publish_allowed": {"const": false}, "automatic_theme_replacement_allowed": {"const": false}, "live_theme_mutation_allowed": {"const": false}, "merchant_action_required": {"const": true}, "maximum_material_questions": {"const": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
