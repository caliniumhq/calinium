{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/theme-capabilities.schema.json",
  "allOf": [{"$ref": "theme-mapping.schema.json#/$defs/metadata"}],
  "required": ["capabilities"],
  "properties": {
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "ai_configurable", "merchant_review_required", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "ai_configurable": {"type": "boolean"},
          "merchant_review_required": {"type": "boolean"},
          "source": {"type": "array", "minItems": 1, "items": {"$ref": "theme-mapping.schema.json#/$defs/source"}}
        }
      }
    }
  }
}
