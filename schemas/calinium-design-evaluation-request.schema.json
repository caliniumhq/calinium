{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-design-evaluation-request.schema.json",
  "title": "Calinium Subjective Design Evaluation Request",
  "type": "object",
  "required": ["schema_version", "contract_version", "request_id", "policy", "comparison", "cells", "context", "evaluation_scopes", "safety"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "contract_version": {"type": "string", "const": "design-evaluation-request-v1"},
    "request_id": {"type": "string", "pattern": "^design-evaluation-request-[a-f0-9]{20}$"},
    "policy": {"type": "object", "required": ["policy_revision", "evaluator_version", "provider_interface_version", "required_repeat_runs"], "properties": {"policy_revision": {"type": "string", "const": "storefront-design-evaluation-policy-v1"}, "evaluator_version": {"type": "string", "const": "storefront-design-evaluator-v1"}, "provider_interface_version": {"type": "string", "const": "storefront-design-provider-v1"}, "required_repeat_runs": {"type": "integer", "const": 2}}, "additionalProperties": false},
    "comparison": {"type": "object", "required": ["fixture_revision", "comparison_key", "objective_calibration_reference", "objective_calibration_sha256"], "properties": {"fixture_revision": {"type": "string"}, "comparison_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "objective_calibration_reference": {"type": "string"}, "objective_calibration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "cells": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/cell"}},
    "context": {"type": "object", "required": ["context_revision", "preset", "design_dna", "merchant_intent", "store_intelligence", "catalog", "architecture_profiles", "source_authority"], "properties": {"context_revision": {"type": "string"}, "preset": {"$ref": "#/$defs/contextBinding"}, "design_dna": {"$ref": "#/$defs/contextBinding"}, "merchant_intent": {"$ref": "#/$defs/contextBinding"}, "store_intelligence": {"$ref": "#/$defs/contextBinding"}, "catalog": {"type": "object"}, "architecture_profiles": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}}, "source_authority": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "evaluation_scopes": {"type": "array", "items": {"type": "string", "enum": ["per_cell", "route_pair", "architecture", "controlled_comparison"]}},
    "safety": {"type": "object", "required": ["automatic_mutation_allowed", "automatic_repair_allowed", "shopify_write_allowed", "benchmark_reference_allowed"], "properties": {"automatic_mutation_allowed": {"type": "boolean", "const": false}, "automatic_repair_allowed": {"type": "boolean", "const": false}, "shopify_write_allowed": {"type": "boolean", "const": false}, "benchmark_reference_allowed": {"type": "boolean", "const": false}}, "additionalProperties": false}
  },
  "$defs": {
    "contextBinding": {"type": "object", "required": ["status", "revision_id", "checksum", "reference", "reason_code"], "properties": {"status": {"type": "string", "enum": ["available", "reference_only", "not_available"]}, "revision_id": {"type": ["string", "null"]}, "checksum": {"type": ["string", "null"]}, "reference": {"type": ["string", "null"]}, "reason_code": {"type": ["string", "null"]}}, "additionalProperties": false},
    "cell": {"type": "object", "required": ["cell_id", "profile_id", "profile_version", "architecture_selection_revision", "route_id", "viewport_id", "render_request_id", "render_id", "render_result_checksum", "screenshot", "objective_evaluation"], "properties": {"cell_id": {"type": "string", "pattern": "^design-cell-[a-f0-9]{20}$"}, "profile_id": {"type": "string"}, "profile_version": {"type": "string"}, "architecture_selection_revision": {"type": "string"}, "route_id": {"type": "string", "enum": ["homepage", "collection", "product", "cart"]}, "viewport_id": {"type": "string"}, "render_request_id": {"type": "string"}, "render_id": {"type": "string"}, "render_result_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "screenshot": {"type": "object", "required": ["artifact_reference", "sha256", "width", "height"], "properties": {"artifact_reference": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "width": {"type": "integer"}, "height": {"type": "integer"}}, "additionalProperties": false}, "objective_evaluation": {"type": "object", "required": ["evaluation_id", "evidence_revision", "gate_status", "findings"], "properties": {"evaluation_id": {"type": "string"}, "evidence_revision": {"type": "string"}, "gate_status": {"type": "string", "enum": ["pass", "pass_with_review", "fail_review_required"]}, "findings": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": false}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
