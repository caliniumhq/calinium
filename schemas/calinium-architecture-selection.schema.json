{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-architecture-selection.schema.json",
  "title": "Frozen Calinium Core 2.0 architecture selection",
  "type": "object",
  "required": ["schema_version", "selection_engine_version", "revision_id", "frozen", "profile_id", "profile_schema_version", "profile_version", "family_selections", "selection_source", "selection_reason", "eligibility_result", "fit_result", "material_question", "store_intelligence_revision", "merchant_intent_revision", "compatibility_result", "fallback", "lifecycle"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "selection_engine_version": {"type": "string", "enum": ["architecture-selection-v1", "architecture-selection-v2"]},
    "revision_id": {"type": "string", "pattern": "^architecture-selection-[a-f0-9]{20}$"},
    "frozen": {"type": "boolean", "const": true},
    "profile_id": {"type": "string", "pattern": "^profile\\.[a-z0-9_]+\\.v[0-9]+$"},
    "profile_schema_version": {"type": "string", "const": "1.0"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "family_selections": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["family", "family_id", "family_version", "presenters"], "properties": {"family": {"type": "string", "enum": ["header_navigation", "product_card", "collection_merchandising", "product_detail", "cart", "responsive_behavior"]}, "family_id": {"type": "string", "pattern": "^family\\.[a-z_]+\\.[a-z0-9_]+\\.v[0-9]+$"}, "family_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "presenters": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}},
    "selection_source": {"type": "string", "enum": ["default_fallback", "explicit_profile", "automatic_policy", "conservative_fallback"]},
    "selection_reason": {"type": "object", "required": ["codes", "summary"], "properties": {"codes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}}, "summary": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "eligibility_result": {"type": "object", "required": ["eligible", "evaluator_version", "required_signals", "missing_signals"], "properties": {"eligible": {"type": "boolean", "const": true}, "evaluator_version": {"type": "string", "enum": ["architecture-eligibility-v1", "architecture-eligibility-v2"]}, "required_signals": {"type": "array", "items": {"type": "string"}}, "missing_signals": {"type": "array", "maxItems": 0, "items": {"type": "string"}}}, "additionalProperties": false},
    "fit_result": {"type": "object", "required": ["evaluator_version", "candidate_count", "rank", "score", "reason_codes"], "properties": {"evaluator_version": {"type": "string", "enum": ["architecture-fit-v1", "architecture-fit-v2"]}, "candidate_count": {"type": "integer", "minimum": 1}, "rank": {"type": "integer", "const": 1}, "score": {"type": "number"}, "confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "material_question": {"type": "null"},
    "store_intelligence_revision": {"type": ["string", "null"]},
    "merchant_intent_revision": {"type": "string", "pattern": "^merchant-intent-[a-f0-9]{20}$"},
    "compatibility_result": {"type": "object", "required": ["valid", "solver_version", "checked_capabilities", "errors"], "properties": {"valid": {"type": "boolean", "const": true}, "solver_version": {"type": "string", "const": "architecture-compatibility-v1"}, "checked_capabilities": {"type": "array", "items": {"type": "string"}}, "errors": {"type": "array", "maxItems": 0, "items": {"type": "string"}}}, "additionalProperties": false},
    "fallback": {"type": ["object", "null"], "required": ["applied", "reason", "profile_id"], "properties": {"applied": {"type": "boolean", "const": true}, "reason": {"type": "string", "enum": ["profile_unspecified", "signals_insufficient", "question_unavailable", "exact_tie_after_known_intent"]}, "profile_id": {"type": "string", "const": "profile.current_calinium.v1"}}, "additionalProperties": false},
    "lifecycle": {"type": "object", "required": ["resolved_before"], "properties": {"resolved_before": {"type": "array", "items": {"type": "string", "enum": ["design_dna", "composition"]}}, "paid_retries_use_pinned_revision": {"type": "boolean", "const": true}}, "additionalProperties": false},
    "automatic_policy": {"type": "object", "required": ["policy_revision", "selection_mode", "signal_derivation_revision", "selection_confidence", "candidate_results", "ambiguity_result", "input_bindings", "observed_signal_paths", "safety"], "properties": {"policy_revision": {"type": "string", "const": "architecture-selection-policy-v1"}, "selection_mode": {"type": "string", "const": "automatic_beta"}, "signal_derivation_revision": {"type": "string", "const": "architecture-store-signal-derivation-v1"}, "selection_confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "candidate_results": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "calinium-architecture-selection-outcome.schema.json#/$defs/candidate"}}, "ambiguity_result": {"$ref": "calinium-architecture-selection-outcome.schema.json#/$defs/ambiguity"}, "input_bindings": {"$ref": "calinium-architecture-selection-outcome.schema.json#/$defs/inputBindings"}, "observed_signal_paths": {"type": "object", "required": ["store_intelligence", "merchant_intent"], "properties": {"store_intelligence": {"type": "array", "items": {"type": "string"}}, "merchant_intent": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}, "safety": {"$ref": "calinium-architecture-selection-outcome.schema.json#/$defs/safety"}}, "additionalProperties": false},
    "material_clarification": {"$ref": "calinium-architecture-material-clarification.schema.json"}
  },
  "additionalProperties": false
}
