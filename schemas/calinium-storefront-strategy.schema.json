{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.example/schemas/calinium-storefront-strategy.schema.json",
  "title": "Calinium storefront strategy",
  "type": "object",
  "required": ["version", "compiler_version", "knowledge_base_versions", "merchant_summary", "resolutions", "decisions", "homepage_blueprint", "homepage_recipe", "ordered_sections", "merchant_assets", "merchant_verification", "content_safety", "validation_report", "explanations", "decision_trace"],
  "properties": {
    "version": {"type":"integer","const":1},
    "compiler_version": {"type":"string","minLength":1},
    "knowledge_base_versions": {"type":"object","required":["design_intelligence","section_manifest","setting_metadata","block_taxonomy"],"properties":{"design_intelligence":{"type":"integer","minimum":1},"section_manifest":{"type":"integer","minimum":1},"setting_metadata":{"type":"integer","minimum":1},"block_taxonomy":{"type":"integer","minimum":1}},"additionalProperties":false},
    "merchant_summary": {"type":"object","required":["business_name","industry","subcategory","page_type","catalog_product_count"],"properties":{"business_name":{"type":["string","null"]},"industry":{"type":["string","null"]},"subcategory":{"type":["string","null"]},"page_type":{"type":["string","null"]},"catalog_product_count":{"type":["integer","null"]}},"additionalProperties":false},
    "resolutions": {"type":"object","required":["industry","personality","design_language","typography","spacing","color_strategy","image_strategy","animation","conversion_strategy","blueprint","homepage_recipe"],"properties":{"industry":{"type":["string","null"]},"personality":{"type":["string","null"]},"design_language":{"type":["string","null"]},"typography":{"type":["string","null"]},"spacing":{"type":["string","null"]},"color_strategy":{"type":["string","null"]},"image_strategy":{"type":["string","null"]},"animation":{"type":["string","null"]},"conversion_strategy":{"type":["string","null"]},"blueprint":{"type":["string","null"]},"homepage_recipe":{"type":["string","null"]}},"additionalProperties":false},
    "decisions": {"type":"object","required":["industry","personality","design_language","typography","spacing","color_strategy","image_strategy","animation","conversion_strategy","blueprint","homepage_recipe","section_selection","section_ordering"],"properties":{"industry":{"$ref":"#/$defs/decision"},"personality":{"$ref":"#/$defs/decision"},"design_language":{"$ref":"#/$defs/decision"},"typography":{"$ref":"#/$defs/decision"},"spacing":{"$ref":"#/$defs/decision"},"color_strategy":{"$ref":"#/$defs/decision"},"image_strategy":{"$ref":"#/$defs/decision"},"animation":{"$ref":"#/$defs/decision"},"conversion_strategy":{"$ref":"#/$defs/decision"},"blueprint":{"$ref":"#/$defs/decision"},"homepage_recipe":{"$ref":"#/$defs/decision"},"section_selection":{"$ref":"#/$defs/decision"},"section_ordering":{"$ref":"#/$defs/decision"}},"additionalProperties":false},
    "homepage_blueprint": {"type":["string","null"]},
    "homepage_recipe": {"type":["string","null"]},
    "ordered_sections": {"type":"array","items":{"$ref":"#/$defs/section"}},
    "merchant_assets": {"type":"object","required":["required","recommended","missing","fallbacks"],"properties":{"required":{"type":"array","items":{"$ref":"#/$defs/asset"}},"recommended":{"type":"array","items":{"$ref":"#/$defs/asset"}},"missing":{"type":"array","items":{"$ref":"#/$defs/asset"}},"fallbacks":{"type":"array","items":{"$ref":"#/$defs/fallback"}}},"additionalProperties":false},
    "merchant_verification": {"type":"object","required":["required","publication_checklist"],"properties":{"required":{"type":"array","items":{"$ref":"#/$defs/verification"}},"publication_checklist":{"type":"array","items":{"type":"string","minLength":1}}},"additionalProperties":false},
    "content_safety": {"type":"object","required":["status","section_levels","blocked_reasons"],"properties":{"status":{"enum":["ready_for_structural_planning","blocked_pending_merchant_input","unresolved"]},"section_levels":{"type":"array","items":{"type":"object","required":["section_id","level"],"properties":{"section_id":{"type":"string"},"level":{"enum":["safe_to_generate","generate_with_context","merchant_confirmation_required","merchant_only","unknown"]}},"additionalProperties":false}},"blocked_reasons":{"type":"array","items":{"type":"string","minLength":1}}},"additionalProperties":false},
    "validation_report": {"type":"object","required":["valid","errors","warnings"],"properties":{"valid":{"type":"boolean"},"errors":{"type":"array","items":{"type":"string"}},"warnings":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "explanations": {"type":"array","items":{"$ref":"#/$defs/explanation"}},
    "decision_trace": {"type":"array","items":{"$ref":"#/$defs/explanation"}}
  },
  "$defs": {
    "decision": {"type":"object","required":["selected","confidence","sources","rule_ids","rejected_alternatives","reasoning"],"properties":{"selected":{"type":["string","null"]},"confidence":{"enum":["high","medium","low","unresolved"]},"sources":{"type":"array","items":{"type":"string","minLength":1}},"rule_ids":{"type":"array","items":{"type":"string","minLength":1}},"rejected_alternatives":{"type":"array","items":{"type":"object","required":["id","reason"],"properties":{"id":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}},"additionalProperties":false}},"reasoning":{"type":"string","minLength":1}},"additionalProperties":false},
    "section": {"type":"object","required":["position","id","source","funnel_stages","content_density","performance_cost"],"properties":{"position":{"type":"integer","minimum":1},"id":{"type":"string","minLength":1},"source":{"enum":["layout_recipe","page_blueprint"]},"funnel_stages":{"type":"array","items":{"type":"string"}},"content_density":{"enum":["low","medium","high","unknown"]},"performance_cost":{"enum":["low","medium","high","unknown"]}},"additionalProperties":false},
    "asset": {"type":"object","required":["asset","sections","present"],"properties":{"asset":{"type":"string","minLength":1},"sections":{"type":"array","items":{"type":"string"}},"present":{"type":"boolean"}},"additionalProperties":false},
    "fallback": {"type":"object","required":["asset","section_id","strategy"],"properties":{"asset":{"type":"string","minLength":1},"section_id":{"type":"string","minLength":1},"strategy":{"type":"string","minLength":1}},"additionalProperties":false},
    "verification": {"type":"object","required":["section_id","requirement","safety_level"],"properties":{"section_id":{"type":"string","minLength":1},"requirement":{"type":"string","minLength":1},"safety_level":{"enum":["safe_to_generate","generate_with_context","merchant_confirmation_required","merchant_only"]}},"additionalProperties":false},
    "explanation": {"type":"object","required":["stage","selected","confidence","sources","rule_ids","rejected_alternatives","reasoning"],"properties":{"stage":{"type":"string","minLength":1},"selected":{"type":["string","null"]},"confidence":{"enum":["high","medium","low","unresolved"]},"sources":{"type":"array","items":{"type":"string"}},"rule_ids":{"type":"array","items":{"type":"string"}},"rejected_alternatives":{"type":"array","items":{"type":"object","required":["id","reason"],"properties":{"id":{"type":"string"},"reason":{"type":"string"}},"additionalProperties":false}},"reasoning":{"type":"string","minLength":1}},"additionalProperties":false}
  },
  "additionalProperties": false
}
