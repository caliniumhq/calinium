{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-controlled-beta-d2-7-legacy-lineage-resolution.schema.json",
  "title": "Controlled Beta D2.7 Legacy Lineage Resolution",
  "type": "object",
  "required": ["schema_version", "contract_version", "resolver_revision", "resolution_id", "resolution_checksum", "status", "scope", "authoritative_context", "candidate_set_checksum", "candidates", "selection", "safety"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "controlled-beta-d2-7-legacy-lineage-resolution-v1"},
    "resolver_revision": {"const": "controlled-beta-d2-7-legacy-lineage-resolver-v1"},
    "resolution_id": {"type": "string", "pattern": "^legacy-d2-7-lineage-resolution-[a-f0-9]{20}$"},
    "resolution_checksum": {"$ref": "#/$defs/checksum"},
    "status": {"enum": ["authoritative_match", "unique_legacy_match", "ambiguous_legacy_match", "incompatible_legacy_evidence", "no_reusable_evidence"]},
    "scope": {"$ref": "#/$defs/scope"},
    "authoritative_context": {"$ref": "#/$defs/authoritativeContext"},
    "candidate_set_checksum": {"$ref": "#/$defs/checksum"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "selection": {"$ref": "#/$defs/selection"},
    "safety": {
      "type": "object",
      "required": ["historical_evidence_mutated", "provider_call_allowed", "shopify_write_allowed", "attempt_armed", "merchant_visible"],
      "properties": {
        "historical_evidence_mutated": {"const": false},
        "provider_call_allowed": {"const": false},
        "shopify_write_allowed": {"const": false},
        "attempt_armed": {"const": false},
        "merchant_visible": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableChecksum": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "nullableString": {"type": ["string", "null"]},
    "scope": {
      "type": "object",
      "required": ["organization_id", "project_id", "flow_id", "current_flow_sequence", "current_flow_checksum", "job_id", "logical_attempt", "artifact_id", "artifact_checksum", "development_shop", "development_theme_id", "runtime_configuration_revision", "render_target_configuration_revision", "deployed_source_revision", "route_ids", "viewport_ids"],
      "properties": {
        "organization_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "flow_id": {"type": "string", "minLength": 1},
        "current_flow_sequence": {"type": "integer", "minimum": 0},
        "current_flow_checksum": {"$ref": "#/$defs/checksum"},
        "job_id": {"type": "string", "minLength": 1},
        "logical_attempt": {"type": "integer", "minimum": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_checksum": {"$ref": "#/$defs/checksum"},
        "development_shop": {"type": "string", "minLength": 1},
        "development_theme_id": {"type": "string", "minLength": 1},
        "runtime_configuration_revision": {"type": "string", "minLength": 1},
        "render_target_configuration_revision": {"type": "string", "minLength": 1},
        "deployed_source_revision": {"$ref": "#/$defs/nullableString"},
        "route_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "viewport_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "d27Parent": {
      "type": "object",
      "required": ["request_id", "request_checksum"],
      "properties": {"request_id": {"type": "string", "minLength": 1}, "request_checksum": {"$ref": "#/$defs/checksum"}},
      "additionalProperties": false
    },
    "authoritativeContext": {
      "type": "object",
      "required": ["d2_7_parent", "job_attempt", "accepted_evidence", "immediate_predecessor_flow_revision"],
      "properties": {
        "d2_7_parent": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/d27Parent"}]},
        "job_attempt": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["job_id", "logical_attempt"], "properties": {"job_id": {"type": "string", "minLength": 1}, "logical_attempt": {"type": "integer", "minimum": 1}}, "additionalProperties": false}]},
        "accepted_evidence": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["render_request_id", "render_request_checksum", "render_checksum", "d1_evidence_id", "d1_evidence_checksum"], "properties": {"render_request_id": {"type": "string", "minLength": 1}, "render_request_checksum": {"$ref": "#/$defs/checksum"}, "render_checksum": {"$ref": "#/$defs/checksum"}, "d1_evidence_id": {"type": "string", "minLength": 1}, "d1_evidence_checksum": {"$ref": "#/$defs/checksum"}}, "additionalProperties": false}]},
        "immediate_predecessor_flow_revision": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["sequence", "checksum"], "properties": {"sequence": {"type": "integer", "minimum": 0}, "checksum": {"$ref": "#/$defs/nullableChecksum"}}, "additionalProperties": false}]}
      },
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "required": ["request_id", "request_checksum", "render_checksum", "render_revision", "render_result_ids", "route_ids", "viewport_ids"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "request_checksum": {"$ref": "#/$defs/checksum"},
        "render_checksum": {"$ref": "#/$defs/checksum"},
        "render_revision": {"type": "string", "minLength": 1},
        "render_result_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "route_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "viewport_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }, "additionalProperties": false
    },
    "d1": {
      "type": "object",
      "required": ["evidence_id", "evidence_checksum", "status", "policy_revision", "render_request_id", "render_request_checksum"],
      "properties": {"evidence_id": {"type": "string", "minLength": 1}, "evidence_checksum": {"$ref": "#/$defs/checksum"}, "status": {"type": "string", "minLength": 1}, "policy_revision": {"type": "string", "minLength": 1}, "render_request_id": {"type": "string", "minLength": 1}, "render_request_checksum": {"$ref": "#/$defs/checksum"}},
      "additionalProperties": false
    },
    "candidateD27Parent": {
      "type": "object",
      "required": ["request_id", "request_checksum", "source_render_request_id", "source_render_checksum", "source_d1_evidence_id", "source_d1_evidence_checksum"],
      "properties": {"request_id": {"type": "string", "minLength": 1}, "request_checksum": {"$ref": "#/$defs/checksum"}, "source_render_request_id": {"type": "string", "minLength": 1}, "source_render_checksum": {"$ref": "#/$defs/checksum"}, "source_d1_evidence_id": {"type": "string", "minLength": 1}, "source_d1_evidence_checksum": {"$ref": "#/$defs/checksum"}},
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["organization_id", "project_id", "flow_id", "flow_sequence", "flow_checksum", "artifact_id", "artifact_checksum", "development_shop", "development_theme_id", "runtime_configuration_revision", "render_target_configuration_revision", "deployed_source_revision"],
      "properties": {"organization_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "flow_id": {"type": "string", "minLength": 1}, "flow_sequence": {"type": "integer", "minimum": 0}, "flow_checksum": {"$ref": "#/$defs/checksum"}, "artifact_id": {"type": "string", "minLength": 1}, "artifact_checksum": {"$ref": "#/$defs/checksum"}, "development_shop": {"type": "string", "minLength": 1}, "development_theme_id": {"type": "string", "minLength": 1}, "runtime_configuration_revision": {"type": "string", "minLength": 1}, "render_target_configuration_revision": {"type": "string", "minLength": 1}, "deployed_source_revision": {"$ref": "#/$defs/nullableString"}},
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["evidence_directory_reference", "compatibility", "incompatibility_codes", "render", "d1", "d2_7_parent", "provenance", "explicit_association", "authority_matches", "candidate_id", "candidate_checksum"],
      "properties": {
        "evidence_directory_reference": {"type": "string", "pattern": "^output/"},
        "compatibility": {"enum": ["reusable", "incompatible"]},
        "incompatibility_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "render": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/render"}]},
        "d1": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/d1"}]},
        "d2_7_parent": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidateD27Parent"}]},
        "provenance": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/provenance"}]},
        "explicit_association": {"type": "object", "required": ["job_id", "logical_attempt"], "properties": {"job_id": {"$ref": "#/$defs/nullableString"}, "logical_attempt": {"type": ["integer", "null"], "minimum": 1}}, "additionalProperties": false},
        "authority_matches": {"type": "array", "uniqueItems": true, "items": {"enum": ["d2_7_parent", "job_attempt", "accepted_evidence", "immediate_predecessor_flow_revision"]}},
        "candidate_id": {"type": "string", "pattern": "^legacy-d2-7-lineage-[a-f0-9]{20}$"},
        "candidate_checksum": {"$ref": "#/$defs/checksum"}
      }, "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["selected_candidate_id", "priority", "reason_code", "retained_alternative_candidate_ids", "incompatible_candidate_ids"],
      "properties": {
        "selected_candidate_id": {"$ref": "#/$defs/nullableString"},
        "priority": {"type": ["string", "null"], "enum": [null, "explicit_d2_7_parent", "exact_job_logical_attempt", "accepted_d1_render", "immediate_predecessor_flow_revision", "unique_fully_valid_legacy_evidence"]},
        "reason_code": {"type": "string", "minLength": 1},
        "retained_alternative_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "incompatible_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
