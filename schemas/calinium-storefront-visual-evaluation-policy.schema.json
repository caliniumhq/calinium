{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-storefront-visual-evaluation-policy.schema.json",
  "title": "Calinium Storefront Visual Evaluation Policy",
  "type": "object",
  "required": ["schema_version", "policy_version", "policy_id", "policy_revision", "evaluator_version", "observation_revision", "thresholds", "severity_order", "rules", "diagnostic_allowlist"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy_id": {"type": "string", "const": "calinium_storefront_visual_evaluation"},
    "policy_revision": {"type": "string", "const": "storefront-visual-evaluation-policy-v1"},
    "evaluator_version": {"type": "string", "const": "storefront-visual-evaluator-v1"},
    "observation_revision": {"type": "string", "const": "storefront-objective-observation-v1"},
    "thresholds": {
      "type": "object",
      "required": ["root_horizontal_overflow_px", "element_boundary_tolerance_px", "clipping_tolerance_px", "collision_overlap_ratio", "touch_target_minimum_css_px", "maximum_candidates_per_rule"],
      "properties": {
        "root_horizontal_overflow_px": {"type": "number", "minimum": 0},
        "element_boundary_tolerance_px": {"type": "number", "minimum": 0},
        "clipping_tolerance_px": {"type": "number", "minimum": 0},
        "collision_overlap_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "touch_target_minimum_css_px": {"type": "number", "minimum": 1},
        "maximum_candidates_per_rule": {"type": "integer", "minimum": 1, "maximum": 100}
      },
      "additionalProperties": false
    },
    "severity_order": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "enum": ["blocker", "high", "medium", "low", "info"]}},
    "rules": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "required": ["id", "version", "category", "severity"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "category": {"type": "string"},
          "severity": {"type": "string", "enum": ["blocker", "high", "medium", "low", "info"]}
        },
        "additionalProperties": false
      }
    },
    "diagnostic_allowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "contains_any"],
        "properties": {
          "code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "contains_any": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
