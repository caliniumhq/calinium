{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.example/schemas/calinium-workspace.schema.json",
  "title": "Calinium workspace",
  "description": "A project container owned by one organization.",
  "type": "object",
  "required": ["version", "id", "organization_id", "name", "created_at", "updated_at"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^wsp_[a-z0-9-]+$"},
    "organization_id": {"type": "string", "pattern": "^org_[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
