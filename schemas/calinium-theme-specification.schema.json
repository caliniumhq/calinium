{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.example/schemas/calinium-theme-specification.schema.json",
  "title": "Calinium Theme Specification",
  "description": "The approved, traceable design specification used to assemble a read-only Calinium One theme workspace.",
  "type": "object",
  "required": ["version", "specification_id", "generation_id", "base_theme", "architecture", "approved_inputs", "design_language", "color_system", "typography", "homepage", "collection_layout", "product_layout", "navigation", "components", "section_ordering", "theme_settings", "resources", "technical_requirements", "traceability"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "specification_id": {"type": "string", "pattern": "^theme-spec-generation-run-[a-z0-9-]+$"},
    "generation_id": {"type": "string", "pattern": "^generation-run-[a-z0-9-]+$"},
    "base_theme": {
      "type": "object",
      "required": ["id", "source", "runtime_checksum", "runtime_file_count"],
      "properties": {
        "id": {"type": "string", "const": "calinium-one"},
        "source": {"type": "string", "const": "apps/theme"},
        "runtime_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "runtime_file_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "architecture": {"$ref": "calinium-generated-theme.schema.json#/$defs/architectureProvenance"},
    "approved_inputs": {
      "type": "object",
      "required": ["brand_blueprint", "store_strategy", "resource_plan"],
      "properties": {
        "brand_blueprint": {"$ref": "#/$defs/approved_input"},
        "store_strategy": {"$ref": "#/$defs/approved_input"},
        "resource_plan": {"$ref": "#/$defs/resource_plan"}
      },
      "additionalProperties": false
    },
    "design_language": {"$ref": "#/$defs/direction"},
    "color_system": {"$ref": "#/$defs/color_system"},
    "typography": {"$ref": "#/$defs/typography"},
    "homepage": {"$ref": "#/$defs/page"},
    "collection_layout": {"$ref": "#/$defs/collection_layout"},
    "product_layout": {"$ref": "#/$defs/product_layout"},
    "navigation": {"$ref": "#/$defs/navigation"},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "section_ordering": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
    "theme_settings": {"type": "array", "items": {"$ref": "#/$defs/theme_setting"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "technical_requirements": {
      "type": "object",
      "required": ["accessibility", "performance", "responsive", "progressive_enhancement"],
      "properties": {
        "accessibility": {"type": "string", "const": "WCAG 2.2 AA"},
        "performance": {"type": "string", "const": "high"},
        "responsive": {"type": "boolean", "const": true},
        "progressive_enhancement": {"type": "boolean", "const": true}
      },
      "additionalProperties": false
    },
    "traceability": {
      "type": "object",
      "required": ["approval_reference", "approval_id", "source_draft_version", "source_strategy_version", "reasoning"],
      "properties": {
        "approval_reference": {"type": "string", "minLength": 1},
        "approval_id": {"type": "string", "minLength": 1},
        "source_draft_version": {"type": "integer", "minimum": 1},
        "source_strategy_version": {"type": "string", "minLength": 1},
        "reasoning": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "approved_input": {
      "type": "object",
      "required": ["version", "approval_status"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "approval_status": {"type": "string", "const": "approved"}
      },
      "additionalProperties": false
    },
    "resource_plan": {
      "type": "object",
      "required": ["approval_id", "approval_reference", "approved_at", "references"],
      "properties": {
        "approval_id": {"type": "string", "minLength": 1},
        "approval_reference": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "references": {"type": "array", "items": {"$ref": "#/$defs/resource"}}
      },
      "additionalProperties": false
    },
    "direction": {
      "type": "object",
      "required": ["name", "traits", "rationale"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "traits": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "color_system": {
      "type": "object",
      "required": ["palette_role", "recommended_colors", "rationale", "generated_settings"],
      "properties": {
        "palette_role": {"type": "string", "minLength": 1},
        "recommended_colors": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 1},
        "generated_settings": {"type": "array", "items": {"$ref": "#/$defs/theme_setting"}}
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "required": ["style", "roles", "rationale", "generated_settings"],
      "properties": {
        "style": {"type": "string", "minLength": 1},
        "roles": {"type": "object", "additionalProperties": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 1},
        "generated_settings": {"type": "array", "items": {"$ref": "#/$defs/theme_setting"}}
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["objective", "hero", "sections"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "hero": {"$ref": "#/$defs/hero"},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}
      },
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "required": ["treatment", "rationale"],
      "properties": {
        "treatment": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["position", "section_id", "instance_id", "purpose", "origin"],
      "properties": {
        "position": {"type": "integer", "minimum": 1},
        "section_id": {"type": "string", "minLength": 1},
        "instance_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "enum": ["generated", "preserved"]}
      },
      "additionalProperties": false
    },
    "collection_layout": {
      "type": "object",
      "required": ["layout", "filters", "sorting"],
      "properties": {
        "layout": {"type": "string", "minLength": 1},
        "filters": {"type": "array", "items": {"type": "string"}},
        "sorting": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "product_layout": {
      "type": "object",
      "required": ["gallery_style", "purchase_experience", "trust_elements"],
      "properties": {
        "gallery_style": {"type": "string", "minLength": 1},
        "purchase_experience": {"type": "string", "minLength": 1},
        "trust_elements": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "required": ["primary_items", "recommend_mega_menu", "rationale"],
      "properties": {
        "primary_items": {"type": "array", "items": {"type": "string"}},
        "recommend_mega_menu": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["section_id", "instance_id", "purpose"],
      "properties": {
        "section_id": {"type": "string", "minLength": 1},
        "instance_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "theme_setting": {
      "type": "object",
      "required": ["setting_id", "value", "origin"],
      "properties": {
        "setting_id": {"type": "string", "minLength": 1},
        "value": {},
        "origin": {"type": "string", "enum": ["draft", "approval"]}
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["reference_id", "source", "value"],
      "properties": {
        "reference_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "enum": ["approval_asset_reference", "approval_merchant_reference"]},
        "value": {"type": ["string", "number", "boolean", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
