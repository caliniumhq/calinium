{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.example/schemas/calinium-custom-theme-order.schema.json",
  "title": "Calinium Custom Theme Order",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "organization_id", "project_id", "merchant_user_id", "order_type", "product_code", "product_name", "price_version", "currency", "amount_cents", "payment_status", "generation_status", "resource_plan_revision", "approved_block_plan_revision_id", "approved_resource_snapshot_revision_id", "approved_preset_revision_id", "purchase_intent_checksum", "source_theme", "snapshot_id", "snapshot", "snapshot_checksum", "idempotency_key", "artifacts", "created_at", "updated_at"],
  "properties": {
    "version": {"const": 2},
    "id": {"type": "string", "pattern": "^cto_[A-Za-z0-9_-]+$"},
    "organization_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "merchant_user_id": {"type": "string", "minLength": 1},
    "shopify_connection_id": {"type": ["string", "null"]},
    "order_type": {"const": "custom_theme"},
    "product_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,80}$"},
    "product_name": {"type": "string", "minLength": 3, "maxLength": 160},
    "price_version": {"type": "string", "minLength": 2, "maxLength": 81},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "amount_cents": {"type": "integer", "minimum": 1},
    "payment_status": {"enum": ["pending", "paid", "failed", "refunded", "cancelled", "declined", "expired", "invalid"]},
    "generation_status": {"enum": ["not_started", "queued", "specification_building", "package_generating", "validating", "ready", "blocked", "validation_failed", "generation_failed"]},
    "resource_plan_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved_block_plan_revision_id": {"type": ["string", "null"], "pattern": "^abpr_[a-z0-9][a-z0-9_-]*$"},
    "approved_resource_snapshot_revision_id": {"type": ["string", "null"], "pattern": "^abpsr_[a-z0-9][a-z0-9_-]*$"},
    "approved_preset_revision_id": {"type": ["string", "null"], "pattern": "^apr_[a-z0-9][a-z0-9_-]*$"},
    "purchase_intent_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_theme": {"type": "object", "additionalProperties": false, "required": ["id", "version", "checksum", "file_count"], "properties": {"id": {"const": "calinium-one"}, "version": {"type": "string", "minLength": 1}, "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "file_count": {"type": "integer", "minimum": 1}}},
    "snapshot_id": {"type": ["string", "null"], "pattern": "^cts_[A-Za-z0-9_-]+$"},
    "snapshot": {"type": ["object", "null"]},
    "snapshot_checksum": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 180},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["theme_zip", "theme_specification", "validation_report", "package_manifest", "generation_metadata"], "properties": {"theme_zip": {"type": ["string", "null"]}, "theme_specification": {"type": ["string", "null"]}, "validation_report": {"type": ["string", "null"]}, "package_manifest": {"type": ["string", "null"]}, "generation_metadata": {"type": ["string", "null"]}}},
    "validation_result": {"type": ["object", "null"]},
    "failure_reason": {"type": ["string", "null"], "maxLength": 1000},
    "paid_at": {"type": ["string", "null"], "format": "date-time"},
    "generated_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
