{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-live-visual-observation-output.schema.json",
  "title": "Calinium Live Visual Observation Output",
  "type": "object",
  "required": ["schema_version", "summary", "cell_inspections", "observations", "objective_fact_acknowledgements"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "cell_inspections": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "required": ["cell_id", "status", "summary"], "properties": {"cell_id": {"type": "string"}, "status": {"type": "string", "enum": ["no_condition_observed", "observations_recorded"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 400}}, "additionalProperties": false}},
    "observations": {"type": "array", "maxItems": 32, "items": {"type": "object", "required": ["local_key", "phenomenon", "valence", "profile_ids", "route_id", "viewport_ids", "component", "visible_region", "evidence_summary", "confidence", "evidence", "objective_finding_ids"], "properties": {"local_key": {"type": "string", "pattern": "^[a-z0-9_\\-]{1,80}$"}, "phenomenon": {"type": "string", "enum": ["page_overflow", "content_truncation", "empty_module_visible", "repeated_information", "control_crowding", "typographic_word_break", "duplicate_surface", "comparison_friction", "architecture_difference", "other_visible_condition"]}, "valence": {"type": "string", "enum": ["issue", "positive", "neutral"]}, "profile_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "route_id": {"type": "string", "enum": ["homepage", "collection", "product"]}, "viewport_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "component": {"type": "string", "enum": ["page", "header", "footer", "product_row", "collection_discovery", "collection_hero", "product_supporting_content", "product_highlights", "newsletter", "product_grid", "other"]}, "visible_region": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_summary": {"type": "string", "minLength": 1, "maxLength": 1600}, "confidence": {"type": "string", "enum": ["high", "medium", "low"]}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["cell_id", "region", "visible_evidence"], "properties": {"cell_id": {"type": "string"}, "region": {"type": "string"}, "visible_evidence": {"type": "string"}}, "additionalProperties": false}}, "objective_finding_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "objective_fact_acknowledgements": {"type": "array", "items": {"type": "object", "required": ["finding_id", "status", "visible_impact"], "properties": {"finding_id": {"type": "string"}, "status": {"type": "string", "enum": ["acknowledged", "contradicted", "not_assessable"]}, "visible_impact": {"type": "string", "minLength": 1, "maxLength": 600}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
