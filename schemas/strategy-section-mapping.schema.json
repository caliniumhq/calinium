{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/strategy-section-mapping.schema.json",
  "allOf": [{"$ref": "theme-mapping.schema.json#/$defs/metadata"}],
  "required": ["mappings"],
  "properties": {
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mapping_id", "mapping_type", "source", "name", "sections"],
        "properties": {
          "mapping_id": {"type": "string", "pattern": "^(layout_recipe|page_blueprint)\\.[a-z][a-z0-9_]*$"},
          "mapping_type": {"type": "string", "enum": ["layout_recipe", "page_blueprint"]},
          "source": {"$ref": "theme-mapping.schema.json#/$defs/source"},
          "name": {"type": "string", "minLength": 1},
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["section_id", "priority", "recommended_position", "required", "optional", "fallback_section", "dependencies", "source"],
              "properties": {
                "section_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
                "priority": {"type": "integer", "minimum": 1},
                "recommended_position": {"type": "string", "enum": ["opening", "middle", "closing"]},
                "required": {"type": "boolean"},
                "optional": {"type": "boolean"},
                "fallback_section": {"type": ["string", "null"]},
                "dependencies": {"$ref": "theme-mapping.schema.json#/$defs/dependencies"},
                "source": {"$ref": "theme-mapping.schema.json#/$defs/source"}
              }
            }
          }
        }
      }
    }
  }
}
