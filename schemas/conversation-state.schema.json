{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.example/schemas/conversation-state.schema.json",
  "title": "Calinium Creative Director conversation state",
  "type": "object",
  "required": ["version", "conversationId", "stage", "knownFacts", "inferredFacts", "unknowns", "missingCriticalFacts", "questionsAsked", "merchantCorrections", "currentQuestionId", "readyForCreativeBrief"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "conversationId": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "enum": ["introduction", "business", "audience", "goals", "brand", "assets", "confirmation", "complete"]},
    "knownFacts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "inferredFacts": {"type": "array", "items": {"$ref": "#/$defs/inference"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "missingCriticalFacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "questionsAsked": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "merchantCorrections": {"type": "array", "items": {"$ref": "#/$defs/correction"}},
    "architecturePreferences": {
      "type": "object",
      "properties": {
        "shopping_mode": {"$ref": "#/$defs/architecturePreference"}
      },
      "additionalProperties": false
    },
    "currentQuestionId": {"type": ["string", "null"]},
    "readyForCreativeBrief": {"type": "boolean"}
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["path", "value", "source", "confidence"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "value": {},
        "source": {"type": "string", "enum": ["merchant", "merchant_confirmation"]},
        "confidence": {"type": "number", "minimum": 0.7, "maximum": 1}
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "required": ["path", "value", "source", "confidence", "rationale"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "value": {},
        "source": {"type": "string", "const": "inference"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 0.89},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "required": ["path", "reason"],
      "properties": {"path": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "correction": {
      "type": "object",
      "required": ["path", "previousValue", "value"],
      "properties": {"path": {"type": "string", "minLength": 1}, "previousValue": {}, "value": {}},
      "additionalProperties": false
    },
    "architecturePreference": {
      "type": "object",
      "required": ["value", "confidence", "source", "path", "normalization_revision", "revision_id", "parent_session_updated_at", "recorded_at"],
      "properties": {
        "value": {"type": "string", "enum": ["image_led", "information_led"]},
        "confidence": {"type": "string", "enum": ["High", "Medium", "Low", "Unknown"]},
        "source": {"type": "string", "const": "merchant"},
        "path": {"type": "string", "const": "storefront.shopping_mode"},
        "normalization_revision": {"type": "string", "const": "shopping-mode-natural-answer-v1"},
        "revision_id": {"type": "string", "pattern": "^conversation-preference-[a-f0-9]{20}$"},
        "parent_session_updated_at": {"type": "string", "format": "date-time"},
        "recorded_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
