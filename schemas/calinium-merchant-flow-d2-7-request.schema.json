{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calinium.local/schemas/calinium-merchant-flow-d2-7-request.schema.json",
  "title": "Calinium Merchant Flow Policy D2.7 Request",
  "type": "object",
  "required": ["schema_version", "contract_version", "request_id", "mode", "policy_revision", "source_render", "source_d1", "cells", "architecture_profiles", "objective_facts", "provider", "safety"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "contract_version": {"type": "string", "const": "merchant-flow-policy-d2-7-request-v1"},
    "request_id": {"type": "string", "pattern": "^merchant-flow-d2-7-request-[a-f0-9]{20}$"},
    "mode": {"type": "string", "const": "merchant_flow_policy_evaluation"},
    "policy_revision": {"type": "string"},
    "source_render": {"type": "object", "required": ["request_id", "checksum"], "properties": {"request_id": {"type": "string"}, "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "source_d1": {"type": "object", "required": ["evidence_id", "evidence_checksum"], "properties": {"evidence_id": {"type": "string"}, "evidence_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}},
    "architecture_profiles": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["profile_id", "profile_version", "intent", "family_selections"], "properties": {"profile_id": {"type": "string"}, "profile_version": {"type": "string"}, "intent": {"type": "string"}, "family_selections": {"type": "object"}}, "additionalProperties": false}},
    "objective_facts": {"type": "array", "items": {"type": "object", "required": ["finding_id", "rule_id", "severity", "cell_id", "profile_id", "route_id", "viewport_id", "authority"], "properties": {"finding_id": {"type": "string"}, "rule_id": {"type": "string"}, "severity": {"type": "string"}, "cell_id": {"type": "string"}, "profile_id": {"type": "string"}, "route_id": {"type": "string"}, "viewport_id": {"type": "string"}, "authority": {"const": "phase_d1_authoritative"}}, "additionalProperties": false}},
    "provider": {"type": "object", "required": ["provider_revision", "model_id"], "properties": {"provider_revision": {"type": "string"}, "model_id": {"type": "string", "const": "gpt-5.6-sol"}}, "additionalProperties": false},
    "safety": {"type": "object", "required": ["fixture_fallback_allowed", "approved_replay_allowed", "automatic_mutation_allowed", "automatic_repair_allowed", "shopify_write_allowed", "human_review_required"], "properties": {"fixture_fallback_allowed": {"const": false}, "approved_replay_allowed": {"const": false}, "automatic_mutation_allowed": {"const": false}, "automatic_repair_allowed": {"const": false}, "shopify_write_allowed": {"const": false}, "human_review_required": {"const": true}}, "additionalProperties": false}
  },
  "$defs": {
    "cell": {"type": "object", "required": ["cell_id", "profile_id", "route_id", "viewport_id", "render_id", "screenshot", "objective_evaluation"], "properties": {"cell_id": {"type": "string"}, "profile_id": {"type": "string"}, "route_id": {"type": "string", "enum": ["homepage", "collection", "product"]}, "viewport_id": {"type": "string"}, "render_id": {"type": "string"}, "screenshot": {"type": "object", "required": ["artifact_reference", "sha256", "width", "height"], "properties": {"artifact_reference": {"type": "string", "pattern": "^output/"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}, "additionalProperties": false}, "objective_evaluation": {"type": "object", "required": ["status", "evaluation_id", "findings"], "properties": {"status": {"type": "string"}, "evaluation_id": {"type": "string"}, "findings": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": false}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
